{
  "name": "소형 냉각장치 연습 스키마",
  "classes": [
    {"name": "Asset", "label_ko": "설비",
     "properties": [{"name": "id", "type": "string", "required": true}, {"name": "name", "type": "string", "required": true},
                    {"name": "line", "type": "string"}, {"name": "model", "type": "string"}],
     "unique": ["id"]},
    {"name": "Component", "label_ko": "부품",
     "properties": [{"name": "id", "type": "string", "required": true}, {"name": "name", "type": "string", "required": true},
                    {"name": "kind", "type": "string"}],
     "unique": ["id"]},
    {"name": "Sensor", "label_ko": "센서",
     "properties": [{"name": "id", "type": "string", "required": true}, {"name": "name", "type": "string", "required": true},
                    {"name": "tag", "type": "string", "required": true}, {"name": "kind", "type": "string"}, {"name": "unit", "type": "string"}],
     "unique": ["id"]},
    {"name": "Action", "label_ko": "조치",
     "properties": [{"name": "id", "type": "string", "required": true}, {"name": "name", "type": "string", "required": true},
                    {"name": "kind", "type": "string"}],
     "unique": ["id"]},
    {"name": "Measure", "label_ko": "성과 지표",
     "properties": [{"name": "id", "type": "string", "required": true}, {"name": "name", "type": "string", "required": true},
                    {"name": "unit", "type": "string"}, {"name": "better", "type": "string"}],
     "unique": ["id"]},
    {"name": "Symptom", "label_ko": "증상",
     "properties": [{"name": "id", "type": "string", "required": true}, {"name": "name", "type": "string", "required": true},
                    {"name": "sensor_kind", "type": "string"}, {"name": "operator", "type": "string"},
                    {"name": "threshold", "type": "number"}, {"name": "unit", "type": "string"}],
     "unique": ["id"]},
    {"name": "FailureMode", "label_ko": "고장",
     "properties": [{"name": "id", "type": "string", "required": true}, {"name": "name", "type": "string", "required": true}],
     "unique": ["id"]},
    {"name": "Cause", "label_ko": "원인",
     "properties": [{"name": "id", "type": "string", "required": true}, {"name": "name", "type": "string", "required": true}],
     "unique": ["id"]}
  ],
  "relationships": [
    {"type": "HAS_COMPONENT", "from": "Asset", "to": "Component", "description": "설비가 부품을 가진다"},
    {"type": "HAS_SENSOR", "from": "Asset", "to": "Sensor", "description": "설비에 센서가 붙어 있다"},
    {"type": "MONITORED_BY", "from": "Component", "to": "Sensor", "description": "부품을 센서가 지켜본다"},
    {"type": "AFFECTS", "from": "Action", "to": "Measure", "description": "조치가 지표에 영향을 준다",
     "properties": [{"name": "effect", "type": "enum", "values": ["긍정", "부정"], "required": true}, {"name": "basis", "type": "string", "required": true}]},
    {"type": "CAN_HAVE", "from": "Asset", "to": "FailureMode", "description": "설비에 생길 수 있는 고장",
     "properties": [{"name": "doc", "type": "string", "required": true}]},
    {"type": "INDICATES", "from": "Symptom", "to": "FailureMode", "description": "증상이 고장을 가리킨다", "source": true},
    {"type": "CAUSES", "from": "Cause", "to": "FailureMode", "description": "원인이 고장을 일으킨다", "source": true},
    {"type": "REMEDIED_BY", "from": "FailureMode", "to": "Action", "description": "고장을 조치로 푼다", "source": true}
  ]
}
