// 준비된 연습용 그래프. 2~4일차 랩을 마친 상태와 같다. python -m labkit.prepared_graph 로 넣는다.
CREATE CONSTRAINT asset_id_unique IF NOT EXISTS FOR (n:Asset) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT component_id_unique IF NOT EXISTS FOR (n:Component) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT sensor_id_unique IF NOT EXISTS FOR (n:Sensor) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT action_id_unique IF NOT EXISTS FOR (n:Action) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT measure_id_unique IF NOT EXISTS FOR (n:Measure) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT symptom_id_unique IF NOT EXISTS FOR (n:Symptom) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT failuremode_id_unique IF NOT EXISTS FOR (n:FailureMode) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT cause_id_unique IF NOT EXISTS FOR (n:Cause) REQUIRE n.id IS UNIQUE;
MERGE (n:Asset {id: 'CL-01'}) SET n += {name: '소형 냉각장치 1호', line: '가공 라인 A', model: 'CL 계열'};
MERGE (n:Asset {id: 'CL-02'}) SET n += {name: '소형 냉각장치 2호', line: '가공 라인 B', model: 'CL 계열'};
MERGE (n:Component {id: 'CL-01-FAN'}) SET n += {name: '냉각 팬', kind: '팬'};
MATCH (a:Asset {id: 'CL-01'}), (b:Component {id: 'CL-01-FAN'}) MERGE (a)-[r:HAS_COMPONENT]->(b);
MERGE (n:Component {id: 'CL-01-FIN'}) SET n += {name: '방열핀', kind: '방열핀'};
MATCH (a:Asset {id: 'CL-01'}), (b:Component {id: 'CL-01-FIN'}) MERGE (a)-[r:HAS_COMPONENT]->(b);
MERGE (n:Component {id: 'CL-01-PUMP'}) SET n += {name: '순환 펌프', kind: '펌프'};
MATCH (a:Asset {id: 'CL-01'}), (b:Component {id: 'CL-01-PUMP'}) MERGE (a)-[r:HAS_COMPONENT]->(b);
MERGE (n:Component {id: 'CL-01-HOSE'}) SET n += {name: '냉각수 호스', kind: '호스'};
MATCH (a:Asset {id: 'CL-01'}), (b:Component {id: 'CL-01-HOSE'}) MERGE (a)-[r:HAS_COMPONENT]->(b);
MERGE (n:Component {id: 'CL-02-FAN'}) SET n += {name: '냉각 팬', kind: '팬'};
MATCH (a:Asset {id: 'CL-02'}), (b:Component {id: 'CL-02-FAN'}) MERGE (a)-[r:HAS_COMPONENT]->(b);
MERGE (n:Component {id: 'CL-02-FIN'}) SET n += {name: '방열핀', kind: '방열핀'};
MATCH (a:Asset {id: 'CL-02'}), (b:Component {id: 'CL-02-FIN'}) MERGE (a)-[r:HAS_COMPONENT]->(b);
MERGE (n:Component {id: 'CL-02-PUMP'}) SET n += {name: '순환 펌프', kind: '펌프'};
MATCH (a:Asset {id: 'CL-02'}), (b:Component {id: 'CL-02-PUMP'}) MERGE (a)-[r:HAS_COMPONENT]->(b);
MERGE (n:Sensor {id: 'CL-01-TT-OUT'}) SET n += {name: '1호 출구 온도 센서', kind: '출구 온도', unit: '℃', tag: 'CL01_TT_OUT'};
MATCH (a:Asset {id: 'CL-01'}), (b:Sensor {id: 'CL-01-TT-OUT'}) MERGE (a)-[r:HAS_SENSOR]->(b);
MATCH (a:Component {id: 'CL-01-FIN'}), (b:Sensor {id: 'CL-01-TT-OUT'}) MERGE (a)-[r:MONITORED_BY]->(b);
MERGE (n:Sensor {id: 'CL-01-FT'}) SET n += {name: '1호 유량 센서', kind: '유량', unit: 'L/min', tag: 'CL01_FT'};
MATCH (a:Asset {id: 'CL-01'}), (b:Sensor {id: 'CL-01-FT'}) MERGE (a)-[r:HAS_SENSOR]->(b);
MATCH (a:Component {id: 'CL-01-PUMP'}), (b:Sensor {id: 'CL-01-FT'}) MERGE (a)-[r:MONITORED_BY]->(b);
MERGE (n:Sensor {id: 'CL-01-ST-FAN'}) SET n += {name: '1호 팬 회전수 센서', kind: '팬 회전수', unit: 'rpm', tag: 'CL01_ST_FAN'};
MATCH (a:Asset {id: 'CL-01'}), (b:Sensor {id: 'CL-01-ST-FAN'}) MERGE (a)-[r:HAS_SENSOR]->(b);
MATCH (a:Component {id: 'CL-01-FAN'}), (b:Sensor {id: 'CL-01-ST-FAN'}) MERGE (a)-[r:MONITORED_BY]->(b);
MERGE (n:Sensor {id: 'CL-02-TT-OUT'}) SET n += {name: '2호 출구 온도 센서', kind: '출구 온도', unit: '℃', tag: 'CL02_TT_OUT'};
MATCH (a:Asset {id: 'CL-02'}), (b:Sensor {id: 'CL-02-TT-OUT'}) MERGE (a)-[r:HAS_SENSOR]->(b);
MATCH (a:Component {id: 'CL-02-FIN'}), (b:Sensor {id: 'CL-02-TT-OUT'}) MERGE (a)-[r:MONITORED_BY]->(b);
MERGE (n:Sensor {id: 'CL-02-ST-FAN'}) SET n += {name: '2호 팬 회전수 센서', kind: '팬 회전수', unit: 'rpm', tag: 'CL02_ST_FAN'};
MATCH (a:Asset {id: 'CL-02'}), (b:Sensor {id: 'CL-02-ST-FAN'}) MERGE (a)-[r:HAS_SENSOR]->(b);
MATCH (a:Component {id: 'CL-02-FAN'}), (b:Sensor {id: 'CL-02-ST-FAN'}) MERGE (a)-[r:MONITORED_BY]->(b);
MERGE (n:Action {id: 'ACT-FAN-UP'}) SET n += {name: '팬 속도 올리기', kind: '운전 조정'};
MERGE (n:Action {id: 'ACT-LOAD-DOWN'}) SET n += {name: '부하 낮추기', kind: '운전 조정'};
MERGE (n:Action {id: 'ACT-FIN-CLEAN'}) SET n += {name: '정지 후 핀 세척', kind: '정비 작업'};
MERGE (n:Measure {id: 'KPI-OUT-TEMP'}) SET n += {name: '출구 온도', unit: '℃', better: '낮을수록 좋음'};
MERGE (n:Measure {id: 'KPI-POWER-COST'}) SET n += {name: '전력비', unit: '원/일', better: '낮을수록 좋음'};
MERGE (n:Measure {id: 'KPI-OUTPUT'}) SET n += {name: '생산량', unit: '개/일', better: '높을수록 좋음'};
MERGE (n:Measure {id: 'KPI-UPTIME'}) SET n += {name: '가동 시간', unit: '시간/일', better: '높을수록 좋음'};
MATCH (a:Action {id: 'ACT-FAN-UP'}), (b:Measure {id: 'KPI-OUT-TEMP'}) MERGE (a)-[r:AFFECTS]->(b) SET r += {effect: '긍정', basis: '풍량이 늘어 열이 더 빨리 빠진다'};
MATCH (a:Action {id: 'ACT-FAN-UP'}), (b:Measure {id: 'KPI-POWER-COST'}) MERGE (a)-[r:AFFECTS]->(b) SET r += {effect: '부정', basis: '팬이 전기를 더 쓴다'};
MATCH (a:Action {id: 'ACT-LOAD-DOWN'}), (b:Measure {id: 'KPI-OUT-TEMP'}) MERGE (a)-[r:AFFECTS]->(b) SET r += {effect: '긍정', basis: '들어오는 열이 줄어든다'};
MATCH (a:Action {id: 'ACT-LOAD-DOWN'}), (b:Measure {id: 'KPI-OUTPUT'}) MERGE (a)-[r:AFFECTS]->(b) SET r += {effect: '부정', basis: '가공 속도를 늦추므로 생산량이 준다'};
MATCH (a:Action {id: 'ACT-FIN-CLEAN'}), (b:Measure {id: 'KPI-OUT-TEMP'}) MERGE (a)-[r:AFFECTS]->(b) SET r += {effect: '긍정', basis: '막힌 핀이 뚫려 바람이 지나간다'};
MATCH (a:Action {id: 'ACT-FIN-CLEAN'}), (b:Measure {id: 'KPI-UPTIME'}) MERGE (a)-[r:AFFECTS]->(b) SET r += {effect: '부정', basis: '세척하는 동안 장치를 멈춘다'};
MATCH (a:Action {id: 'ACT-FIN-CLEAN'}), (b:Measure {id: 'KPI-POWER-COST'}) MERGE (a)-[r:AFFECTS]->(b) SET r += {effect: '긍정', basis: '팬을 세게 돌리지 않아도 된다'};
MERGE (n:Symptom {id: 'SYM-OUT-TEMP-HIGH'}) SET n += {name: '출구 온도 60 ℃ 초과', sensor_kind: '출구 온도', operator: '>', threshold: 60, unit: '℃'};
MERGE (n:FailureMode {id: 'FM-OVERHEAT'}) SET n += {name: '과열'};
MATCH (a:Symptom {id: 'SYM-OUT-TEMP-HIGH'}), (b:FailureMode {id: 'FM-OVERHEAT'}) MERGE (a)-[r:INDICATES {candidate_id: 'C01'}]->(b) SET r += {doc: 'CM-01', section: '2', line: 11, quote: '출구 온도 60 ℃ 초과가 5분 넘게 이어지면 과열로 본다.'};
MERGE (n:Cause {id: 'CAUSE-FIN-CLOG'}) SET n += {name: '방열핀 막힘'};
MATCH (a:Cause {id: 'CAUSE-FIN-CLOG'}), (b:FailureMode {id: 'FM-OVERHEAT'}) MERGE (a)-[r:CAUSES {candidate_id: 'C02'}]->(b) SET r += {doc: 'CM-01', section: '2', line: 12, quote: '방열핀 막힘이 생기면 바람이 지나가지 못해 과열로 이어진다.'};
MERGE (n:Cause {id: 'CAUSE-FAN-BELT'}) SET n += {name: '팬 벨트 느슨함'};
MATCH (a:Cause {id: 'CAUSE-FAN-BELT'}), (b:FailureMode {id: 'FM-OVERHEAT'}) MERGE (a)-[r:CAUSES {candidate_id: 'C04'}]->(b) SET r += {doc: 'CM-01', section: '2', line: 13, quote: '팬 벨트 느슨함도 풍량을 줄여 과열을 일으킨다.'};
MERGE (n:Action {id: 'ACT-FAN-UP'}) SET n += {name: '팬 속도 올리기'};
MATCH (a:FailureMode {id: 'FM-OVERHEAT'}), (b:Action {id: 'ACT-FAN-UP'}) MERGE (a)-[r:REMEDIED_BY {candidate_id: 'C05'}]->(b) SET r += {doc: 'CM-01', section: '2', line: 14, quote: '과열일 때 먼저 팬 속도 올리기를 한다.'};
MERGE (n:Action {id: 'ACT-LOAD-DOWN'}) SET n += {name: '부하 낮추기'};
MATCH (a:FailureMode {id: 'FM-OVERHEAT'}), (b:Action {id: 'ACT-LOAD-DOWN'}) MERGE (a)-[r:REMEDIED_BY {candidate_id: 'C07'}]->(b) SET r += {doc: 'CM-01', section: '2', line: 15, quote: '팬 속도 올리기로 10분 안에 온도가 내려가지 않으면 과열을 풀기 위해 부하 낮추기를 한다.'};
MERGE (n:Action {id: 'ACT-FIN-CLEAN'}) SET n += {name: '정지 후 핀 세척'};
MATCH (a:FailureMode {id: 'FM-OVERHEAT'}), (b:Action {id: 'ACT-FIN-CLEAN'}) MERGE (a)-[r:REMEDIED_BY {candidate_id: 'C08'}]->(b) SET r += {doc: 'CM-01', section: '2', line: 16, quote: '방열핀 막힘이 원인인 과열은 정지 후 핀 세척으로 해결한다.'};
MERGE (n:Cause {id: 'CAUSE-HOSE-LOOSE'}) SET n += {name: '호스 연결부 풀림'};
MERGE (n:FailureMode {id: 'FM-LEAK'}) SET n += {name: '누수'};
MATCH (a:Cause {id: 'CAUSE-HOSE-LOOSE'}), (b:FailureMode {id: 'FM-LEAK'}) MERGE (a)-[r:CAUSES {candidate_id: 'C09'}]->(b) SET r += {doc: 'CM-01', section: '3', line: 20, quote: '호스 연결부 풀림은 누수의 가장 흔한 원인이다.'};
MERGE (n:Action {id: 'ACT-HOSE-TIGHTEN'}) SET n += {name: '호스 연결부 조이기'};
MATCH (a:FailureMode {id: 'FM-LEAK'}), (b:Action {id: 'ACT-HOSE-TIGHTEN'}) MERGE (a)-[r:REMEDIED_BY {candidate_id: 'C10'}]->(b) SET r += {doc: 'CM-01', section: '3', line: 21, quote: '누수는 호스 연결부 조이기로 막는다.'};
MATCH (a:Asset {id: 'CL-01'}), (b:FailureMode {id: 'FM-OVERHEAT'}) MERGE (a)-[r:CAN_HAVE]->(b) SET r += {doc: 'CM-01'};
MATCH (a:Asset {id: 'CL-02'}), (b:FailureMode {id: 'FM-OVERHEAT'}) MERGE (a)-[r:CAN_HAVE]->(b) SET r += {doc: 'CM-01'};
MATCH (a:Asset {id: 'CL-01'}), (b:FailureMode {id: 'FM-LEAK'}) MERGE (a)-[r:CAN_HAVE]->(b) SET r += {doc: 'CM-01'};
MATCH (a:Asset {id: 'CL-02'}), (b:FailureMode {id: 'FM-LEAK'}) MERGE (a)-[r:CAN_HAVE]->(b) SET r += {doc: 'CM-01'};
