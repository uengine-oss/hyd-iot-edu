MATCH (s:Section {id: "HM-8.3"}) MERGE (k:Knowledge {id: "HM-8-030"}) SET k += {kind: "unit_value", text: "유온이 55 ℃를 넘고 냉각 효율이 70 % 아래로 떨어진 채 유온이 계속 오르면 쿨러 냉각 성능 상실로 본다.", quote: "유온이 55 ℃를 넘고 냉각 효율이 70 % 아래로 떨어진 채 유온이 계속 오르면 쿨러 냉각 성능 상실로 본다.", value: 55, unit: "℃", comparator: ">", value_text: "55 ℃를 넘", decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "HM-8", source_sha256: "6a1a66a6000e9c292f58bd6160ce46ba07e90862f40d4cc0a2e8b1cc2778e256", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
