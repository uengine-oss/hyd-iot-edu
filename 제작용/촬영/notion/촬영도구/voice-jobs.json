[
 {
  "id": "live-color-find-r2",
  "text": "색 목록에서 파란색 배경을 찾을게요. 홈 안내 상자와 같은 색으로 맞추겠습니다.",
  "from": "live-color-find",
  "segment": "seg-27.mjs"
 },
 {
  "id": "live-callout-exit-first-v2-r2",
  "text": "상자 밖으로 나가 볼게요. 상자 마지막 문장 끝을 클릭하고 엔터를 한 번 누르겠습니다.",
  "from": "live-callout-exit-first-v2",
  "segment": "seg-27.mjs"
 },
 {
  "id": "live-callout-exit-second-r2",
  "text": "빈 줄에서 엔터를 한 번 더 누르면 상자 밖으로 나옵니다. 눌러 볼게요.",
  "from": "live-callout-exit-second",
  "segment": "seg-27.mjs"
 },
 {
  "id": "live-heading-search-r2",
  "text": "다시 슬래시 뒤에 제목이라고 적겠습니다. 이번에도 구역을 나누는 제목을 넣을 거예요.",
  "from": "live-heading-search",
  "segment": "seg-27.mjs"
 },
 {
  "id": "live-heading-search-r3",
  "text": "이번 구역에도 제목이 필요하니 슬래시 뒤에 제목이라고 입력할게요.",
  "from": "live-heading-search",
  "segment": "seg-28.mjs"
 },
 {
  "id": "live-page-search-r2",
  "text": "두 번째 하위 페이지를 만들겠습니다. 슬래시 뒤에 페이지라고 적을게요.",
  "from": "live-page-search",
  "segment": "seg-29.mjs"
 },
 {
  "id": "live-page-enter-r2",
  "text": "제목을 다 적었으니 엔터를 눌러 본문 첫 줄로 내려가겠습니다.",
  "from": "live-page-enter",
  "segment": "seg-29.mjs"
 },
 {
  "id": "live-heading-search-r4",
  "text": "새 페이지에서도 제목부터 달아 볼게요. 슬래시 뒤에 제목이라고 적어 주세요.",
  "from": "live-heading-search",
  "segment": "seg-29.mjs"
 },
 {
  "id": "live-filter-callout-r2",
  "text": "이 페이지에도 짧은 안내 상자를 넣어 볼게요. 슬래시 뒤에 콜아웃입니다.",
  "from": "live-filter-callout",
  "segment": "seg-29.mjs"
 },
 {
  "id": "live-callout-exit-first-v2-r3",
  "text": "이번에도 상자 아래로 빠져나가겠습니다. 마지막 문장 끝을 클릭한 뒤 엔터를 눌러 주세요.",
  "from": "live-callout-exit-first-v2",
  "segment": "seg-29.mjs"
 },
 {
  "id": "live-callout-exit-second-r3",
  "text": "상자 안에 빈 줄이 생겼네요. 엔터를 한 번 더 눌러 상자 밖으로 나가겠습니다.",
  "from": "live-callout-exit-second",
  "segment": "seg-29.mjs"
 },
 {
  "id": "live-heading-search-r5",
  "text": "여기에도 구역 제목을 넣겠습니다. 슬래시를 누르고 제목이라고 적을게요.",
  "from": "live-heading-search",
  "segment": "seg-29.mjs"
 },
 {
  "id": "live-filter-callout-r3",
  "text": "두 페이지를 묶을 상자를 만들겠습니다. 슬래시 뒤에 콜아웃이라고 적을게요.",
  "from": "live-filter-callout",
  "segment": "seg-30.mjs"
 },
 {
  "id": "live-bold-short-r2",
  "text": "상자 제목 줄은 굵게 쓰겠습니다. 컨트롤과 비를 누를게요.",
  "from": "live-bold-short",
  "segment": "seg-30.mjs"
 },
 {
  "id": "live-normal-short-r2",
  "text": "제목 줄을 적었으니 컨트롤 비로 굵게 쓰기를 끌게요.",
  "from": "live-normal-short",
  "segment": "seg-30.mjs"
 },
 {
  "id": "live-callout-exit-first-v2-r4",
  "text": "다음 상자는 이 상자 밖에 만들 거예요. 상자 마지막 줄 끝을 누르고 엔터를 칠게요.",
  "from": "live-callout-exit-first-v2",
  "segment": "seg-30.mjs"
 },
 {
  "id": "live-callout-exit-second-r4",
  "text": "한 번 더 엔터를 누르면 커서가 상자 아래 일반 줄로 빠져나옵니다.",
  "from": "live-callout-exit-second",
  "segment": "seg-30.mjs"
 },
 {
  "id": "live-filter-callout-r4",
  "text": "두 번째 상자도 같은 방법으로 만들게요. 슬래시 뒤에 콜아웃이라고 적겠습니다.",
  "from": "live-filter-callout",
  "segment": "seg-30.mjs"
 },
 {
  "id": "live-bold-short-r3",
  "text": "이번에도 컨트롤 비로 굵은 글씨를 먼저 켜겠습니다.",
  "from": "live-bold-short",
  "segment": "seg-30.mjs"
 },
 {
  "id": "live-normal-short-r3",
  "text": "다시 컨트롤과 비를 눌러 보통 글씨로 돌아가겠습니다.",
  "from": "live-normal-short",
  "segment": "seg-30.mjs"
 },
 {
  "id": "live-peek-full-r2",
  "text": "새 주제도 옆 창으로 열렸네요. 왼쪽 위의 전체 페이지로 열기를 눌러 크게 보겠습니다.",
  "from": "live-peek-full",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-page-enter-r3",
  "text": "이번에도 엔터를 눌러 제목 아래 본문으로 이동할게요.",
  "from": "live-page-enter",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-filter-callout-r5",
  "text": "이 주제에도 안내 상자를 넣겠습니다. 슬래시 뒤에 콜아웃이라고 적을게요.",
  "from": "live-filter-callout",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-bold-short-r4",
  "text": "제목 줄이니까 컨트롤과 비를 눌러 굵게 적을게요.",
  "from": "live-bold-short",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-normal-short-r4",
  "text": "굵은 글씨를 끄고 아래 설명을 이어 적을게요.",
  "from": "live-normal-short",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-color-find-r3",
  "text": "이번에도 색 목록에서 파란색 배경을 찾아보겠습니다. 글자색이 아니라 배경색이에요.",
  "from": "live-color-find",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-callout-exit-first-v2-r5",
  "text": "상자 안의 글은 다 적었으니, 마지막 문장 끝을 클릭하고 엔터로 한 줄 내려가겠습니다.",
  "from": "live-callout-exit-first-v2",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-callout-exit-second-r5",
  "text": "빈 줄이 보이면 엔터를 다시 눌러 상자 밖 일반 줄로 내려가겠습니다.",
  "from": "live-callout-exit-second",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-heading-search-r6",
  "text": "메모 앞에 제목을 하나 두겠습니다. 슬래시 뒤에 제목이라고 입력할게요.",
  "from": "live-heading-search",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-bullet-search-r2",
  "text": "메모는 글머리 목록으로 적겠습니다. 슬래시 뒤에 글머리라고 입력할게요.",
  "from": "live-bullet-search",
  "segment": "seg-32.mjs"
 },
 {
  "id": "N11-v020-r2",
  "text": "빈 항목에서 엔터를 한 번 더 누르면 목록이 끝납니다.",
  "from": "N11-v020",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-toggle-search-r2",
  "text": "질문은 접어 둘 수 있게 토글로 만들겠습니다. 슬래시 뒤에 토글이라고 적을게요.",
  "from": "live-toggle-search",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-home-list-r2",
  "text": "홈으로 돌아가겠습니다. 위쪽 경로의 내 학습 노트를 누르고 주제 목록까지 조금 내릴게요.",
  "from": "live-home-list",
  "segment": "seg-32.mjs"
 },
 {
  "id": "live-property-settings-r2",
  "text": "같은 설정 아이콘에서 속성을 하나 더 만들겠습니다. 이번에는 이해도를 적을 칸이에요.",
  "from": "live-property-settings",
  "segment": "seg-34.mjs"
 },
 {
  "id": "live-property-kind-r2",
  "text": "이것도 종류는 선택으로 고르겠습니다. 정해 둔 단계 가운데 하나를 고르게 할 거예요.",
  "from": "live-property-kind",
  "segment": "seg-34.mjs"
 },
 {
  "id": "live-property-close-r2",
  "text": "옵션을 다 넣었으니 설정 창을 닫겠습니다.",
  "from": "live-property-close",
  "segment": "seg-34.mjs"
 },
 {
  "id": "live-property-settings-r3",
  "text": "이번에는 그림을 담을 속성을 추가하겠습니다. 목록 오른쪽 설정 아이콘을 다시 누를게요.",
  "from": "live-property-settings",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-property-close-r3",
  "text": "카드 이미지 속성을 만들었으니 설정 창을 닫을게요.",
  "from": "live-property-close",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-peek-full-r3",
  "text": "카드가 옆 창으로 열렸습니다. 전체 페이지로 열기 버튼을 눌러 넓게 볼게요.",
  "from": "live-peek-full",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-home-list-r3",
  "text": "다시 홈으로 갈게요. 경로에서 내 학습 노트를 누른 뒤 아래 주제 목록을 보겠습니다.",
  "from": "live-home-list",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-peek-full-r4",
  "text": "이 카드도 전체 페이지로 열어서 속성을 채우겠습니다. 왼쪽 위 버튼을 누를게요.",
  "from": "live-peek-full",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-value-understanding-r2",
  "text": "이해도 옆의 비어 있음 칸도 눌러 주세요.",
  "from": "live-value-understanding",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-value-example-r2",
  "text": "이 주제도 예시로 대충 앎을 고르겠습니다. 실제로는 각자 느끼는 정도로 고르시면 돼요.",
  "from": "live-value-example",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-image-property-r2",
  "text": "속성 목록에서 카드 이미지 옆 빈 칸을 눌러 그림을 넣겠습니다.",
  "from": "live-image-property",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-image-link-tab-v2-r2",
  "text": "이번에도 업로드 옆의 링크 탭을 눌러 그림 주소를 쓰겠습니다.",
  "from": "live-image-link-tab-v2",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-image-link-apply-v2-r2",
  "text": "주소를 붙였으면 아래 링크 버튼으로 적용할게요.",
  "from": "live-image-link-apply-v2",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-file-popup-dismiss-v2-r2",
  "text": "두 번째 그림도 연결됐습니다. 이스케이프를 두 번 눌러 열린 창들을 닫겠습니다.",
  "from": "live-file-popup-dismiss-v2",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-home-list-r4",
  "text": "이 카드도 정리했으니 경로의 내 학습 노트로 돌아가서 주제 목록을 보겠습니다.",
  "from": "live-home-list",
  "segment": "seg-35.mjs"
 },
 {
  "id": "live-page-enter-r4",
  "text": "템플릿 제목을 적었으니 엔터로 본문을 쓰러 내려가겠습니다.",
  "from": "live-page-enter",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-filter-callout-r6",
  "text": "템플릿에도 안내 상자를 넣겠습니다. 슬래시 뒤에 콜아웃이라고 적을게요.",
  "from": "live-filter-callout",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-bold-short-r5",
  "text": "안내 제목도 굵게 쓰려고 컨트롤과 비를 누르겠습니다.",
  "from": "live-bold-short",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-normal-short-r5",
  "text": "컨트롤과 비를 한 번 더 눌러 일반 글씨로 바꾸겠습니다.",
  "from": "live-normal-short",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-color-find-r4",
  "text": "템플릿의 안내 상자도 파란색 배경으로 맞추려고 색 목록에서 찾겠습니다.",
  "from": "live-color-find",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-callout-exit-first-v2-r6",
  "text": "앞에서 한 것처럼 상자 마지막 문장 끝을 클릭하고 엔터를 눌러 상자에서 나올 준비를 할게요.",
  "from": "live-callout-exit-first-v2",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-callout-exit-second-r6",
  "text": "이번에도 빈 줄에서 엔터를 한 번 더 눌러 상자 밖으로 나올게요.",
  "from": "live-callout-exit-second",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-heading-search-r7",
  "text": "템플릿에도 기록할 구역을 나누겠습니다. 슬래시 뒤에 제목이라고 적어 주세요.",
  "from": "live-heading-search",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-bullet-search-r3",
  "text": "템플릿에도 기록할 항목을 목록으로 넣겠습니다. 슬래시 뒤에 글머리라고 적어 주세요.",
  "from": "live-bullet-search",
  "segment": "seg-36.mjs"
 },
 {
  "id": "N11-v020-r3",
  "text": "엔터를 다시 눌러 목록에서 빠져나올게요.",
  "from": "N11-v020",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-toggle-search-r3",
  "text": "템플릿에도 접어 두는 안내를 넣겠습니다. 슬래시 뒤에 토글이라고 입력할게요.",
  "from": "live-toggle-search",
  "segment": "seg-36.mjs"
 },
 {
  "id": "live-peek-full-r5",
  "text": "템플릿으로 만든 페이지도 옆 창에서 열렸어요. 전체 페이지로 열기를 눌러 주세요.",
  "from": "live-peek-full",
  "segment": "seg-37.mjs"
 },
 {
  "id": "live-page-search-r3",
  "text": "독서 기록 안에도 하위 페이지를 넣겠습니다. 슬래시 뒤에 페이지라고 적어 주세요.",
  "from": "live-page-search",
  "segment": "seg-37.mjs"
 },
 {
  "id": "live-page-enter-r5",
  "text": "하위 페이지 제목도 적었으니 엔터를 눌러 본문으로 갈게요.",
  "from": "live-page-enter",
  "segment": "seg-37.mjs"
 },
 {
  "id": "live-home-list-r5",
  "text": "새 주제까지 만들었으니 경로의 내 학습 노트로 돌아가 전체 목록을 확인할게요.",
  "from": "live-home-list",
  "segment": "seg-37.mjs"
 },
 {
  "id": "live-layout-down-r2",
  "text": "아래 내용이 보이도록 화면을 조금 내릴게요.",
  "from": "live-layout-down",
  "segment": "seg-39.mjs"
 },
 {
  "id": "live-peek-full-r6",
  "text": "노션 익히기도 전체 페이지로 열어서 안에 만든 내용을 살펴볼게요.",
  "from": "live-peek-full",
  "segment": "seg-39.mjs"
 },
 {
  "id": "live-layout-down-r3",
  "text": "하위 페이지가 보이게 화면을 조금 내려 보겠습니다.",
  "from": "live-layout-down",
  "segment": "seg-39.mjs"
 },
 {
  "id": "live-layout-down-r4",
  "text": "오른쪽 상자가 보이도록 화면을 아래로 내릴게요.",
  "from": "live-layout-down",
  "segment": "seg-39.mjs"
 },
 {
  "id": "new-publish-explain",
  "text": "오른쪽 아래의 게시 버튼을 누르면 이 페이지가 웹사이트처럼 공개되고, notion.site로 시작하는 주소가 하나 생깁니다. 그 주소를 받은 사람은 노션에 로그인하지 않아도 내용을 볼 수 있어요. 여러분이 수업 자료를 보시는 노션 학습 포털도 이렇게 게시해 둔 페이지입니다.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-publish-close",
  "text": "오늘은 공개하지 않고 위치만 확인한 뒤, 이스케이프 키로 창을 닫겠습니다.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-export-format-open",
  "text": "내보내기 형식 칸을 눌러서 어떤 형식이 있는지 먼저 볼게요.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-export-format-explain",
  "text": "HTML은 브라우저로 열어 보는 형식이고, 마크다운과 CSV는 다른 문서 도구로 옮길 때 씁니다. PDF로 받으면 인쇄하거나 파일 하나로 보내기 좋아요.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-export-format-pick",
  "text": "오늘은 브라우저에서 바로 열어 볼 수 있게 HTML을 고르겠습니다.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-export-view",
  "text": "데이터베이스 보기는 지금 화면에 보이는 보기 그대로 내보낸다는 뜻이에요.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-export-content",
  "text": "페이지 콘텐츠는 글과 그림을 모두 담는 모든 콘텐츠로 두겠습니다.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-export-folder",
  "text": "하위 페이지용 폴더 생성을 켜면 페이지마다 폴더가 나뉘어 정리됩니다. 오늘은 그대로 둘게요.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-export-comments",
  "text": "댓글 내보내기는 남긴 댓글까지 함께 받고 싶을 때 켜면 됩니다.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-wrap-structure",
  "text": "오늘은 노션으로 학습노트를 하나 만들었습니다. 홈에 안내를 적고, 주제마다 카드를 만들고, 카드 안에서 하위 페이지로 내용을 나눴어요.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-wrap-features",
  "text": "표 보기로 분야와 이해도를 한눈에 보고, 검색으로 필요한 주제를 찾았습니다. 자주 쓰는 모양은 템플릿으로 남겼고, 공유와 게시의 위치, 파일로 내보내는 방법까지 확인했어요.",
  "from": "new",
  "segment": "seg-38/39"
 },
 {
  "id": "new-wrap-close",
  "text": "기능을 모두 쓰려고 칸을 채울 필요는 없습니다. 짧게 적고, 길어지면 페이지로 나누고, 자주 쓰는 모양은 템플릿으로 남기세요. 앞으로 배우는 내용을 이 노트에 하나씩 쌓아 가시면 됩니다. 수고하셨습니다.",
  "from": "new",
  "segment": "seg-38/39"
 }
]