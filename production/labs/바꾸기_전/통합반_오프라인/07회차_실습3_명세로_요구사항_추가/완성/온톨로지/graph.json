    {"labels": ["Cause"], "props": {"id": "cause:ambient-high-temp", "name": "주변 온도 상승", "aliases": ["외기 고온", "캐비닛 환기 불량"], "prior": 0.2, "section": "HM-8.4"}},
    {"labels": ["Cause"], "props": {"id": "cause:fan-drive-fault", "name": "팬 구동 불량", "aliases": ["벨트 슬립", "베어링 마모"], "prior": 0.2, "section": "HM-8.4"}},
    {"labels": ["Cause"], "props": {"id": "cause:pump-seal-wear", "name": "펌프 축 씰 마모", "aliases": ["씰 마모", "내부 누설"], "prior": 0.7}},
    {"labels": ["Cause"], "props": {"id": "cause:fan-bearing-wear", "name": "팬 베어링 마모", "aliases": ["베어링 마모", "베어링 손상"], "prior": 0.8}},
    {"labels": ["Cause"], "props": {"id": "cause:oil-oxidation", "name": "고온 운전에 의한 산화", "aliases": ["산화", "열 열화"], "prior": 0.4}},
    {"labels": ["Cause"], "props": {"id": "cause:water-ingress", "name": "수분 혼입", "aliases": ["수분", "물 혼입", "결로"], "prior": 0.25}},
    {"labels": ["Cause"], "props": {"id": "cause:particle-contamination", "name": "오염 입자 유입", "aliases": ["오염", "마모 입자", "청정도 저하"], "prior": 0.25}},
    {"labels": ["Cause"], "props": {"id": "cause:change-interval-exceeded", "name": "교환 주기 초과", "aliases": ["장기 사용", "교환 지연"], "prior": 0.1}},
    {"labels": ["Evidence"], "props": {"id": "evd:fin-fouling-ce-low", "name": "최근 30초 냉각 효율 평균 70 % 미만", "rule": "avg(CE) over 30s < 70", "tag": "CE", "aggregate": "avg", "windowSeconds": 30, "expect": "lt", "threshold": 70, "section": "HM-8.4"}},
    {"labels": ["Evidence"], "props": {"id": "evd:fin-fouling-vs1-normal", "name": "최근 2분 팬 진동 VS1 평균 0.9 mm/s 미만 (팬은 정상)", "rule": "avg(VS1) over 2m < 0.9", "tag": "VS1", "aggregate": "avg", "windowSeconds": 120, "expect": "lt", "threshold": 0.9, "section": "HM-8.4"}},
    {"labels": ["Evidence"], "props": {"id": "evd:ambient-ts4-high", "name": "최근 2분 캐비닛 온도 TS4 평균 35 ℃ 이상", "rule": "avg(TS4) over 2m >= 35", "tag": "TS4", "aggregate": "avg", "windowSeconds": 120, "expect": "gte", "threshold": 35, "section": "HM-8.4"}},
    {"labels": ["Evidence"], "props": {"id": "evd:fan-drive-vs1-high", "name": "최근 2분 팬 진동 VS1 평균 0.9 mm/s 이상", "rule": "avg(VS1) over 2m >= 0.9", "tag": "VS1", "aggregate": "avg", "windowSeconds": 120, "expect": "gte", "threshold": 0.9, "section": "HM-8.4"}},
    {"labels": ["Evidence"], "props": {"id": "evd:ps1-low", "name": "토출 압력 평균 165 bar 미만", "rule": "avg(PS1) over 2m < 165", "tag": "PS1", "aggregate": "avg", "windowSeconds": 120, "expect": "lt", "threshold": 165}},
    {"labels": ["Evidence"], "props": {"id": "evd:fs1-drop", "name": "유량 평균 8.0 l/min 미만", "rule": "avg(FS1) over 2m < 8.0", "tag": "FS1", "aggregate": "avg", "windowSeconds": 120, "expect": "lt", "threshold": 8.0}},
    {"labels": ["Evidence"], "props": {"id": "evd:vs1-trend", "name": "진동 상승폭 0.2 mm/s 초과 (최근 5분)", "rule": "max(VS1) - min(VS1) over 5m > 0.2", "tag": "VS1", "aggregate": "max-min", "windowSeconds": 300, "expect": "gt", "threshold": 0.2}},
    {"labels": ["Evidence"], "props": {"id": "evd:ts1-normal", "name": "유온 52 ℃ 미만 (냉각 문제 아님)", "rule": "avg(TS1) over 2m < 52", "tag": "TS1", "aggregate": "avg", "windowSeconds": 120, "expect": "lt", "threshold": 52}},
    {"labels": ["Skill"], "props": {"id": "skill:sop-cool-11", "name": "팬 최대 운전", "sopId": "SOP-COOL-11", "kind": "control", "description": "팬만 100 %로 올린다. 생산은 그대로 유지된다.", "steps": [{"order": 1, "text": "PLC 운전 모드가 REMOTE_AUTO인지 확인한다.", "section": "HM-8.5"}, {"order": 2, "text": "팬 속도를 100 %로 올린다. 100 % 연속 운전은 24시간 이내로 한다.", "section": "HM-8.5"}, {"order": 3, "text": "15분 재관측으로 HM-8.6 회복 판정을 한다.", "section": "HM-8.6"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:sop-cool-12", "name": "팬 최대 운전과 부하 80 %", "sopId": "SOP-COOL-12", "kind": "control", "description": "팬 100 %와 부하 80 %. 생산 속도가 줄어든다.", "steps": [{"order": 1, "text": "PLC 운전 모드가 REMOTE_AUTO인지 확인한다.", "section": "HM-8.5"}, {"order": 2, "text": "팬 속도를 100 %로 올린다.", "section": "HM-8.5"}, {"order": 3, "text": "펌프 부하를 80 %로 낮춘다.", "section": "HM-8.5"}, {"order": 4, "text": "15분 재관측으로 HM-8.6 회복 판정을 한다.", "section": "HM-8.6"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:sop-cool-13", "name": "부하 70 %와 야간 핀 세척", "sopId": "SOP-COOL-13", "kind": "control", "description": "팬은 그대로 두고 부하를 70 %로 낮춘 뒤 야간 정비 시간에 핀 세척 작업지시를 건다. 생산 속도가 줄어든다.", "steps": [{"order": 1, "text": "PLC 운전 모드가 REMOTE_AUTO인지 확인한다.", "section": "HM-8.5"}, {"order": 2, "text": "펌프 부하를 70 %로 낮춘다. 팬 속도는 그대로 둔다.", "section": "HM-8.5"}, {"order": 3, "text": "15분 재관측으로 HM-8.6 회복 판정을 한다.", "section": "HM-8.6"}, {"order": 4, "text": "야간 예정된 정비 시간에 SOP-COOL-14 핀 세척 작업지시를 건다.", "section": "HM-8.5"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:sop-cool-14", "name": "쿨러 핀 세척", "sopId": "SOP-COOL-14", "kind": "work_order", "description": "설비를 세우고 쿨러 핀을 세척한다. CMMS 작업지시로 발행한다.", "steps": [{"order": 1, "text": "설비를 정지하고 현장 패널에서 LOCAL로 전환한 뒤 잠금(LOTO)을 건다.", "section": "HM-8.7"}, {"order": 2, "text": "압축공기로 핀 바깥쪽에서 안쪽으로 세척한다. 고압수는 쓰지 않는다.", "section": "HM-8.7"}, {"order": 3, "text": "재가동 후 냉각 효율 CE가 80 % 이상으로 돌아왔는지 확인한다.", "section": "HM-8.7"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:sop-cool-15", "name": "캐비닛 환기 보강", "sopId": "SOP-COOL-15", "kind": "work_order", "description": "캐비닛 환기를 보강한다. CMMS 작업지시로 발행한다.", "steps": [{"order": 1, "text": "캐비닛 온도 TS4와 외기 온도를 기록한다.", "section": "HM-8.7"}, {"order": 2, "text": "환기 필터를 청소하고 배기 팬 동작을 점검한다.", "section": "HM-8.7"}, {"order": 3, "text": "캐비닛 온도가 35 ℃ 아래로 내려왔는지 확인한다.", "section": "HM-8.7"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:sop-fan-11", "name": "쿨러 팬 점검 절차", "sopId": "SOP-FAN-11", "kind": "work_order", "description": "벨트 슬립이나 베어링 마모가 의심될 때 쿨러 팬을 점검한다.", "steps": [{"order": 1, "text": "설비를 정지하고 현장 패널에서 LOCAL로 전환한다.", "section": "HM-8.1"}, {"order": 2, "text": "벨트 처짐을 측정한다 (기준 10~15 mm).", "section": "HM-8.1"}, {"order": 3, "text": "베어링 소음과 표면 온도를 확인한다 (60 ℃ 이하).", "section": "HM-8.1"}, {"order": 4, "text": "재가동 후 VS1이 0.9 mm/s 아래로 내려왔는지 확인한다.", "section": "HM-8.1"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:sop-fan-12", "name": "벨트 교체 절차", "sopId": "SOP-FAN-12", "kind": "work_order", "description": "벨트 처짐이 기준을 벗어나거나 균열이 보이면 교체한다.", "steps": [{"order": 1, "text": "LOCAL 전환과 잠금(LOTO)을 확인한다.", "section": "HM-8.2"}, {"order": 2, "text": "구 벨트를 분리하고 풀리 정렬을 점검한다.", "section": "HM-8.2"}, {"order": 3, "text": "새 벨트를 걸고 처짐을 12 mm로 맞춘다.", "section": "HM-8.2"}, {"order": 4, "text": "30분 시운전 뒤 냉각 효율 CE가 80 % 이상인지 확인한다.", "section": "HM-8.2"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:switch-standby-pump", "name": "예비 펌프 전환", "sopId": "SOP-PMP-01", "kind": "control", "description": "예비 펌프 B로 전환해 압력을 즉시 회복한다.", "steps": [{"order": 1, "text": "PLC 운전 모드가 REMOTE_AUTO인지 확인한다.", "section": "HM-3.2"}, {"order": 2, "text": "예비 펌프 B로 무부하 전환한다.", "section": "HM-5.2"}, {"order": 3, "text": "30초 안에 PS1이 175 bar 이상으로 회복됐는지 확인한다.", "section": "HM-5.2"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:derate-70", "name": "부하 70 %", "sopId": "SOP-PMP-02", "kind": "control", "description": "부하를 70 %로 낮춰 압력 부족과 누설 진행을 늦춘다.", "steps": [{"order": 1, "text": "PLC 운전 모드가 REMOTE_AUTO인지 확인한다.", "section": "HM-3.2"}, {"order": 2, "text": "펌프 부하를 70 %로 낮춘다.", "section": "HM-9.1"}, {"order": 3, "text": "PS1 하락이 멈췄는지 10분간 확인한다.", "section": "HM-5.2"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:raise-pressure", "name": "압력 설정 상향 (구 절차)", "sopId": "SOP-PMP-03", "kind": "control", "description": "압력 설정을 10 bar 올려 부족분을 메운다. 개정 매뉴얼에서 누설 시 금지된 옛 절차다.", "steps": [{"order": 1, "text": "압력 설정을 10 bar 올린다. 누설 의심 시에는 금지 (개정 HM-5.4).", "section": "HM-5.4"}, {"order": 2, "text": "PS1이 175 bar 이상인지 확인한다.", "section": "HM-5.2"}]}},
    {"labels": ["Skill"], "props": {"id": "skill:wo-pump-seal", "name": "펌프 축 씰 교체", "sopId": "SOP-PMP-04", "kind": "work_order", "description": "씰 키트를 구매요청하고 교체 작업지시를 발행한다.", "steps": [{"order": 1, "text": "주 펌프를 LOCAL로 전환하고 잠근다.", "section": "HM-3.1"}, {"order": 2, "text": "씰 키트를 교체한다.", "section": "HM-5.6"}, {"order": 3, "text": "누설 시험 후 주 펌프로 복귀한다.", "section": "HM-5.6"}]}},
