    {"labels": ["AnomalyPattern"], "props": {"id": "pattern:cooler-degradation", "name": "쿨러 성능 저하", "code": "COOLER_DEGRADATION", "rule": "TS1 > 55 and CE < 70 and slope(TS1) > 0", "holdSeconds": 60}},
    {"labels": ["AnomalyPattern"], "props": {"id": "pattern:pump-leakage", "name": "펌프 내부 누설", "code": "PUMP_LEAKAGE", "rule": "PLC.state == 'RUN' and PS1 < 165 and FS1 < 8.0 and LoadSP >= 80", "holdSeconds": 60}},
