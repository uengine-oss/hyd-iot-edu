    {"labels": ["AnomalyPattern"], "props": {"id": "pattern:oil-analysis", "name": "오일 분석 기준 이탈 (사람 입력)", "code": "OIL_ANALYSIS", "rule": "TAN delta >= 2 or water > 2500 ppm or ISO 4406 +2 codes or viscosity out of grade", "holdSeconds": 0}},
