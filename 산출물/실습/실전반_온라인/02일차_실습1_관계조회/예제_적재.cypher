// 교육용 별도 랩 DB에만 적용. HYD 기준 DB에 실행하지 않는다.
CREATE CONSTRAINT lab02_asset_id IF NOT EXISTS FOR (n:Asset) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT lab02_component_id IF NOT EXISTS FOR (n:Component) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT lab02_sensor_id IF NOT EXISTS FOR (n:Sensor) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT lab02_statevariable_id IF NOT EXISTS FOR (n:StateVariable) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT lab02_part_id IF NOT EXISTS FOR (n:Part) REQUIRE n.id IS UNIQUE;
MERGE (n:Asset {id:'asset:hyd-01'}) SET n += {id:'asset:hyd-01', code:'HYD-01', name:'HYD-01 유압 파워팩'};
MERGE (n:Component {id:'comp:cooler'}) SET n += {id:'comp:cooler', name:'오일 쿨러'};
MERGE (n:Component {id:'comp:fan'}) SET n += {id:'comp:fan', name:'쿨러 팬'};
MERGE (n:Component {id:'comp:pump-a'}) SET n += {id:'comp:pump-a', name:'주 펌프 (A)'};
MERGE (n:Component {id:'comp:pump-b'}) SET n += {id:'comp:pump-b', name:'예비 펌프 (B)'};
MERGE (n:Component {id:'comp:motor'}) SET n += {id:'comp:motor', name:'구동 모터'};
MERGE (n:Component {id:'comp:tank'}) SET n += {id:'comp:tank', name:'작동유 탱크'};
MERGE (n:Sensor {id:'sen:ts1'}) SET n += {id:'sen:ts1', name:'유온 센서', tag:'TS1', unit:'℃', virtual:false};
MERGE (n:StateVariable {id:'sv:ts1'}) SET n += {kind:'controlled', id:'sv:ts1', name:'유온', unit:'℃', normal:48, limit:65};
MERGE (n:Sensor {id:'sen:ce'}) SET n += {id:'sen:ce', name:'냉각 효율 (가상)', tag:'CE', unit:'%', virtual:true};
MERGE (n:StateVariable {id:'sv:ce'}) SET n += {kind:'controlled', id:'sv:ce', name:'냉각 효율', unit:'%', normal:84, limit:null};
MERGE (n:Sensor {id:'sen:ps1'}) SET n += {id:'sen:ps1', name:'토출 압력 센서', tag:'PS1', unit:'bar', virtual:false};
MERGE (n:StateVariable {id:'sv:ps1'}) SET n += {kind:'controlled', id:'sv:ps1', name:'토출 압력', unit:'bar', normal:182, limit:130};
MERGE (n:Sensor {id:'sen:fs1'}) SET n += {id:'sen:fs1', name:'유량 센서', tag:'FS1', unit:'l/min', virtual:false};
MERGE (n:StateVariable {id:'sv:fs1'}) SET n += {kind:'controlled', id:'sv:fs1', name:'유량', unit:'l/min', normal:9, limit:null};
MERGE (n:Sensor {id:'sen:vs1'}) SET n += {id:'sen:vs1', name:'팬 진동 센서', tag:'VS1', unit:'mm/s', virtual:false};
MERGE (n:StateVariable {id:'sv:vs1'}) SET n += {kind:'controlled', id:'sv:vs1', name:'팬 진동', unit:'mm/s', normal:0.6, limit:2};
MATCH (a {id:'asset:hyd-01'}), (b {id:'comp:cooler'}) MERGE (a)-[:HAS_COMPONENT]->(b);
MATCH (a {id:'asset:hyd-01'}), (b {id:'comp:fan'}) MERGE (a)-[:HAS_COMPONENT]->(b);
MATCH (a {id:'asset:hyd-01'}), (b {id:'comp:pump-a'}) MERGE (a)-[:HAS_COMPONENT]->(b);
MATCH (a {id:'asset:hyd-01'}), (b {id:'comp:pump-b'}) MERGE (a)-[:HAS_COMPONENT]->(b);
MATCH (a {id:'asset:hyd-01'}), (b {id:'comp:motor'}) MERGE (a)-[:HAS_COMPONENT]->(b);
MATCH (a {id:'asset:hyd-01'}), (b {id:'comp:tank'}) MERGE (a)-[:HAS_COMPONENT]->(b);
MATCH (a {id:'comp:cooler'}), (b {id:'sen:ts1'}) MERGE (a)-[:MONITORED_BY]->(b);
MATCH (a {id:'sen:ts1'}), (b {id:'sv:ts1'}) MERGE (a)-[:OBSERVES]->(b);
MATCH (a {id:'comp:cooler'}), (b {id:'sen:ce'}) MERGE (a)-[:MONITORED_BY]->(b);
MATCH (a {id:'sen:ce'}), (b {id:'sv:ce'}) MERGE (a)-[:OBSERVES]->(b);
MATCH (a {id:'comp:pump-a'}), (b {id:'sen:ps1'}) MERGE (a)-[:MONITORED_BY]->(b);
MATCH (a {id:'sen:ps1'}), (b {id:'sv:ps1'}) MERGE (a)-[:OBSERVES]->(b);
MATCH (a {id:'comp:pump-a'}), (b {id:'sen:fs1'}) MERGE (a)-[:MONITORED_BY]->(b);
MATCH (a {id:'sen:fs1'}), (b {id:'sv:fs1'}) MERGE (a)-[:OBSERVES]->(b);
MATCH (a {id:'comp:fan'}), (b {id:'sen:vs1'}) MERGE (a)-[:MONITORED_BY]->(b);
MATCH (a {id:'sen:vs1'}), (b {id:'sv:vs1'}) MERGE (a)-[:OBSERVES]->(b);
MERGE (n:Part {id:'part:cooler-core'}) SET n += {id:'part:cooler-core', name:'쿨러 코어', partNo:'P-CLR-CORE'};
MATCH (a:Component {id:'comp:cooler'}), (b:Part {id:'part:cooler-core'}) MERGE (a)-[:USES_PART]->(b);
MERGE (n:Part {id:'part:pump-seal'}) SET n += {id:'part:pump-seal', name:'펌프 축 씰 키트', partNo:'P-PMP-SEAL'};
MATCH (a:Component {id:'comp:pump-a'}), (b:Part {id:'part:pump-seal'}) MERGE (a)-[:USES_PART]->(b);
MERGE (n:Part {id:'part:fan-bearing'}) SET n += {id:'part:fan-bearing', name:'팬 베어링', partNo:'P-FAN-BRG'};
MATCH (a:Component {id:'comp:fan'}), (b:Part {id:'part:fan-bearing'}) MERGE (a)-[:USES_PART]->(b);
