      <bpmndi:BPMNShape id="T_po_di" bpmnElement="T_po">
        <dc:Bounds x="850" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_gr_di" bpmnElement="T_gr">
        <dc:Bounds x="1010" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R_ok_di" bpmnElement="R_ok">
        <dc:Bounds x="1170" y="390" width="100" height="80" />
