          <dc:Bounds x="1341" y="390" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_approve_di" bpmnElement="T_approve">
        <dc:Bounds x="490" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_overdue_di" bpmnElement="B_overdue">
        <dc:Bounds x="542" y="172" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="586" y="188" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_notice_di" bpmnElement="T_notice">
        <dc:Bounds x="510" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_approved_di" bpmnElement="G_approved" isMarkerVisible="true">
        <dc:Bounds x="730" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="734" y="103" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="R_rejected_di" bpmnElement="R_rejected">
        <dc:Bounds x="705" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_notice_di" bpmnElement="E_notice">
        <dc:Bounds x="640" y="532" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="644" y="575" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_rejected_di" bpmnElement="E_rejected">
