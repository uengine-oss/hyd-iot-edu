{
  "name": "HYD 유압 파워팩 공용 온톨로지 (설비 진단 부분)",
  "version": "2.6.0",
  "conventions": {
    "id": "모든 노드는 고유한 id를 가진다. 접두사가 클래스를 드러낸다 (kpi:, skill:, rule: …).",
    "name": "모든 노드는 사람이 읽는 한국어 name을 가진다. aliases는 엔티티 인식(entity resolution)용 다른 이름 목록이다.",
    "sign": "INFLUENCES · AFFECTS의 sign은 +1(같은 방향) 또는 -1(반대 방향)이다. 관계가 없으면 관계를 만들지 않는다 (0을 쓰지 않는다). 조건부면 sign을 두고 condition에 조건을 적는다.",
    "label_ko": "모든 클래스는 label_ko(한글 이름)를 가진다. 표와 그림은 이 이름을 쓴다."
  },
  "classes": [
    {
      "name": "Role",
      "label_ko": "역할",
      "description": "일을 수행하거나 승인하는 역할. level이 높을수록 승인 권한이 크다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "level",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "name": "Asset",
      "label_ko": "설비",
      "description": "설비 한 대. 예: 유압 파워팩 HYD-01.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "code",
          "type": "string",
          "required": true,
          "description": "운영 데이터(경보 · 태그 · 인시던트)가 쓰는 설비 코드. 예: HYD-01"
        }
      ]
    },
    {
      "name": "Component",
      "label_ko": "구성 요소",
      "description": "설비 구성 요소. 쿨러, 팬, 주 펌프, 예비 펌프, 모터, 탱크.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "aliases",
          "type": "string[]"
        }
      ]
    },
    {
      "name": "Sensor",
      "label_ko": "센서",
      "description": "계측 채널. 태그 이름이 실시간 데이터와 연결된다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "tag",
          "type": "string",
          "required": true
        },
        {
          "name": "unit",
          "type": "string"
        },
        {
          "name": "virtual",
          "type": "boolean",
          "description": "계산으로 만든 가상 센서면 true"
        }
      ]
    },
    {
      "name": "StateVariable",
      "label_ko": "상태 변수",
      "description": "설비의 물리량. 조작 변수(팬 속도, 부하)와 결과 변수(유온, 진동, 압력)가 있다. 물리 영향이 KPI로 이어지는 다리다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "aliases",
          "type": "string[]"
        },
        {
          "name": "unit",
          "type": "string",
          "required": true
        },
        {
          "name": "kind",
          "type": "enum",
          "values": [
            "manipulated",
            "controlled",
            "disturbance"
          ],
          "required": true
        },
        {
          "name": "normal",
          "type": "number",
          "description": "정상 운전점"
        },
        {
          "name": "limit",
          "type": "number",
          "description": "인터록 한계"
        }
      ]
    },
    {
      "name": "AnomalyPattern",
      "label_ko": "이상 패턴",
      "description": "CEP가 감지하는 이상 패턴. 탐지 임계값은 TESTS의 AND 조건이다. rule은 사람이 읽는 요약이며 실행하지 않는다. held 실행은 명시된 해제 조건과 시간 계약을 함께 검증한다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "code",
          "type": "string",
          "required": true,
          "description": "경보 메시지의 pattern 값. 예: COOLER_DEGRADATION"
        },
        {
          "name": "rule",
          "type": "string",
          "required": true
        },
        {
          "name": "holdSeconds",
          "type": "number"
        }
      ]
    },
    {
      "name": "Symptom",
      "label_ko": "증상",
      "description": "계측값의 이상 양상.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "aliases",
          "type": "string[]"
        },
        {
          "name": "note",
          "type": "string",
          "required": false,
          "description": "관측 방법 설명(실시간 센서가 없을 때 사람 입력 등). A098"
        }
      ]
    },
    {
      "name": "FailureMode",
      "label_ko": "고장 유형",
      "description": "구성 요소 단위의 고장 유형. 조치 방법(스킬)은 고장 유형에 매칭된다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "Cause",
      "label_ko": "원인",
      "description": "고장의 근본 원인. prior는 사전 확률이다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "aliases",
          "type": "string[]"
        },
        {
          "name": "prior",
          "type": "number",
          "required": true
        },
        {
          "name": "section",
          "type": "string",
          "description": "이 원인을 정한 매뉴얼 절"
        }
      ]
    },
    {
      "name": "Evidence",
      "label_ko": "증거",
      "description": "원인을 확정하는 정량 근거. sql 값이 expect 방향으로 threshold를 넘으면 통과한다. rule은 사람이 읽는 조건이다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "rule",
          "type": "string",
          "required": true
        },
        {
          "name": "expect",
          "type": "enum",
          "required": true,
          "values": [
            "lt",
            "gt",
            "gte"
          ],
          "description": "SQL 값과 threshold의 비교 방향"
        },
        {
          "name": "threshold",
          "type": "number",
          "required": true
        },
        {
          "name": "tag",
          "type": "string",
          "required": false,
          "description": "sql이 읽는 시계열 태그. windowSeconds와 함께 선언하면 구간 조건으로 보고, 수집 계약보다 긴 관측 공백이 있으면 판정하지 않는다(미확인)"
        },
        {
          "name": "windowSeconds",
          "type": "number",
          "required": false,
          "description": "sql이 집계하는 최근 구간(초)"
        },
        {
          "name": "aggregate",
          "type": "string",
          "description": "구간 값을 하나로 줄이는 방법. avg(평균) 또는 max-min(최댓값에서 최솟값을 뺀 폭)"
        },
        {
          "name": "section",
          "type": "string",
          "description": "이 증거를 정한 매뉴얼 절"
        }
      ]
    },
    {
      "name": "Skill",
      "label_ko": "조치 방법 (스킬 = SOP)",
      "description": "조치 방법. 하나의 스킬이 곧 하나의 SOP(표준 작업 절차)다. 절차 번호(sopId)와 단계(Step)를 직접 갖고, 고장 유형(FailureMode)에 즉시 완화 · 근본 조치 · 예방 조치(정기 정비) 중 하나로 매칭된다. 실행할 원자 조치(Action)를 파라미터 값과 함께 묶는다. 에이전트가 사람에게 내미는 조치 가이드 카드 한 장이 스킬 하나다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "sopId",
          "type": "string",
          "required": true,
          "description": "SOP 번호. 예: SOP-COOL-02"
        },
        {
          "name": "description",
          "type": "string",
          "required": true
        },
        {
          "name": "kind",
          "type": "enum",
          "values": [
            "control",
            "work_order"
          ],
          "required": true,
          "description": "control=PLC 즉시 제어, work_order=정비, business=기업 시스템 업무"
        },
        {
          "name": "steps",
          "type": "list",
          "description": "절차의 단계. 단계마다 order(순서), text(할 일), section(근거 매뉴얼 절)"
        }
      ]
    }
  ],
  "relationships": [
    {
      "type": "INFLUENCES",
      "from": [
        "StateVariable"
      ],
      "to": [
        "StateVariable"
      ],
      "cardinality": "N:M",
      "description": "상충 관계. 원천이 오르면 대상이 sign 방향으로 움직인다. 관계가 없으면 만들지 않는다.",
      "properties": [
        {
          "name": "sign",
          "type": "integer",
          "required": true,
          "values": [
            1,
            -1
          ]
        },
        {
          "name": "strength",
          "type": "enum",
          "values": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "name": "condition",
          "type": "string",
          "description": "조건부 영향일 때 조건"
        },
        {
          "name": "note",
          "type": "string"
        }
      ]
    },
    {
      "type": "HAS_COMPONENT",
      "from": [
        "Asset"
      ],
      "to": [
        "Component"
      ],
      "cardinality": "1:N",
      "description": "설비의 구성 요소"
    },
    {
      "type": "MONITORED_BY",
      "from": [
        "Component"
      ],
      "to": [
        "Sensor"
      ],
      "cardinality": "N:M",
      "description": "구성 요소를 계측하는 센서"
    },
    {
      "type": "OBSERVES",
      "from": [
        "Sensor"
      ],
      "to": [
        "StateVariable"
      ],
      "cardinality": "N:1",
      "description": "센서가 읽는 상태 변수"
    },
    {
      "type": "DETECTS",
      "from": [
        "AnomalyPattern"
      ],
      "to": [
        "Symptom"
      ],
      "cardinality": "N:M",
      "description": "패턴이 감지하는 증상"
    },
    {
      "type": "OBSERVED_BY",
      "from": [
        "Symptom"
      ],
      "to": [
        "Sensor"
      ],
      "cardinality": "N:M",
      "description": "증상이 보이는 센서"
    },
    {
      "type": "INDICATES",
      "from": [
        "Symptom"
      ],
      "to": [
        "FailureMode"
      ],
      "cardinality": "N:M",
      "description": "증상이 가리키는 고장 모드"
    },
    {
      "type": "OCCURS_IN",
      "from": [
        "FailureMode"
      ],
      "to": [
        "Component"
      ],
      "cardinality": "N:1",
      "description": "고장이 일어나는 구성 요소"
    },
    {
      "type": "LEADS_TO",
      "from": [
        "FailureMode"
      ],
      "to": [
        "FailureMode"
      ],
      "cardinality": "N:M",
      "description": "고장의 전파"
    },
    {
      "type": "CAUSES",
      "from": [
        "Cause"
      ],
      "to": [
        "FailureMode"
      ],
      "cardinality": "N:M",
      "description": "원인이 일으키는 고장 모드"
    },
    {
      "type": "DISTURBS",
      "from": [
        "Cause"
      ],
      "to": [
        "StateVariable"
      ],
      "cardinality": "N:M",
      "description": "원인이 움직이는 외란 상태 변수. 여기서 물리 영향(INFLUENCES) 경로가 시작된다",
      "properties": [
        {
          "name": "sign",
          "type": "integer",
          "required": true,
          "values": [
            1,
            -1
          ]
        }
      ]
    },
    {
      "type": "EVIDENCED_BY",
      "from": [
        "Cause"
      ],
      "to": [
        "Evidence"
      ],
      "cardinality": "1:N",
      "description": "원인을 확정하는 증거"
    },
    {
      "type": "MITIGATED_BY",
      "from": [
        "FailureMode"
      ],
      "to": [
        "Skill"
      ],
      "cardinality": "N:M",
      "description": "고장 유형을 즉시 완화하는 조치 방법(스킬 = SOP)"
    },
    {
      "type": "REMEDIED_BY",
      "from": [
        "FailureMode"
      ],
      "to": [
        "Skill"
      ],
      "cardinality": "N:M",
      "description": "고장 유형을 근본적으로 없애는 조치 방법(스킬 = SOP). 특정 원인에만 맞으면 ADDRESSES로 원인을 함께 단다"
    },
    {
      "type": "ADDRESSES",
      "from": [
        "Skill"
      ],
      "to": [
        "Cause"
      ],
      "cardinality": "N:M",
      "description": "조치 방법이 특정 원인에만 맞을 때 그 원인. 없으면 고장 유형의 모든 원인에 쓸 수 있다"
    },
    {
      "type": "APPROVED_BY",
      "from": [
        "Skill"
      ],
      "to": [
        "Role"
      ],
      "cardinality": "N:1",
      "description": "스킬 실행을 승인할 최소 역할"
    }
  ]
}
