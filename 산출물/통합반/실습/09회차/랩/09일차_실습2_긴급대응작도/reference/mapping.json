{
  "name": "냉각 긴급 대응",
  "start": {
    "kind": "alert",
    "patterns": [
      "COOLER_DEGRADATION"
    ]
  },
  "lanes": {},
  "tasks": {
    "T_agent": {
      "part": "task:decide",
      "agent": "agent:cooling",
      "instruction": "쿨러 과열의 원인을 진단하고 냉각 조치 후보를 비교해 추천 카드 한 장과 지는 대안을 낸다"
    },
    "T_approve": {
      "part": "task:select-or-reject",
      "role": "운전원"
    },
    "T_notice": {
      "part": "svc:report",
      "config": {
        "outcome": "승인 지연",
        "title": "{asset} 냉각 조치 승인 지연",
        "summary": "승인 대기 중 — 경보 {alert.alertId}. 승인하거나 거절할 때까지 기다립니다"
      }
    },
    "R_rejected": {
      "part": "svc:report",
      "config": {
        "outcome": "반려",
        "title": "{asset} 냉각 조치 결과",
        "summary": "담당자가 거절했습니다 — 사유: {approval_reason}. 설비 명령은 내지 않았습니다"
      }
    },
    "T_cmd": {
      "part": "task:command"
    },
    "T_reobs": {
      "part": "task:reobserve"
    },
    "T_wo": {
      "part": "task:work-order"
    },
    "R_ok": {
      "part": "svc:report",
      "config": {
        "outcome": "정상",
        "title": "{asset} 긴급 대응 결과",
        "summary": "유온 정상 · 경보 해제, 작업지시 {work_order.ref}"
      }
    },
    "R_fail": {
      "part": "svc:report",
      "config": {
        "outcome": "미달",
        "title": "{asset} 긴급 대응 결과",
        "summary": "재관측 기준 미달 — 승인자 {approved_by_name}"
      }
    }
  },
  "timers": {
    "B_overdue": "PT10M"
  },
  "flows": {
    "F_approved": {
      "var": "approval",
      "op": "==",
      "value": "승인"
    },
    "F_rejected": {
      "default": true
    },
    "F_yes": {
      "var": "recovered",
      "op": "==",
      "value": true
    },
    "F_no": {
      "default": true
    }
  }
}
