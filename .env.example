# 시간 배율: 벽시계 1초 = TIME_SCALE 시뮬레이션 초 (plant-sim · detector · process 공통)
TIME_SCALE=20
# 기본으로 올릴 프로필 (경량 기본값. Prometheus는 monitor, Redpanda Console은 tools 프로필을 추가하면 뜬다)
COMPOSE_PROFILES=ot,backbone,detect,knowledge,agent,enterprise,process
# 선택: 에이전트 요약문을 LLM이 쓰게 하려면 키를 넣으세요. 없어도 전체 시나리오가 동작합니다.
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=
OPENAI_API_KEY=
# OpenAI or an OpenAI-compatible LiteLLM endpoint (including /v1)
OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI 호환 서버(SGLang 등)의 키와 추가 요청 본문(JSON). 예: {"chat_template_kwargs":{"enable_thinking":false}}
LLM_API_KEY=
LLM_EXTRA_BODY=
LLM_TIMEOUT_SECONDS=8
# 기업 시스템 원천: memory(기본, Supabase 불필요) | supabase(SUPABASE_DSN 의 ent 스키마)
ENTERPRISE_BACKEND=memory
# DAQ: lite(시간조건 입력 6종 1 Hz, 기타 예외 보고·파형 없음) | full(전 태그 1 Hz + 100 Hz 파형)
DAQ_PROFILE=lite
# detector 입력의 허용 나이/간격 = DAQ wall-clock heartbeat + 아래 지연 여유(초)
# TIME_SCALE로 heartbeat를 나누지 않는다. 지속시간 hold만 시뮬레이션 초다.
OBSERVATION_GRACE_S=2
# 프로세스 모드 (docs/HANDOFF.md): legacy(기본) | instance(경보 → 프로세스 인스턴스 → 에이전트·사람 태스크, Supabase 필요: cd it/supabase && supabase start)
PROCESS_MODE=legacy
PROCESS_REPO=pg
# 온톨로지 시드 판 (확정 TODO C1, it/neo4j/edition.sh): structure(수업용 구조판 — 고장 · 원인 · 조치 지식은 문서 적재로) | full(회귀용 전체판 — 회귀 · 통합 시험)
# kg-seed는 MERGE만 하므로 이미 지식이 있는 볼륨을 structure로 다시 돌려도 지워지지 않는다. 판을 바꾸려면 새 neo4j 볼륨에서 적재한다.
SEED_EDITION=structure
# PG 원천/승인/투영 큐를 함께 실행하는 프로세스 서비스의 메모리 상한
PROCESS_MEM_LIMIT=768m   # A115: legacy incident snapshot (~190 incidents, 11 MB JSON) is held in memory; 512m reached 509 MiB RSS in regressions
SUPABASE_DSN=postgresql://postgres:postgres@host.docker.internal:54322/postgres
ENTERPRISE_READ_DSN=postgresql://hyd_enterprise_reader:hyd-enterprise-read-local@host.docker.internal:54322/postgres
TSDB_READ_DSN=postgresql://hyd_timeseries_reader:hyd-timeseries-read-local@timescaledb:5432/hyd
# instance 모드에서 cliagents 워커가 없을 때 기존 에이전트 결과로 네 태스크를 채우는 다리: legacy | off
AGENT_BRIDGE=legacy
# A148: process가 승인마다 audit 토픽에 남기는 명령 지문(HMAC) 키. process와 cmd-gateway가 같은 값을 써야 한다(기본값은 수업용).
# CMD_FINGERPRINT_KEY=hyd-cmd-approval-local
# instance 모드의 Claude Code 워커 (프로필 cliagents). MCP 서버 목록은 Supabase tenants.mcp(it/supabase/seed.sql)에 있다.
#   컨테이너(API 키):  ANTHROPIC_API_KEY 를 넣고 COMPOSE_PROFILES 에 cliagents 를 더한다.
#   이 PC(구독 로그인): scripts/run_worker_host.sh — 로그인된 claude CLI 를 그대로 쓴다. 아래 변수는 그때 컨테이너 호스트명을 바꾼다.
CLIAGENTS_DEFAULT_CLI=claude-code
CLIAGENTS_DEFAULT_PERMISSION=workspace_write
CLIAGENTS_RUN_TIMEOUT_SECONDS=1800
MCP_HOST_REWRITE=neo4j:7687=127.0.0.1:7687,enterprise-mcp:8199=127.0.0.1:8199,dmn-mcp:8198=127.0.0.1:8198
# process 가 포털 "에이전트 현황"에 보여 줄 워커 주소. 컨테이너 워커: http://agent-worker:8097 · 이 PC 워커: http://host.docker.internal:8097
WORKER_URL=http://agent-worker:8097
