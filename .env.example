# 시간 배율: 벽시계 1초 = TIME_SCALE 시뮬레이션 초 (plant-sim · detector · process 공통)
TIME_SCALE=20
# 기본으로 올릴 프로필 (경량 기본값. Prometheus는 monitor, Redpanda Console은 tools 프로필을 추가하면 뜬다)
COMPOSE_PROFILES=ot,backbone,detect,knowledge,agent,enterprise,process
# 선택: 에이전트 요약문을 LLM이 쓰게 하려면 키를 넣으세요. 없어도 전체 시나리오가 동작합니다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# DAQ 발행 프로필: lite(기본, 예외 보고·파형 없음) | full(전 태그 1 Hz + 100 Hz 파형)
DAQ_PROFILE=lite
