<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="HandoverDefinitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ShiftHandover" name="교대 인수인계" isExecutable="true">
    <bpmn:laneSet id="ShiftHandover_lanes">
      <bpmn:lane id="lane_agent" name="AI 에이전트">
        <bpmn:flowNodeRef>ev_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_draft_r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_draft_r3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sender" name="인계자">
        <bpmn:flowNodeRef>task_sender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_sender_r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sender_r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_sender_r3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_sender_r3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_receiver" name="인수자">
        <bpmn:flowNodeRef>task_receiver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_receiver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_receiver_r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_receiver_r2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_receiver_r3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_receiver_r3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ev_start" name="인계 요청" />
    <bpmn:userTask id="task_draft" name="인계안 작성" />
    <bpmn:userTask id="task_sender" name="인계자 검토" />
    <bpmn:exclusiveGateway id="gw_sender" name="인계자 결정" />
    <bpmn:userTask id="task_receiver" name="인수자 확인" />
    <bpmn:exclusiveGateway id="gw_receiver" name="인수자 결정" />
    <bpmn:userTask id="task_draft_r2" name="인계안 작성 · 보완 1" />
    <bpmn:userTask id="task_sender_r2" name="인계자 검토 · 보완 1" />
