<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="HandoverDefinitions" targetNamespace="https://hyd.local/classroom">
  <bpmn:process id="ShiftHandover" name="교대 인수인계" isExecutable="true">
    <bpmn:startEvent id="ev_start" name="인계 요청" />
    <bpmn:endEvent id="ev_confirmed" name="인수 확인 기록 완료" />
    <bpmn:endEvent id="ev_rejected" name="인계 거절 기록" />
    <bpmn:endEvent id="ev_followup" name="후속 확인 필요 · 인수 미확정" />
    <bpmn:userTask id="task_draft" name="인계안 작성" />
    <bpmn:userTask id="task_sender" name="인계자 검토" />
    <bpmn:userTask id="task_receiver" name="인수자 확인" />
    <bpmn:userTask id="task_draft_r2" name="인계안 작성 · 보완 1" />
    <bpmn:userTask id="task_sender_r2" name="인계자 검토 · 보완 1" />
    <bpmn:userTask id="task_receiver_r2" name="인수자 확인 · 보완 1" />
    <bpmn:userTask id="task_draft_r3" name="인계안 작성 · 보완 2" />
    <bpmn:userTask id="task_sender_r3" name="인계자 검토 · 보완 2" />
    <bpmn:userTask id="task_receiver_r3" name="인수자 확인 · 보완 2" />
    <bpmn:exclusiveGateway id="gw_sender" name="검토 결정" />
    <bpmn:exclusiveGateway id="gw_receiver" name="검토 결정" />
    <bpmn:exclusiveGateway id="gw_sender_r2" name="검토 결정" />
    <bpmn:exclusiveGateway id="gw_receiver_r2" name="검토 결정" />
    <bpmn:exclusiveGateway id="gw_sender_r3" name="검토 결정" />
    <bpmn:exclusiveGateway id="gw_receiver_r3" name="검토 결정" />
    <bpmn:sequenceFlow id="seq_0" sourceRef="ev_start" targetRef="task_draft" />
    <bpmn:sequenceFlow id="seq_1" sourceRef="task_draft" targetRef="task_sender" />
    <bpmn:sequenceFlow id="seq_2" sourceRef="task_sender" targetRef="gw_sender" />
    <bpmn:sequenceFlow id="seq_3" sourceRef="gw_sender" targetRef="task_receiver" name="sender_decision == 'approve'" />
    <bpmn:sequenceFlow id="seq_4" sourceRef="gw_sender" targetRef="task_draft_r2" name="sender_decision == 'revise'" />
    <bpmn:sequenceFlow id="seq_5" sourceRef="gw_sender" targetRef="ev_rejected" name="sender_decision == 'reject'" />
    <bpmn:sequenceFlow id="seq_6" sourceRef="task_receiver" targetRef="gw_receiver" />
    <bpmn:sequenceFlow id="seq_7" sourceRef="gw_receiver" targetRef="ev_confirmed" name="receiver_decision == 'confirm'" />
    <bpmn:sequenceFlow id="seq_8" sourceRef="gw_receiver" targetRef="task_draft_r2" name="receiver_decision == 'revise'" />
    <bpmn:sequenceFlow id="seq_9" sourceRef="task_draft_r2" targetRef="task_sender_r2" />
    <bpmn:sequenceFlow id="seq_10" sourceRef="task_sender_r2" targetRef="gw_sender_r2" />
    <bpmn:sequenceFlow id="seq_11" sourceRef="gw_sender_r2" targetRef="task_receiver_r2" name="sender_decision == 'approve'" />
    <bpmn:sequenceFlow id="seq_12" sourceRef="gw_sender_r2" targetRef="task_draft_r3" name="sender_decision == 'revise'" />
    <bpmn:sequenceFlow id="seq_13" sourceRef="gw_sender_r2" targetRef="ev_rejected" name="sender_decision == 'reject'" />
    <bpmn:sequenceFlow id="seq_14" sourceRef="task_receiver_r2" targetRef="gw_receiver_r2" />
    <bpmn:sequenceFlow id="seq_15" sourceRef="gw_receiver_r2" targetRef="ev_confirmed" name="receiver_decision == 'confirm'" />
    <bpmn:sequenceFlow id="seq_16" sourceRef="gw_receiver_r2" targetRef="task_draft_r3" name="receiver_decision == 'revise'" />
    <bpmn:sequenceFlow id="seq_17" sourceRef="task_draft_r3" targetRef="task_sender_r3" />
    <bpmn:sequenceFlow id="seq_18" sourceRef="task_sender_r3" targetRef="gw_sender_r3" />
    <bpmn:sequenceFlow id="seq_19" sourceRef="gw_sender_r3" targetRef="task_receiver_r3" name="sender_decision == 'approve'" />
    <bpmn:sequenceFlow id="seq_20" sourceRef="gw_sender_r3" targetRef="ev_followup" name="sender_decision == 'revise'" />
    <bpmn:sequenceFlow id="seq_21" sourceRef="gw_sender_r3" targetRef="ev_rejected" name="sender_decision == 'reject'" />
    <bpmn:sequenceFlow id="seq_22" sourceRef="task_receiver_r3" targetRef="gw_receiver_r3" />
    <bpmn:sequenceFlow id="seq_23" sourceRef="gw_receiver_r3" targetRef="ev_confirmed" name="receiver_decision == 'confirm'" />
    <bpmn:sequenceFlow id="seq_24" sourceRef="gw_receiver_r3" targetRef="ev_followup" name="receiver_decision == 'revise'" />
  </bpmn:process>
