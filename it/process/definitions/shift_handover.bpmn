      <bpmndi:BPMNShape id="task_draft_r3_di" bpmnElement="task_draft_r3">
        <dc:Bounds x="200" y="700" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_sender_r3_di" bpmnElement="task_sender_r3">
        <dc:Bounds x="420" y="700" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_receiver_r3_di" bpmnElement="task_receiver_r3">
        <dc:Bounds x="760" y="700" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_sender_di" bpmnElement="gw_sender">
        <dc:Bounds x="610" y="100" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_receiver_di" bpmnElement="gw_receiver">
        <dc:Bounds x="960" y="100" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_sender_r2_di" bpmnElement="gw_sender_r2">
        <dc:Bounds x="610" y="400" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_receiver_r2_di" bpmnElement="gw_receiver_r2">
        <dc:Bounds x="960" y="400" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_sender_r3_di" bpmnElement="gw_sender_r3">
        <dc:Bounds x="610" y="700" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_receiver_r3_di" bpmnElement="gw_receiver_r3">
        <dc:Bounds x="960" y="700" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="seq_0_di" bpmnElement="seq_0">
        <di:waypoint x="100" y="120.0" />
        <di:waypoint x="200" y="140.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="seq_1_di" bpmnElement="seq_1">
