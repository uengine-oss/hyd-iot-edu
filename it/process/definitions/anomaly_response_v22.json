      "id": "seq:rank-select",
      "source": "task:rank",
      "target": "task:select"
    },
    {
      "id": "seq:select-gw",
      "source": "task:select",
      "target": "gw:approved"
    },
    {
      "id": "seq:approved",
      "source": "gw:approved",
      "target": "gw:control",
      "name": "승인",
