{
  "processDefinitionId": "anomaly_response",
  "processDefinitionName": "설비 이상 조치",
  "version": "2.6",
  "description": "경보가 처리 건을 열고, AI 에이전트가 네 단계(원인 진단 · 조치 후보 조회 · 규정 검토 · 조치 후보 정리)로 조치 후보를 올리면, 담당자가 후보 하나를 승인하거나 반려한다(폼 select_card 제출). 승인하면 고른 후보의 조치 종류대로 설비에 명령 · 효과 확인 · 정비 요청 등록을 실행해 처리 완료로 끝내고, 설비 명령도 정비 요청도 없는 후보(발주만 · 실행할 조치 없음)는 설비에 아무것도 하지 않은 사실을 결과 보고로 남기고 끝낸다. 효과 확인에서 회복되지 않았거나 담당자가 제때 고르지 않으면 책임자 확인으로 넘긴다. 반려하면 설비 · 업무에 아무것도 하지 않고 결과 보고(반려)로 끝낸다. AI 에이전트 단계는 ProcessGPT와 같은 모양(userTask + agentMode COMPLETE + orchestration cliagents)으로 적는다. 온톨로지 v2 proc:anomaly-response 가 이 흐름의 객체(역할 · 시스템 · 판단)를 갖고, 단계 순서의 정본은 이 정의다.",
  "ontologyRef": "proc:anomaly-response",
  "megaProcessId": "설비 운영",
  "majorProcessId": "설비 이상 대응",
  "data": [
    {
      "name": "asset",
      "type": "Text",
      "description": "경보가 난 설비 (상관 키, 예: HYD-01)"
    },
    {
      "name": "alert",
      "type": "Object",
      "description": "원천 경보 메시지 (alertId · pattern · state · evidence)"
    },
    {
      "name": "pattern",
      "type": "Text",
      "description": "이상 패턴 코드 (AnomalyPattern.code)"
    },
    {
      "name": "cause",
      "type": "Text",
      "description": "판정된 원인 (Cause.id)"
    },
    {
      "name": "failure_mode",
      "type": "Text",
      "description": "고장 유형 (FailureMode.id)"
    },
    {
      "name": "guide_card",
      "type": "Object",
      "description": "원인 · 증거 · SOP 스킬 · 매뉴얼 절을 인용한 가이드 카드"
    },
    {
      "name": "candidates",
      "type": "Array",
      "description": "dec:action-candidates 가 고른 후보 스킬 목록"
    },
    {
      "name": "compliance",
      "type": "Object",
      "description": "dec:compliance 규칙 판정 (제외 · 감점 · 경고)"
    },
    {
      "name": "decision",
      "type": "Object",
      "description": "순위가 매겨진 조치 카드 묶음 (process /api/decisions 에 제출된 것)"
    },
    {
      "name": "decision_id",
      "type": "Text",
      "description": "조치 카드 묶음 id"
    },
    {
      "name": "incident",
      "type": "Text",
      "description": "PLC 명령 경로를 맡는 Incident id — process 가 인스턴스 시작 때 만들어 넣는다 (에이전트 출력 아님)"
    },
    {
      "name": "chosen_skill",
      "type": "Text",
      "description": "사람이 승인한 조치 방법 id — 반려하면 없다"
    },
    {
      "name": "chosen_skill_kind",
      "type": "Text",
      "description": "고른 카드의 조치 종류: control(설비 명령) | work_order(정비 요청만) | purchase(발주만) | other(명령 · 정비 요청 · 발주 없음 — 흐름이 실행하지 않음)"
    },
    {
      "name": "recovered",
      "type": "Boolean",
      "description": "효과 확인 결과 — 경보 해제 and 경보 패턴별 회복 기준(이 정의의 alertPolicy) 충족"
    },
    {
      "name": "work_order",
      "type": "Object",
      "description": "정비 요청 등록 결과"
    },
    {
      "name": "note",
      "type": "Text",
      "description": "책임자 확인 메모"
    },
    {
      "name": "approval",
      "type": "Text",
      "description": "조치 카드 승인 단계의 결정: 승인 | 반려"
    },
    {
      "name": "approval_reason",
      "type": "Text",
      "description": "승인 · 반려 사유 (반려는 반드시 적는다)"
    },
    {
      "name": "result_report",
      "type": "Object",
      "description": "결과 보고 (outcome · title · summary · facts · refs) — 반려 · 실행하지 않음으로 끝난 처리 건이 남긴다"
    }
  ],
  "roles": [
    {
      "name": "AI 에이전트",
      "endpoint": "sys:agent",
      "resolutionRule": "온톨로지 System sys:agent — cliagents 워커가 Claude Code 로 수행"
    },
    {
      "name": "운전원",
      "endpoint": "role:operator",
      "resolutionRule": "온톨로지 Role role:operator (level 1). 조치 후보 승인 · 반려"
    },
    {
      "name": "생산관리자",
      "endpoint": "role:prod-mgr",
      "resolutionRule": "온톨로지 Role role:prod-mgr (level 2). 책임자 확인"
    },
    {
      "name": "SCADA",
      "endpoint": "sys:scada",
      "resolutionRule": "PLC 명령 — process 서비스의 Incident 경로(action.cmd → cmd-gateway)만 발행"
    },
    {
      "name": "프로세스",
      "endpoint": "sys:process",
      "resolutionRule": "process 서비스 자체 (타이머 · 효과 확인 · 결과 보고)"
    },
    {
      "name": "CMMS",
      "endpoint": "sys:cmms",
      "resolutionRule": "enterprise 시스템 (정비 요청)"
    }
  ],
  "events": [
    {
      "id": "ev:alert",
      "name": "설비 경보",
      "type": "startEvent",
      "eventDefinition": "message",
      "messageRef": "alerts (state=RAISE)",
      "correlationKey": "asset",
      "description": "Kafka alerts 토픽의 RAISE 메시지 하나가 인스턴스 하나를 연다. 같은 alertId 로는 두 번 열지 않는다."
    },
    {
      "id": "ev:select-timeout",
      "name": "선택 시간 초과",
      "type": "boundaryEvent",
      "eventDefinition": "timer",
      "timer": "PT10M",
      "attachedTo": "task:select",
      "description": "운전원이 10분 안에 조치 후보를 승인하거나 반려하지 않으면 생산관리자에게 넘어간다(사람이 읽고 고르는 시간이라 벽시계 — 배속을 곱하지 않는다)."
    },
    {
      "id": "ev:closed",
      "name": "처리 완료",
      "type": "endEvent",
      "eventDefinition": "none"
    },
    {
      "id": "ev:escalated",
      "name": "책임자 확인 종결",
      "type": "endEvent",
      "eventDefinition": "escalation"
    },
    {
      "id": "ev:rejected",
      "name": "반려 종결",
      "type": "endEvent",
      "eventDefinition": "none"
    },
    {
      "id": "ev:not-executed",
      "name": "실행하지 않음",
      "type": "endEvent",
      "eventDefinition": "none"
    }
  ],
  "activities": [
    {
      "id": "task:diagnose",
      "name": "원인 진단",
      "type": "userTask",
      "role": "AI 에이전트",
      "agent": "sys:agent",
      "agentMode": "COMPLETE",
      "orchestration": "cliagents",
      "decision": "dec:diagnose-cause",
      "tool": "formHandler:diagnose",
      "instruction": "경보 패턴에서 증상 → 고장 유형 → 원인 후보를 온톨로지(Neo4j MCP)로 찾고, 각 원인의 증거 규칙(Evidence.sql)을 시계열 DB 에서 평가해 원인 점수를 매긴다. 가장 유력한 원인과 고장 유형, 인용 노드 id 를 출력한다. 조치를 실행하지 않는다.",
      "inputData": [
        "pattern",
        "asset",
        "alert"
      ],
      "outputData": [
        "cause",
        "failure_mode",
        "guide_card"
      ],
      "checkpoints": [
        "모든 주장에 온톨로지 노드 id 인용",
        "데이터 신선도 60 s 이내가 아니면 보류 카드"
      ],
      "duration": 2,
      "description": "원인 진단"
    },
    {
      "id": "task:candidates",
      "name": "조치 후보 조회",
      "type": "userTask",
      "role": "AI 에이전트",
      "agent": "sys:agent",
      "agentMode": "COMPLETE",
      "orchestration": "cliagents",
      "decision": "dec:action-candidates",
      "tool": "formHandler:candidates",
      "instruction": "고장 유형 · PLC 상태를 dec:action-candidates 결정표(DMN)에 대어 후보 조치 방법(스킬 = SOP)을 고른다. 원인 한정 스킬(ADDRESSES)은 판정 원인일 때만 남긴다.",
      "inputData": [
        "failure_mode",
        "cause",
        "asset"
      ],
      "outputData": [
        "candidates"
      ],
      "duration": 1,
      "description": "조치 후보 조회"
    },
    {
      "id": "task:compliance",
      "name": "규정 검토",
      "type": "userTask",
      "role": "AI 에이전트",
      "agent": "sys:agent",
      "agentMode": "COMPLETE",
      "orchestration": "cliagents",
      "decision": "dec:compliance",
      "tool": "formHandler:compliance",
      "instruction": "후보마다 예측 유온 · 압력, 스킬 종류, 명령 코드, 공급사 승인, PLC 모드를 dec:compliance 규칙에 대어 제외(EXCLUDE) · 감점(PENALTY) · 경고(WARN)를 정한다. 규칙 출처(KnowledgeSource · 매뉴얼 절)를 인용한다.",
      "inputData": [
        "candidates",
        "asset"
      ],
      "outputData": [
        "compliance"
      ],
      "duration": 1,
      "description": "규정 검토"
    },
    {
      "id": "task:rank",
      "name": "조치 후보 정리",
      "type": "userTask",
      "role": "AI 에이전트",
      "agent": "sys:agent",
      "agentMode": "COMPLETE",
      "orchestration": "cliagents",
      "decision": "dec:rank-actions",
      "tool": "formHandler:rank",
      "instruction": "BSC 득실(AFFECTS → INFLUENCES 경로) · 예측 · 경고 · 감점 · 선례로 후보 순위를 매기고, 업무 시스템 조회 서버(enterprise)에서 납기 · 계약 · 재고를 읽어 영향을 설명에 넣는다. 사람이 고를 카드 2~3장과 권고 1장을 process /api/decisions 에 제출한다. 승인 역할은 온톨로지 Skill -APPROVED_BY-> Role 을 따른다.",
      "inputData": [
        "candidates",
        "compliance",
        "asset",
        "incident"
      ],
      "outputData": [
        "decision",
        "decision_id"
      ],
      "duration": 2,
      "description": "조치 후보 정리"
    },
    {
      "id": "task:select",
      "name": "조치 선택 · 승인",
      "type": "userTask",
      "role": "운전원",
      "tool": "formHandler:select_card",
      "agent": null,
      "instruction": "에이전트가 올린 카드 중 하나를 승인하거나, 어느 카드도 실행하지 않기로 하고 사유와 함께 반려한다. 승인은 고른 카드의 승인 역할 이상만 할 수 있고(아니면 process 가 403 으로 막는다), 반려하면 설비 명령 · 업무 거래를 하나도 내지 않고 결과 보고(반려)로 끝난다.",
      "inputData": [
        "decision"
      ],
      "outputData": [
        "chosen_skill",
        "chosen_skill_kind",
        "approval",
        "approval_reason"
      ],
      "checkpoints": [
        "규정상 제외된 카드는 고를 수 없음",
        "승인 역할 ≥ 카드의 APPROVED_BY",
        "반려에는 사유를 적는다"
      ],
      "duration": 1,
      "attachedEvents": [
        "ev:select-timeout"
      ],
      "description": "조치 선택 · 승인"
    },
    {
      "id": "task:escalate",
      "name": "책임자 확인",
      "type": "userTask",
      "role": "생산관리자",
      "tool": "formHandler:escalate",
      "agent": null,
      "instruction": "선택 시간 초과 또는 미회복. 생산관리자가 상황을 확인하고 후속 조치를 결정한다.",
      "inputData": [
        "decision",
        "incident",
        "recovered"
      ],
      "outputData": [
        "note"
      ],
      "duration": 1,
      "description": "책임자 확인"
    },
    {
      "id": "task:command",
      "name": "설비에 명령",
      "type": "serviceTask",
      "role": "SCADA",
      "agent": null,
      "orchestration": "hyd-process",
      "tool": "incident:command",
      "instruction": "고른 스킬의 원자 조치(Action.code · value)를 action.cmd 로 발행한다 (만료 +120 s). cmd-gateway 검증 5종 → PLC → ACK 30 s. 이 작업은 process 서비스의 Incident 상태기계가 수행한다.",
      "inputData": [
        "chosen_skill",
        "incident"
      ],
      "outputData": [],
      "duration": 1,
      "description": "설비에 명령"
    },
    {
      "id": "task:reobserve",
      "name": "효과 확인 (15분)",
      "type": "serviceTask",
      "role": "프로세스",
      "agent": null,
      "orchestration": "hyd-process",
      "tool": "incident:reobserve",
      "instruction": "ACK 뒤 15분(시간 배율 적용) 효과를 확인한다. 경보 CLEAR와 사건에 고정된 정의의 패턴별 회복 기준을 함께 확인한다. 기준이 없으면 회복으로 판정하지 않는다.",
      "inputData": [
        "incident"
      ],
      "outputData": [
        "recovered"
      ],
      "duration": 1,
      "description": "효과 확인 (15분)"
    },
    {
      "id": "task:work-order",
      "name": "정비 요청 등록",
      "type": "serviceTask",
      "role": "CMMS",
      "agent": null,
      "orchestration": "hyd-process",
      "tool": "enterprise:WO_CREATE",
      "instruction": "고른 스킬의 WO_CREATE 트랜잭션을 CMMS 에 발행한다 (업무 DB work_orders 행). 발행은 정비 완료가 아니다.",
      "inputData": [
        "chosen_skill",
        "asset"
      ],
      "outputData": [
        "work_order"
      ],
      "duration": 1,
      "description": "정비 요청 등록"
    },
    {
      "id": "task:report-rejected",
      "name": "결과 보고: 반려",
      "type": "serviceTask",
      "role": "프로세스",
      "agent": null,
      "orchestration": "hyd-process",
      "tool": "process:report",
      "service": {
        "outcome": "반려",
        "title": "{asset} 설비 이상 조치 결과",
        "summary": "담당자가 반려했습니다. 설비 명령 · 업무 거래는 내지 않았습니다 — 사유: {approval_reason}"
      },
      "inputData": [],
      "outputData": [
        "result_report"
      ],
      "checkpoints": [],
      "duration": 1,
      "description": "결과 보고: 반려"
    },
    {
      "id": "task:report-purchase-only",
      "name": "결과 보고: 발주만 등록",
      "type": "serviceTask",
      "role": "프로세스",
      "agent": null,
      "orchestration": "hyd-process",
      "tool": "process:report",
      "service": {
        "outcome": "실행하지 않음",
        "title": "{asset} 설비 이상 조치 결과",
        "summary": "승인한 카드는 발주만 있는 카드입니다. 구매요청은 승인을 전달할 때 구매 · 재고 관리에 등록했고(승인 기록의 전달 결과), 설비에는 명령도 정비 요청도 내지 않았습니다. 설비 이상은 그대로이므로 책임자가 설비 조치를 따로 정해야 합니다 — 승인자 {approved_by_name}"
      },
      "inputData": [],
      "outputData": [
        "result_report"
      ],
      "checkpoints": [],
      "duration": 1,
      "description": "결과 보고: 발주만 등록"
    },
    {
      "id": "task:report-no-action",
      "name": "결과 보고: 조치 종류 확인 필요",
      "type": "serviceTask",
      "role": "프로세스",
      "agent": null,
      "orchestration": "hyd-process",
      "tool": "process:report",
      "service": {
        "outcome": "실행하지 않음",
        "title": "{asset} 설비 이상 조치 결과",
        "summary": "승인한 조치 후보에는 설비 명령도 정비 요청도 발주도 없어 이 흐름이 실행한 것이 없습니다. 설비 이상은 그대로이므로 조치 방법의 조치 구성을 확인하고 다시 판단해 다른 카드를 고르세요 — 승인자 {approved_by_name}"
      },
      "inputData": [],
      "outputData": [
        "result_report"
      ],
      "checkpoints": [],
      "duration": 1,
      "description": "결과 보고: 조치 종류 확인 필요"
    }
  ],
  "gateways": [
    {
      "id": "gw:approved",
      "name": "승인?",
      "type": "exclusiveGateway",
      "conditionData": [
        "approval"
      ]
    },
    {
      "id": "gw:control",
      "name": "조치 종류?",
      "type": "exclusiveGateway",
      "conditionData": [
        "chosen_skill_kind"
      ]
    },
    {
      "id": "gw:recovered",
      "name": "회복?",
      "type": "exclusiveGateway",
      "conditionData": [
        "recovered"
      ]
    }
  ],
  "sequences": [
    {
      "id": "seq:alert-diagnose",
      "source": "ev:alert",
      "target": "task:diagnose"
    },
    {
      "id": "seq:diagnose-candidates",
      "source": "task:diagnose",
      "target": "task:candidates"
    },
    {
      "id": "seq:candidates-compliance",
      "source": "task:candidates",
      "target": "task:compliance"
    },
    {
      "id": "seq:compliance-rank",
      "source": "task:compliance",
      "target": "task:rank"
    },
