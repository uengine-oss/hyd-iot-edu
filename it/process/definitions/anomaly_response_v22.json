      }
    },
    {
      "id": "seq:gw-command",
      "source": "gw:control",
      "target": "task:command",
      "name": "설비 명령",
      "condition": "chosen_skill_kind == 'control'"
    },
    {
      "id": "seq:gw-workorder",
      "source": "gw:control",
      "target": "task:work-order",
      "name": "정비 요청만",
      "condition": "chosen_skill_kind == 'work_order'"
    },
    {
      "id": "seq:gw-purchase",
      "source": "gw:control",
      "target": "task:report-purchase-only",
      "name": "발주만",
      "condition": "chosen_skill_kind == 'purchase'"
    },
    {
      "id": "seq:gw-other",
      "source": "gw:control",
      "target": "task:report-no-action",
      "name": "그 밖",
      "properties": {
        "default": true
      }
    },
    {
      "id": "seq:command-reobserve",
      "source": "task:command",
      "target": "task:reobserve"
    },
    {
      "id": "seq:reobserve-gw",
      "source": "task:reobserve",
      "target": "gw:recovered"
    },
    {
      "id": "seq:gw-recovered-wo",
      "source": "gw:recovered",
      "target": "task:work-order",
      "name": "회복",
      "condition": "recovered == True"
    },
    {
      "id": "seq:gw-recovered-escalate",
      "source": "gw:recovered",
      "target": "task:escalate",
      "name": "미회복",
      "condition": "recovered != True"
    },
    {
      "id": "seq:workorder-closed",
      "source": "task:work-order",
      "target": "ev:closed"
    },
    {
      "id": "seq:timeout-escalate",
      "source": "ev:select-timeout",
      "target": "task:escalate"
    },
    {
      "id": "seq:escalate-end",
      "source": "task:escalate",
      "target": "ev:escalated"
    },
    {
      "id": "seq:rejected-end",
      "source": "task:report-rejected",
      "target": "ev:rejected"
    },
    {
      "id": "seq:purchase-end",
      "source": "task:report-purchase-only",
      "target": "ev:not-executed"
    },
    {
      "id": "seq:other-end",
      "source": "task:report-no-action",
      "target": "ev:not-executed"
    }
  ],
