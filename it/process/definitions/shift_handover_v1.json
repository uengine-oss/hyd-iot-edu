  ],
  "events": [
    {
      "id": "ev:start",
      "type": "startEvent",
      "name": "인계 요청"
    },
    {
      "id": "ev:confirmed",
      "type": "endEvent",
      "name": "인수 확인 기록 완료"
    },
    {
      "id": "ev:rejected",
      "type": "endEvent",
      "name": "인계 거절 기록"
    },
    {
      "id": "ev:followup",
      "type": "endEvent",
      "name": "후속 확인 필요 · 인수 미확정"
    }
  ],
  "gateways": [
    {
      "id": "gw:sender",
      "type": "exclusiveGateway",
      "name": "검토 결정",
      "conditionData": [
        "sender_decision"
      ]
    },
    {
      "id": "gw:receiver",
      "type": "exclusiveGateway",
      "name": "검토 결정",
      "conditionData": [
        "receiver_decision"
      ]
    },
    {
      "id": "gw:sender-r2",
      "type": "exclusiveGateway",
      "name": "검토 결정",
      "conditionData": [
        "sender_decision"
      ]
    },
    {
      "id": "gw:receiver-r2",
      "type": "exclusiveGateway",
      "name": "검토 결정",
      "conditionData": [
        "receiver_decision"
      ]
    },
    {
      "id": "gw:sender-r3",
      "type": "exclusiveGateway",
      "name": "검토 결정",
      "conditionData": [
        "sender_decision"
      ]
    },
    {
      "id": "gw:receiver-r3",
      "type": "exclusiveGateway",
      "name": "검토 결정",
      "conditionData": [
        "receiver_decision"
      ]
    }
  ],
  "sequences": [
    {
      "id": "seq:0",
      "source": "ev:start",
      "target": "task:draft"
    },
    {
      "id": "seq:1",
      "source": "task:draft",
      "target": "task:sender"
    },
    {
      "id": "seq:2",
      "source": "task:sender",
      "target": "gw:sender"
    },
    {
      "id": "seq:3",
      "source": "gw:sender",
      "target": "task:receiver",
      "condition": "sender_decision == 'approve'"
    },
    {
      "id": "seq:4",
      "source": "gw:sender",
      "target": "task:draft-r2",
      "condition": "sender_decision == 'revise'"
    },
    {
      "id": "seq:5",
      "source": "gw:sender",
      "target": "ev:rejected",
      "condition": "sender_decision == 'reject'"
    },
    {
      "id": "seq:6",
      "source": "task:receiver",
      "target": "gw:receiver"
    },
    {
      "id": "seq:7",
      "source": "gw:receiver",
      "target": "ev:confirmed",
      "condition": "receiver_decision == 'confirm'"
    },
    {
      "id": "seq:8",
      "source": "gw:receiver",
      "target": "task:draft-r2",
      "condition": "receiver_decision == 'revise'"
    },
    {
      "id": "seq:9",
      "source": "task:draft-r2",
      "target": "task:sender-r2"
    },
    {
