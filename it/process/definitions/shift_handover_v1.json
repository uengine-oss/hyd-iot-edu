  "forms": {
    "handover_draft": {
      "contract": "shift-handover-draft-v1",
      "fields_json": [
        {
          "key": "handover_summary",
          "type": "textarea",
          "text": "인계안 요약"
        },
        {
          "key": "checks",
          "type": "array",
          "text": "설비·작업지시·부품·메모 대조 결과"
        },
        {
          "key": "evidence",
          "type": "array",
          "text": "실제로 실행한 도구·인자·조회 결과"
        }
      ]
    },
    "handover_sender": {
      "contract": "shift-handover-sender-v1",
      "fields_json": [
        {
          "key": "sender_decision",
          "type": "select",
          "text": "인계자 검토",
          "items": [
            {
              "approve": "인수자에게 전달"
            },
            {
              "revise": "보완 요청"
            },
            {
              "reject": "인계 거절"
            }
          ]
        },
        {
          "key": "sender_notes",
          "type": "textarea",
          "text": "확인 사항 또는 보완·거절 사유"
        }
      ]
    },
    "handover_receiver": {
      "contract": "shift-handover-receiver-v1",
      "fields_json": [
        {
          "key": "receiver_decision",
          "type": "select",
          "text": "인수자 확인",
          "items": [
            {
              "confirm": "확인 완료"
            },
            {
              "revise": "보완 요청"
            }
          ]
        },
        {
          "key": "receiver_notes",
          "type": "textarea",
          "text": "인수 확인 사항 또는 보완 사유"
        },
        {
          "key": "communication_only",
          "type": "boolean",
          "text": "설비 조치·발주·정비 완료가 아닌 인계 확인입니다"
        }
      ]
    }
  }
}
