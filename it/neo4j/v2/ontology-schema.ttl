hyd:forecastRevision a owl:DatatypeProperty ;
  rdfs:label "forecastRevision" ;
  rdfs:domain hyd:Asset ;
  rdfs:range xsd:string ;
  rdfs:comment "적용 모델 판본"@ko .
hyd:forecastScope a owl:DatatypeProperty ;
  rdfs:label "forecastScope" ;
  rdfs:domain hyd:Asset ;
  rdfs:range xsd:string ;
  rdfs:comment "모델 적용 범위; 시뮬레이터와 현장 모델을 구분"@ko .
hyd:formula a owl:DatatypeProperty ;
  rdfs:label "formula" ;
  rdfs:domain hyd:Measure ;
  rdfs:range xsd:string ;
  rdfs:comment "다른 KPI로 계산되면 식. 예: kpi:revenue - kpi:cost"@ko .
hyd:frequency a owl:DatatypeProperty ;
  rdfs:label "frequency" ;
  rdfs:domain hyd:Measure ;
  rdfs:range xsd:string ;
  rdfs:comment "측정 주기. 예: 일, 월, 실시간"@ko .
hyd:gatewayType a owl:DatatypeProperty ;
  rdfs:label "gatewayType" ;
  rdfs:domain hyd:Gateway ;
  rdfs:range xsd:string ;
  rdfs:comment " A100: parallel(병렬 분기·합류) 지원. 허용값: exclusive, parallel"@ko .
hyd:generation a owl:DatatypeProperty ;
  rdfs:label "generation" ;
  rdfs:domain hyd:WorkItem ;
  rdfs:range xsd:integer ;
  rdfs:comment "이 작업이 속한 재작업 세대"@ko .
hyd:head a owl:DatatypeProperty ;
  rdfs:label "head" ;
  rdfs:domain hyd:ManualIngestionDocument ;
  rdfs:range xsd:string .
hyd:hitPolicy a owl:DatatypeProperty ;
  rdfs:label "hitPolicy" ;
  rdfs:domain hyd:DecisionTable ;
  rdfs:range xsd:string ;
  rdfs:comment "허용값: PRIORITY, COLLECT, UNIQUE"@ko .
hyd:holdSeconds a owl:DatatypeProperty ;
  rdfs:label "holdSeconds" ;
  rdfs:domain hyd:AnomalyPattern ;
  rdfs:range xsd:decimal .
hyd:horizon a owl:DatatypeProperty ;
  rdfs:label "horizon" ;
  rdfs:domain hyd:Forecast ;
  rdfs:range xsd:string ;
  rdfs:comment "예: steady-state, PT15M"@ko .
hyd:id a owl:DatatypeProperty ;
  rdfs:label "id" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Perspective hyd:Objective hyd:Measure hyd:Process hyd:FlowNode hyd:OrgUnit hyd:Role hyd:System hyd:Asset hyd:Component hyd:Sensor hyd:Actuator hyd:StateVariable hyd:Part hyd:Supplier hyd:AnomalyPattern hyd:Symptom hyd:FailureMode hyd:Cause hyd:Evidence hyd:Step hyd:ManualSection hyd:Skill hyd:Action hyd:Decision hyd:InputData hyd:DecisionTable hyd:Rule hyd:KnowledgeSource hyd:ExternalVariable hyd:Forecast hyd:Incident hyd:DecisionCase hyd:IngestionControl hyd:IngestionBatch hyd:ProcessInstance hyd:WorkItem hyd:ProcessVersion hyd:ExecutionProjection hyd:CaseProjection hyd:KnowledgeEdit hyd:ManualIngestionDocument hyd:ManualIngestionBatch ) ] ;
  rdfs:range xsd:string .
hyd:ingest_batch a owl:DatatypeProperty ;
  rdfs:label "ingest_batch" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:System hyd:InputData ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "구버전 적재 소유자. 복원 이력 없는 자동 삭제는 거부한다"@ko .
hyd:ingested_at a owl:DatatypeProperty ;
  rdfs:label "ingested_at" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "현재 활성 적재 시각"@ko .
hyd:isExecutable a owl:DatatypeProperty ;
  rdfs:label "isExecutable" ;
  rdfs:domain hyd:Process ;
  rdfs:range xsd:boolean .
hyd:kind a owl:DatatypeProperty ;
  rdfs:label "kind" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:StateVariable hyd:Skill hyd:Action hyd:KnowledgeSource hyd:KnowledgeEdit ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "허용값: manipulated, controlled, disturbance"@ko .
hyd:kpiRole a owl:DatatypeProperty ;
  rdfs:label "kpiRole" ;
  rdfs:domain hyd:Measure ;
  rdfs:range xsd:string ;
  rdfs:comment "BSC 지표 역할. lagging=후행 결과 지표(재무·고객 성과, 전략맵의 끝), leading=선행 동인 지표(내부 프로세스·학습의 동인; INFLUENCES 경로로 후행 지표를 움직인다). 후행 지표는 선행 지표에 INFLUENCES하지 않고, 선행 지표는 후행 지표에 닿아야 한다 허용값: leading, lagging"@ko .
hyd:level a owl:DatatypeProperty ;
  rdfs:label "level" ;
  rdfs:domain hyd:Role ;
  rdfs:range xsd:integer .
hyd:limit a owl:DatatypeProperty ;
  rdfs:label "limit" ;
  rdfs:domain hyd:StateVariable ;
  rdfs:range xsd:decimal ;
  rdfs:comment "인터록 한계"@ko .
hyd:lock a owl:DatatypeProperty ;
  rdfs:label "lock" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:ExecutionProjection hyd:CaseProjection ) ] ;
  rdfs:range xsd:integer .
hyd:max a owl:DatatypeProperty ;
  rdfs:label "max" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Actuator hyd:Action ) ] ;
  rdfs:range xsd:decimal .
hyd:messageRef a owl:DatatypeProperty ;
  rdfs:label "messageRef" ;
  rdfs:domain hyd:Event ;
  rdfs:range xsd:string ;
  rdfs:comment "message 이벤트가 받는 메시지(토픽) 이름"@ko .
hyd:method a owl:DatatypeProperty ;
  rdfs:label "method" ;
  rdfs:domain hyd:Forecast ;
  rdfs:range xsd:string .
hyd:min a owl:DatatypeProperty ;
  rdfs:label "min" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Actuator hyd:Action ) ] ;
  rdfs:range xsd:decimal .
hyd:name a owl:DatatypeProperty ;
  rdfs:label "name" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Perspective hyd:Objective hyd:Measure hyd:Process hyd:FlowNode hyd:OrgUnit hyd:Role hyd:System hyd:Asset hyd:Component hyd:Sensor hyd:Actuator hyd:StateVariable hyd:Part hyd:Supplier hyd:AnomalyPattern hyd:Symptom hyd:FailureMode hyd:Cause hyd:Evidence hyd:Skill hyd:Action hyd:Decision hyd:InputData hyd:DecisionTable hyd:KnowledgeSource hyd:ExternalVariable hyd:IngestionControl hyd:IngestionBatch hyd:ProcessInstance hyd:ProcessVersion ) ] ;
  rdfs:range xsd:string .
hyd:normal a owl:DatatypeProperty ;
  rdfs:label "normal" ;
  rdfs:domain hyd:StateVariable ;
  rdfs:range xsd:decimal ;
  rdfs:comment "정상 운전점"@ko .
hyd:note a owl:DatatypeProperty ;
  rdfs:label "note" ;
  rdfs:domain hyd:Symptom ;
  rdfs:range xsd:string ;
  rdfs:comment "관측 방법 설명(실시간 센서가 없을 때 사람 입력 등). A098"@ko .
hyd:ontology_ref a owl:DatatypeProperty ;
  rdfs:label "ontology_ref" ;
  rdfs:domain hyd:ProcessVersion ;
  rdfs:range xsd:string .
hyd:openedAt a owl:DatatypeProperty ;
  rdfs:label "openedAt" ;
  rdfs:domain hyd:Incident ;
  rdfs:range xsd:dateTime .
hyd:orchestration a owl:DatatypeProperty ;
  rdfs:label "orchestration" ;
  rdfs:domain hyd:Task ;
  rdfs:range xsd:string ;
  rdfs:comment "에이전트 작업의 실행기(HYD는 cliagents)"@ko .
hyd:order a owl:DatatypeProperty ;
  rdfs:label "order" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Perspective hyd:Step hyd:Rule ) ] ;
  rdfs:range xsd:integer ;
  rdfs:comment "전략맵에서 아래(학습)부터 위(재무)까지의 순서. 학습=1 … 재무=4"@ko .
hyd:param a owl:DatatypeProperty ;
  rdfs:label "param" ;
  rdfs:domain hyd:Action ;
  rdfs:range xsd:string .
hyd:partNo a owl:DatatypeProperty ;
  rdfs:label "partNo" ;
  rdfs:domain hyd:Part ;
  rdfs:range xsd:string .
hyd:payload_hash a owl:DatatypeProperty ;
  rdfs:label "payload_hash" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:ExecutionProjection hyd:CaseProjection ) ] ;
  rdfs:range xsd:string .
hyd:penalty a owl:DatatypeProperty ;
  rdfs:label "penalty" ;
  rdfs:domain hyd:Rule ;
  rdfs:range xsd:decimal ;
  rdfs:comment "PENALTY일 때 감점액 (만원)"@ko .
hyd:plan a owl:DatatypeProperty ;
  rdfs:label "plan" ;
  rdfs:domain hyd:ManualIngestionBatch ;
  rdfs:range xsd:string .
hyd:position a owl:DatatypeProperty ;
  rdfs:label "position" ;
  rdfs:domain hyd:Event ;
  rdfs:range xsd:string ;
  rdfs:comment "허용값: start, boundary, end"@ko .
hyd:previous a owl:DatatypeProperty ;
  rdfs:label "previous" ;
  rdfs:domain hyd:ManualIngestionBatch ;
  rdfs:range xsd:string .
hyd:prior a owl:DatatypeProperty ;
  rdfs:label "prior" ;
  rdfs:domain hyd:Cause ;
  rdfs:range xsd:decimal .
hyd:projection_revision a owl:DatatypeProperty ;
  rdfs:label "projection_revision" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Incident hyd:DecisionCase hyd:ProcessInstance ) ] ;
  rdfs:range xsd:integer ;
  rdfs:comment "이 노드를 쓴 원천 투영 판본 (case_projection)"@ko .
hyd:projection_warnings a owl:DatatypeProperty ;
  rdfs:label "projection_warnings" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Incident hyd:DecisionCase hyd:ProcessInstance hyd:ProcessVersion ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "투영 중 찾지 못한 참조(설비·패턴·원인)"@ko .
hyd:question a owl:DatatypeProperty ;
  rdfs:label "question" ;
  rdfs:domain hyd:Decision ;
  rdfs:range xsd:string .
hyd:rankingPolicy a owl:DatatypeProperty ;
  rdfs:label "rankingPolicy" ;
  rdfs:domain hyd:Rule ;
  rdfs:range xsd:string ;
  rdfs:comment "RANK 실행 계약 v1 JSON: 명시 입력과 제한된 산술식 성분. annotation은 설명이며 실행하지 않는다."@ko .
hyd:reason a owl:DatatypeProperty ;
  rdfs:label "reason" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Incident hyd:DecisionCase hyd:KnowledgeEdit ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "종결·에스컬레이션 사유"@ko .
hyd:receipt a owl:DatatypeProperty ;
  rdfs:label "receipt" ;
  rdfs:domain hyd:ManualIngestionBatch ;
  rdfs:range xsd:string .
hyd:ref a owl:DatatypeProperty ;
  rdfs:label "ref" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:ManualSection hyd:KnowledgeSource ) ] ;
  rdfs:range xsd:string .
hyd:resource a owl:DatatypeProperty ;
  rdfs:label "resource" ;
  rdfs:domain hyd:Actuator ;
  rdfs:range xsd:string ;
  rdfs:comment "PLC 쓰기 자원. 예: FanSpeedSP"@ko .
hyd:result a owl:DatatypeProperty ;
  rdfs:label "result" ;
  rdfs:domain hyd:KnowledgeEdit ;
  rdfs:range xsd:string ;
  rdfs:comment "편집 결과(JSON 문자열)"@ko .
hyd:retry a owl:DatatypeProperty ;
  rdfs:label "retry" ;
  rdfs:domain hyd:WorkItem ;
  rdfs:range xsd:integer .
hyd:revision a owl:DatatypeProperty ;
  rdfs:label "revision" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:ExecutionProjection hyd:CaseProjection ) ] ;
  rdfs:range xsd:integer .
hyd:rework_count a owl:DatatypeProperty ;
  rdfs:label "rework_count" ;
  rdfs:domain hyd:WorkItem ;
  rdfs:range xsd:integer .
hyd:rework_generation a owl:DatatypeProperty ;
  rdfs:label "rework_generation" ;
  rdfs:domain hyd:ProcessInstance ;
  rdfs:range xsd:integer ;
  rdfs:comment "재작업 세대 (0 = 최초 실행)"@ko .
hyd:rework_request_id a owl:DatatypeProperty ;
  rdfs:label "rework_request_id" ;
  rdfs:domain hyd:WorkItem ;
  rdfs:range xsd:string ;
  rdfs:comment "이 작업을 만든 재작업 요청 id"@ko .
hyd:rolledBackAt a owl:DatatypeProperty ;
  rdfs:label "rolledBackAt" ;
  rdfs:domain hyd:ManualIngestionBatch ;
  rdfs:range xsd:string .
hyd:rolledBackBy a owl:DatatypeProperty ;
  rdfs:label "rolledBackBy" ;
  rdfs:domain hyd:ManualIngestionBatch ;
  rdfs:range xsd:string .
hyd:rule a owl:DatatypeProperty ;
  rdfs:label "rule" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:AnomalyPattern hyd:Evidence hyd:KnowledgeEdit ) ] ;
  rdfs:range xsd:string .
hyd:schema a owl:DatatypeProperty ;
  rdfs:label "schema" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "대소문자를 보존한 원천 스키마"@ko .
hyd:seeded a owl:DatatypeProperty ;
  rdfs:label "seeded" ;
  rdfs:domain hyd:DecisionCase ;
  rdfs:range xsd:boolean ;
  rdfs:comment "미리 넣은 예시 사례(그래프 시드 instances.cypher)면 true. 선례 조회(t3_precedents)는 이것만 센다 — 교육용 고정, DECISIONS 110 ④. 승인으로 투영된 사례(case_projection)에는 없다"@ko .
hyd:semantic_id a owl:DatatypeProperty ;
  rdfs:label "semantic_id" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Event hyd:Task hyd:Gateway ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "실행 정의 노드가 대응하는 온톨로지 흐름 노드 id"@ko .
hyd:semantic_warning a owl:DatatypeProperty ;
  rdfs:label "semantic_warning" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Event hyd:Task hyd:Gateway ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "대응 실패 사유 (없으면 null)"@ko .
hyd:sequence a owl:DatatypeProperty ;
  rdfs:label "sequence" ;
  rdfs:domain hyd:IngestionControl ;
  rdfs:range xsd:integer .
hyd:severity a owl:DatatypeProperty ;
  rdfs:label "severity" ;
  rdfs:domain hyd:AnomalyPattern ;
  rdfs:range xsd:string ;
  rdfs:comment "허용값: LOW, MEDIUM, HIGH, CRITICAL"@ko .
hyd:sha256 a owl:DatatypeProperty ;
  rdfs:label "sha256" ;
  rdfs:domain hyd:KnowledgeSource ;
  rdfs:range xsd:string ;
  rdfs:comment "A098 선언"@ko .
hyd:skill a owl:DatatypeProperty ;
  rdfs:label "skill" ;
  rdfs:domain hyd:KnowledgeEdit ;
  rdfs:range xsd:string .
hyd:slopeWindowSeconds a owl:DatatypeProperty ;
  rdfs:label "slopeWindowSeconds" ;
  rdfs:domain hyd:AnomalyPattern ;
  rdfs:range xsd:decimal ;
  rdfs:comment "경사 계산 창(시뮬레이션 초), 수집 해상도와 함께 검증"@ko .
hyd:snapshot a owl:DatatypeProperty ;
  rdfs:label "snapshot" ;
  rdfs:domain hyd:ManualIngestionDocument ;
  rdfs:range xsd:string ;
  rdfs:comment "이 문서가 소유한 노드·관계 스냅샷(JSON 문자열)"@ko .
hyd:sopId a owl:DatatypeProperty ;
  rdfs:label "sopId" ;
  rdfs:domain hyd:Skill ;
  rdfs:range xsd:string ;
  rdfs:comment "SOP 번호. 예: SOP-COOL-02"@ko .
hyd:source a owl:DatatypeProperty ;
  rdfs:label "source" ;
  rdfs:domain hyd:ExternalVariable ;
  rdfs:range xsd:string .
hyd:sourceAlert a owl:DatatypeProperty ;
  rdfs:label "sourceAlert" ;
  rdfs:domain hyd:Incident ;
  rdfs:range xsd:string ;
  rdfs:comment "사건을 연 원천 경보 원문(JSON 문자열)"@ko .
hyd:sourceBaseComment a owl:DatatypeProperty ;
  rdfs:label "sourceBaseComment" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "적재 뒤 첫 DDL 동기화가 본 실제 열 주석(A115, 없으면 빈 문자열). 이후 실제 주석이 이 값과 다르면 COMMENT_CHANGED. 재적재하면 지워진다"@ko .
hyd:sourceCheckedAt a owl:DatatypeProperty ;
  rdfs:label "sourceCheckedAt" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "바인딩 상태가 마지막으로 바뀐 시각"@ko .
hyd:sourceLiveComment a owl:DatatypeProperty ;
  rdfs:label "sourceLiveComment" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "원천 카탈로그의 현재 열 주석(A115, 없으면 null)"@ko .
hyd:sourceLiveType a owl:DatatypeProperty ;
  rdfs:label "sourceLiveType" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "원천 카탈로그의 현재 열 타입(없으면 null)"@ko .
hyd:sourcePattern a owl:DatatypeProperty ;
  rdfs:label "sourcePattern" ;
  rdfs:domain hyd:Incident ;
  rdfs:range xsd:string ;
  rdfs:comment "사건을 연 경보 패턴 코드"@ko .
hyd:sourceState a owl:DatatypeProperty ;
  rdfs:label "sourceState" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "DDL 동기화(A087·A115)가 확인한 바인딩 상태. MISSING·TYPE_CHANGED·COMMENT_CHANGED(적재 뒤 실제 열 주석 = 업무 의미가 바뀜)이면 에이전트는 읽지 않고 미확인으로 둔다 허용값: OK, MISSING, TYPE_CHANGED, COMMENT_CHANGED"@ko .
hyd:sourceTrip a owl:DatatypeProperty ;
  rdfs:label "sourceTrip" ;
  rdfs:domain hyd:Incident ;
  rdfs:range xsd:string ;
  rdfs:comment "트립 경보의 PLC 트립 사유"@ko .
hyd:source_id a owl:DatatypeProperty ;
  rdfs:label "source_id" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:System hyd:Step hyd:ManualSection hyd:Skill hyd:InputData hyd:KnowledgeSource ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "인제스천 원본 문서 내 위치"@ko .
hyd:source_incident_id a owl:DatatypeProperty ;
  rdfs:label "source_incident_id" ;
  rdfs:domain hyd:DecisionCase ;
  rdfs:range xsd:string ;
  rdfs:comment "이 판단이 속한 사건 id"@ko .
hyd:source_type a owl:DatatypeProperty ;
  rdfs:label "source_type" ;
  rdfs:domain hyd:FlowNode ;
  rdfs:range xsd:string .
hyd:sql a owl:DatatypeProperty ;
  rdfs:label "sql" ;
  rdfs:domain hyd:Evidence ;
  rdfs:range xsd:string ;
  rdfs:comment "시계열 DB 검증 질의. %(asset)s 매개변수 하나, 숫자 열 하나(value)를 돌려준다"@ko .
hyd:sqlType a owl:DatatypeProperty ;
  rdfs:label "sqlType" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "원천 SQL 형식"@ko .
hyd:start_date a owl:DatatypeProperty ;
  rdfs:label "start_date" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:ProcessInstance hyd:WorkItem ) ] ;
  rdfs:range xsd:dateTime .
hyd:status a owl:DatatypeProperty ;
  rdfs:label "status" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Incident hyd:DecisionCase hyd:IngestionBatch hyd:ProcessInstance hyd:WorkItem hyd:ManualIngestionBatch ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "사건 상태기계의 현재 상태 (procsvc/machine.py) 허용값: AWAITING_APPROVAL, CMD_ISSUED, AWAITING_ACK, ACKED, RE_OBSERVING, RESOLVED, WORK_ORDER_CREATED, CLOSED, ESCALATED, REJECTED_BY_OPERATOR, RESOLVED_WITHOUT_ACTION"@ko .
hyd:supersedes_id a owl:DatatypeProperty ;
  rdfs:label "supersedes_id" ;
  rdfs:domain hyd:WorkItem ;
  rdfs:range xsd:string ;
  rdfs:comment "재작업으로 대체한 이전 세대 작업 id"@ko .
hyd:table a owl:DatatypeProperty ;
  rdfs:label "table" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "대소문자를 보존한 원천 테이블"@ko .
hyd:tag a owl:DatatypeProperty ;
  rdfs:label "tag" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Sensor hyd:Evidence ) ] ;
  rdfs:range xsd:string .
hyd:target a owl:DatatypeProperty ;
  rdfs:label "target" ;
  rdfs:domain hyd:Measure ;
  rdfs:range xsd:decimal .
hyd:taskType a owl:DatatypeProperty ;
  rdfs:label "taskType" ;
  rdfs:domain hyd:Task ;
  rdfs:range xsd:string ;
  rdfs:comment "허용값: user, service, businessRule, manual, script, send, receive, subProcess, callActivity"@ko .
hyd:tenant a owl:DatatypeProperty ;
  rdfs:label "tenant" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:ManualIngestionDocument hyd:ManualIngestionBatch ) ] ;
  rdfs:range xsd:string .
hyd:tenant_id a owl:DatatypeProperty ;
  rdfs:label "tenant_id" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:FlowNode hyd:ProcessInstance hyd:WorkItem hyd:ProcessVersion hyd:ExecutionProjection ) ] ;
  rdfs:range xsd:string .
hyd:text a owl:DatatypeProperty ;
  rdfs:label "text" ;
  rdfs:domain hyd:Step ;
  rdfs:range xsd:string .
hyd:threshold a owl:DatatypeProperty ;
  rdfs:label "threshold" ;
  rdfs:domain hyd:Evidence ;
  rdfs:range xsd:decimal .
hyd:thresholdCrit a owl:DatatypeProperty ;
  rdfs:label "thresholdCrit" ;
  rdfs:domain hyd:Measure ;
  rdfs:range xsd:decimal .
hyd:thresholdWarn a owl:DatatypeProperty ;
  rdfs:label "thresholdWarn" ;
  rdfs:domain hyd:Measure ;
  rdfs:range xsd:decimal .
hyd:timer a owl:DatatypeProperty ;
  rdfs:label "timer" ;
  rdfs:domain hyd:Event ;
  rdfs:range xsd:string ;
  rdfs:comment "timer 이벤트의 ISO 8601 기간. 예: PT10M"@ko .
hyd:title a owl:DatatypeProperty ;
  rdfs:label "title" ;
  rdfs:domain hyd:ManualSection ;
  rdfs:range xsd:string .
hyd:tool a owl:DatatypeProperty ;
  rdfs:label "tool" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Task hyd:WorkItem ) ] ;
  rdfs:range xsd:string .
hyd:typeRef a owl:DatatypeProperty ;
  rdfs:label "typeRef" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string .
hyd:unit a owl:DatatypeProperty ;
  rdfs:label "unit" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Measure hyd:Sensor hyd:StateVariable hyd:ExternalVariable hyd:Forecast ) ] ;
  rdfs:range xsd:string .
hyd:value a owl:DatatypeProperty ;
  rdfs:label "value" ;
  rdfs:domain hyd:Forecast ;
  rdfs:range xsd:decimal .
hyd:variable a owl:DatatypeProperty ;
  rdfs:label "variable" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "규칙식에서 쓰는 변수 이름"@ko .
hyd:version a owl:DatatypeProperty ;
  rdfs:label "version" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:FlowNode hyd:ProcessInstance hyd:WorkItem hyd:ProcessVersion ) ] ;
  rdfs:range xsd:string .
hyd:virtual a owl:DatatypeProperty ;
  rdfs:label "virtual" ;
  rdfs:domain hyd:Sensor ;
  rdfs:range xsd:boolean ;
  rdfs:comment "계산으로 만든 가상 센서면 true"@ko .
hyd:weight a owl:DatatypeProperty ;
  rdfs:label "weight" ;
  rdfs:domain hyd:Evidence ;
  rdfs:range xsd:decimal .
hyd:when a owl:DatatypeProperty ;
  rdfs:label "when" ;
  rdfs:domain hyd:Rule ;
  rdfs:range xsd:string ;
  rdfs:comment "사람이 읽는 조건. TESTS 관계와 같은 내용이어야 한다 (검사기가 확인)"@ko .
hyd:windowSeconds a owl:DatatypeProperty ;
  rdfs:label "windowSeconds" ;
  rdfs:domain hyd:Evidence ;
  rdfs:range xsd:decimal ;
  rdfs:comment "sql이 집계하는 최근 구간(초)"@ko .
hyd:work_order_ref a owl:DatatypeProperty ;
  rdfs:label "work_order_ref" ;
  rdfs:domain hyd:Incident ;
  rdfs:range xsd:string ;
  rdfs:comment "CMMS 작업지시 영수증(JSON 문자열)"@ko .
hyd:zone a owl:DatatypeProperty ;
  rdfs:label "zone" ;
  rdfs:domain hyd:System ;
  rdfs:range xsd:string ;
  rdfs:comment "허용값: IT, OT"@ko .
