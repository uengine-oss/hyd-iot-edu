  rdfs:range xsd:string .
hyd:closedAt a owl:DatatypeProperty ;
  rdfs:label "closedAt" ;
  rdfs:domain hyd:Incident ;
  rdfs:range xsd:dateTime ;
  rdfs:comment "종결 시각"@ko .
hyd:code a owl:DatatypeProperty ;
  rdfs:label "code" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Asset hyd:AnomalyPattern hyd:Action ) ] ;
  rdfs:range xsd:string ;
  rdfs:comment "운영 데이터(경보 · 태그 · 인시던트)가 쓰는 설비 코드. 예: HYD-01"@ko .
hyd:column a owl:DatatypeProperty ;
  rdfs:label "column" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "대소문자를 보존한 원천 열"@ko .
hyd:command_id a owl:DatatypeProperty ;
  rdfs:label "command_id" ;
  rdfs:domain hyd:Incident ;
