  rdfs:range xsd:dateTime .
hyd:definition_id a owl:DatatypeProperty ;
  rdfs:label "definition_id" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:FlowNode hyd:ProcessInstance hyd:WorkItem hyd:ProcessVersion ) ] ;
  rdfs:range xsd:string .
hyd:derive a owl:DatatypeProperty ;
  rdfs:label "derive" ;
  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "시각 열(timestamptz)을 판단에 넣는 방식. hours_from_now = (값 − 지금)/3600, 미래 양수·과거 음수. 승인 재검증은 환산값이 아니라 원래 시각을 비교한다(A086) 허용값: hours_from_now"@ko .
hyd:description a owl:DatatypeProperty ;
  rdfs:label "description" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Objective hyd:Skill ) ] ;
  rdfs:range xsd:string .
hyd:detectionMode a owl:DatatypeProperty ;
  rdfs:label "detectionMode" ;
  rdfs:domain hyd:AnomalyPattern ;
  rdfs:range xsd:string ;
  rdfs:comment "held는 TESTS 기반 지속조건, plc-trip은 PLC 원천 트립 감시 허용값: held, plc-trip"@ko .
hyd:detectorScope a owl:DatatypeProperty ;
