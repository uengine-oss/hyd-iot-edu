  rdfs:domain hyd:InputData ;
  rdfs:range xsd:string ;
  rdfs:comment "물리 원천 연결 이름"@ko .
hyd:decidedAt a owl:DatatypeProperty ;
  rdfs:label "decidedAt" ;
