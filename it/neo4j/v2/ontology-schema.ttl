hyd:cleared a owl:DatatypeProperty ;
  rdfs:label "cleared" ;
  rdfs:domain hyd:Incident ;
  rdfs:range xsd:boolean ;
  rdfs:comment "원천 경보가 해제됐는가"@ko .
hyd:clearedAt a owl:DatatypeProperty ;
  rdfs:label "clearedAt" ;
