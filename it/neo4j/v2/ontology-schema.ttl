hyd:agent_mode a owl:DatatypeProperty ;
  rdfs:label "agent_mode" ;
  rdfs:domain hyd:WorkItem ;
  rdfs:range xsd:string .
hyd:agent_orch a owl:DatatypeProperty ;
  rdfs:label "agent_orch" ;
  rdfs:domain hyd:WorkItem ;
  rdfs:range xsd:string .
hyd:alertId a owl:DatatypeProperty ;
  rdfs:label "alertId" ;
  rdfs:domain hyd:Incident ;
  rdfs:range xsd:string .
hyd:aliases a owl:DatatypeProperty ;
  rdfs:label "aliases" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( hyd:Measure hyd:Component hyd:StateVariable hyd:Symptom hyd:Cause hyd:ExternalVariable ) ] ;
  rdfs:range xsd:string .
hyd:annotation a owl:DatatypeProperty ;
  rdfs:label "annotation" ;
  rdfs:domain hyd:Rule ;
  rdfs:range xsd:string .
hyd:assetColumn a owl:DatatypeProperty ;
