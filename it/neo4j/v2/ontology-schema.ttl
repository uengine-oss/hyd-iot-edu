hyd:activity_id a owl:DatatypeProperty ;
  rdfs:label "activity_id" ;
  rdfs:domain hyd:WorkItem ;
  rdfs:range xsd:string .
hyd:activity_name a owl:DatatypeProperty ;
  rdfs:label "activity_name" ;
  rdfs:domain hyd:WorkItem ;
  rdfs:range xsd:string .
hyd:actor a owl:DatatypeProperty ;
  rdfs:label "actor" ;
  rdfs:domain hyd:KnowledgeEdit ;
  rdfs:range xsd:string .
hyd:after a owl:DatatypeProperty ;
