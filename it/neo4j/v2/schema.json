{
  "name": "hyd-iot-edu ontology",
  "version": "2.3.0",
  "namespace": "https://uengine-oss.github.io/hyd-iot-edu/ontology#",
  "description": "유압설비 교육용 온톨로지 스키마. BSC(관점 · 전략 목표 · 성과 지표) → 프로세스 → 리소스 → 스킬·규칙 계층과 외부 변수·예측으로 이루어진다. 클래스와 관계 정의만 담고 인스턴스는 담지 않는다. 표준을 준용한 부분은 각 클래스의 standard에 적었다.",
  "conventions": {
    "id": "모든 노드는 고유한 id를 가진다. 접두사가 클래스를 드러낸다 (kpi:, skill:, rule: …).",
    "name": "모든 노드는 사람이 읽는 한국어 name을 가진다. aliases는 엔티티 인식(entity resolution)용 다른 이름 목록이다.",
    "sign": "INFLUENCES · AFFECTS의 sign은 +1(같은 방향) 또는 -1(반대 방향)이다. 관계가 없으면 관계를 만들지 않는다 (0을 쓰지 않는다). 조건부면 sign을 두고 condition에 조건을 적는다.",
    "money": "금액은 만원 단위다.",
    "superLabel": "extends가 있는 클래스의 노드는 부모 레이블도 함께 단다. 예: (:Task:FlowNode).",
    "minimalSet": "표준의 모든 요소를 담지 않는다. 세 결함 시나리오가 실제로 쓰는 요소만 둔다. scripts/ontology_v2.py validate가 인스턴스가 쓰지 않는 스키마 요소를 보고한다.",
    "threshold": "임계값은 문장이 아니라 관계로 둔다: (규칙 또는 이상 패턴)-[:TESTS {operator, value, unit}]->(입력 데이터). 한 규칙의 TESTS는 모두 AND다 (DMN 결정표의 한 행). OR는 규칙을 두 행으로 나눈다.",
    "label_ko": "모든 클래스는 label_ko(한글 이름)를 가진다. 표와 그림은 이 이름을 쓴다."
  },
  "layers": [
    {
      "id": "value",
      "order": 1,
      "name": "가치 계층 (BSC)",
      "standard": "BSC (Balanced Scorecard) — 관점 · 전략목표 · 성과지표 · 인과관계",
      "description": "회사가 무엇을 얻고 잃는지. BSC 관점 → 전략 목표(조직 목표) → 성과 지표. 성과 지표 사이의 상충 관계(INFLUENCES +/-)가 에이전트의 거시적 판단 근거다."
    },
    {
      "id": "process",
      "order": 2,
      "name": "프로세스 계층",
      "standard": "BPMN 2.0 최소 집합 — Process · Event · Task · Gateway · SequenceFlow · 수행자",
      "description": "KPI를 달성하기 위해 일이 어떤 순서로, 누구에 의해, 어떤 데이터와 판단으로 진행되는지."
    },
    {
      "id": "resource",
      "order": 3,
      "name": "리소스 계층",
      "standard": "조직 · 시스템 · 설비 (ISO 14224 설비 분류 취지) · 상태 변수",
      "description": "실제로 일을 하는 주체와 대상. 사람(역할), 정보 시스템, 설비와 그 물리 상태 변수."
    },
    {
      "id": "diagnosis",
      "order": 3,
      "name": "설비 진단 지식 (리소스 계층의 설비 코어)",
      "standard": "ISO 13374 / MIMOSA OSA-CBM — SD(상태 감지) · HA(건강 평가) · AG(권고)",
      "description": "이상 패턴 → 증상 → 고장 유형 → 원인 → 증거, 그리고 매뉴얼 절. 아키텍처 v4 L7 설계를 따른다. 조치 방법은 스킬 계층의 Skill(= SOP)이 고장 유형에 매칭되어 이어진다."
    },
    {
      "id": "skill",
      "order": 4,
      "name": "스킬 · 규칙 계층",
      "standard": "DMN 1.x 최소 집합 — Decision · InputData · DecisionTable(Rule) · KnowledgeSource",
      "description": "조치 방법(스킬 = SOP)과, 어떤 규칙으로 후보를 고르고 걸러 내는지. 규칙마다 출처(KnowledgeSource)가 있다."
    },
    {
      "id": "external",
      "order": 5,
      "name": "외부 변수 · 예측",
      "standard": "변수 · 예측 프레임워크",
      "description": "회사가 통제하지 못하지만 KPI와 설비 상태에 영향을 주는 변수(환율, 외기온도, 전력단가 …)와 조치별 예측값."
    },
    {
      "id": "record",
      "order": 6,
      "name": "운영 기록",
      "standard": "사례 기록 (DMN 판단의 실행 인스턴스)",
      "description": "실행 중에 쌓이는 사건과 사람의 판단 사례. 다음 판단의 선례로 쓰인다."
    }
  ],
  "classes": [
    {
      "name": "Perspective",
      "label_ko": "BSC 관점",
      "layer": "value",
      "standard": "BSC Perspective",
      "description": "BSC 관점. 재무 · 고객 · 내부 프로세스 · 학습과 성장.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "order",
          "type": "integer",
          "required": true,
          "description": "전략맵에서 아래(학습)부터 위(재무)까지의 순서. 학습=1 … 재무=4"
        }
      ]
    },
    {
      "name": "Objective",
      "label_ko": "전략 목표 (조직 목표)",
      "layer": "value",
      "standard": "BSC Strategic Objective",
      "description": "전략 목표. 한 관점에 속하고, 다른 목표를 받쳐 준다 (전략맵의 인과 화살표).",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "type": "string"
        }
      ]
    },
    {
      "name": "Measure",
      "label_ko": "성과 지표",
      "layer": "value",
      "standard": "BSC Measure (성과 지표)",
      "description": "BSC 성과 지표. 전략 목표를 측정하고(목표값 · 경고 · 위험 임계값), 다른 성과 지표에 +/- 영향을 준다. 상충 관계의 노드다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "aliases",
          "type": "string[]"
        },
        {
          "name": "unit",
          "type": "string",
          "required": true
        },
        {
          "name": "direction",
          "type": "enum",
          "values": [
            "UP",
            "DOWN"
          ],
          "required": true,
          "description": "UP=클수록 좋다, DOWN=작을수록 좋다"
        },
        {
          "name": "formula",
          "type": "string",
          "description": "다른 KPI로 계산되면 식. 예: kpi:revenue - kpi:cost"
        },
        {
          "name": "target",
          "type": "number"
        },
        {
          "name": "thresholdWarn",
          "type": "number"
        },
        {
          "name": "thresholdCrit",
          "type": "number"
        },
        {
          "name": "frequency",
          "type": "string",
          "description": "측정 주기. 예: 일, 월, 실시간"
        }
      ]
    },
    {
      "name": "Process",
      "label_ko": "프로세스",
      "layer": "process",
      "standard": "BPMN Process",
      "description": "업무 프로세스. KPI를 달성하기 위해 존재하고, 대상(ACTS_ON)인 설비에 대해 돈다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "isExecutable",
          "type": "boolean"
        }
      ]
    },
    {
      "name": "FlowNode",
      "label_ko": "흐름 노드 (추상)",
      "layer": "process",
      "standard": "BPMN FlowNode (추상)",
      "abstract": true,
      "description": "프로세스 안의 한 지점. Event · Task · Gateway의 부모.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "Event",
      "label_ko": "이벤트",
      "layer": "process",
      "standard": "BPMN Event",
      "extends": "FlowNode",
      "description": "프로세스를 시작 · 중단 · 종료시키는 사건. 트리거는 클래스가 아니라 이 이벤트의 속성(eventDefinition, messageRef, correlationKey)이고, 어떤 경보가 시작시키는지는 CORRELATES로 잇는다.",
      "properties": [
        {
          "name": "position",
          "type": "enum",
          "values": [
            "start",
            "boundary",
            "end"
          ],
          "required": true
        },
        {
          "name": "eventDefinition",
          "type": "enum",
          "values": [
            "none",
            "message",
            "timer",
            "escalation"
          ],
          "required": true
        },
        {
          "name": "messageRef",
          "type": "string",
          "description": "message 이벤트가 받는 메시지(토픽) 이름"
        },
        {
          "name": "correlationKey",
          "type": "string",
          "description": "메시지를 프로세스 인스턴스에 잇는 키. 예: asset (경보의 설비 = 프로세스의 대상)"
        },
        {
          "name": "timer",
          "type": "string",
          "description": "timer 이벤트의 ISO 8601 기간. 예: PT10M"
        }
      ]
    },
    {
      "name": "Task",
      "label_ko": "작업",
      "layer": "process",
      "standard": "BPMN Task",
      "extends": "FlowNode",
      "description": "일의 단위. 종류에 따라 사람이 하거나(user), 시스템이 하거나(service), 판단 규칙을 부른다(businessRule).",
      "properties": [
        {
          "name": "taskType",
          "type": "enum",
          "values": [
            "user",
            "service",
            "businessRule"
          ],
          "required": true
        }
      ]
    },
    {
      "name": "Gateway",
      "label_ko": "게이트웨이",
      "layer": "process",
      "standard": "BPMN Gateway",
      "extends": "FlowNode",
      "description": "흐름이 갈라지거나 합쳐지는 지점.",
      "properties": [
        {
          "name": "gatewayType",
          "type": "enum",
          "values": [
            "exclusive"
          ],
          "required": true
        }
      ]
    },
    {
      "name": "OrgUnit",
      "label_ko": "조직 (부서)",
      "layer": "resource",
      "standard": "조직 단위",
      "description": "부서. KPI를 소유한다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "Role",
      "label_ko": "역할",
      "layer": "resource",
      "standard": "BPMN Performer / 직무",
      "description": "일을 수행하거나 승인하는 역할. level이 높을수록 승인 권한이 크다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "level",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "name": "System",
      "label_ko": "정보 시스템",
      "layer": "resource",
      "standard": "정보 시스템 (BPMN DataStore 취지)",
      "description": "데이터를 갖고 있거나 스킬을 실행하는 시스템. ERP · MES · CMMS · SCADA · AI 에이전트 등.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "zone",
          "type": "enum",
          "values": [
            "IT",
            "OT"
          ],
          "required": true
        }
      ]
    },
    {
      "name": "Asset",
      "label_ko": "설비",
      "layer": "resource",
      "standard": "ISO 14224 Equipment unit / MIMOSA Asset",
      "description": "설비 한 대. 예: 유압 파워팩 HYD-01.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "code",
          "type": "string",
          "required": true,
          "description": "운영 데이터(경보 · 태그 · 인시던트)가 쓰는 설비 코드. 예: HYD-01"
        }
      ]
    },
    {
      "name": "Component",
      "label_ko": "구성 요소",
      "layer": "resource",
      "standard": "ISO 14224 Maintainable item",
      "description": "설비 구성 요소. 쿨러, 팬, 주 펌프, 예비 펌프, 모터, 탱크.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "aliases",
          "type": "string[]"
        }
      ]
    },
    {
      "name": "Sensor",
      "label_ko": "센서",
      "layer": "resource",
      "standard": "MIMOSA DA (Data Acquisition)",
      "description": "계측 채널. 태그 이름이 실시간 데이터와 연결된다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "tag",
          "type": "string",
          "required": true
        },
        {
          "name": "unit",
          "type": "string"
        },
        {
          "name": "virtual",
          "type": "boolean",
          "description": "계산으로 만든 가상 센서면 true"
        }
      ]
    },
    {
      "name": "Actuator",
      "label_ko": "구동기",
      "layer": "resource",
      "standard": "구동기 (PLC 쓰기 대상)",
      "description": "PLC가 값을 써서 움직이는 장치. 쓰기 자원 이름(resource)이 PLC 명령과 연결된다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "resource",
          "type": "string",
          "required": true,
          "description": "PLC 쓰기 자원. 예: FanSpeedSP"
        },
        {
          "name": "min",
          "type": "number"
        },
        {
          "name": "max",
          "type": "number"
        }
      ]
    },
    {
      "name": "StateVariable",
      "label_ko": "상태 변수",
      "layer": "resource",
      "standard": "공정 상태 변수",
      "description": "설비의 물리량. 조작 변수(팬 속도, 부하)와 결과 변수(유온, 진동, 압력)가 있다. 물리 영향이 KPI로 이어지는 다리다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "aliases",
          "type": "string[]"
        },
        {
          "name": "unit",
          "type": "string",
          "required": true
        },
        {
          "name": "kind",
          "type": "enum",
          "values": [
            "manipulated",
            "controlled",
            "disturbance"
          ],
          "required": true
        },
        {
          "name": "normal",
          "type": "number",
          "description": "정상 운전점"
        },
        {
          "name": "limit",
          "type": "number",
          "description": "인터록 한계"
        }
      ]
    },
    {
      "name": "Part",
      "label_ko": "부품",
      "layer": "resource",
      "standard": "예비품 / 자재",
      "description": "교체 부품.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "partNo",
          "type": "string"
        }
      ]
    },
    {
      "name": "Supplier",
      "label_ko": "공급사",
      "layer": "resource",
      "standard": "공급사",
      "description": "부품 공급사. avl=false면 승인 공급사 목록에 없다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "avl",
          "type": "boolean",
          "required": true
        }
      ]
    },
    {
      "name": "AnomalyPattern",
      "label_ko": "이상 패턴",
      "layer": "diagnosis",
      "standard": "ISO 13374 SD (State Detection)",
      "description": "CEP가 감지하는 이상 패턴. 탐지 임계값은 TESTS로 입력 데이터에 건다. rule은 사람이 읽는 요약이다.",
      "properties": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "code",
          "type": "string",
          "required": true,
          "description": "경보 메시지의 pattern 값. 예: COOLER_DEGRADATION"
        },
        {
          "name": "rule",
          "type": "string",
          "required": true
        },
        {
          "name": "holdSeconds",
          "type": "number"
        }
      ],
      "requiredRelationships": [
        {
          "type": [
            "TESTS"
          ],
          "direction": "out",
          "min": 1,
          "description": "탐지 임계값(TESTS)이 하나 이상 있어야 한다"
        }
      ]
    },
    {
      "name": "Symptom",
      "label_ko": "증상",
