{
  "classes": {
    "Asset": {
      "meaning": "개별 설비(설비코드 기준). 기능위치·실물 일련번호를 속성으로 둔다",
      "required": {
        "id": "string",
        "name": "string",
        "model": "string",
        "status": "string"
      },
      "optional": {
        "maker": "string",
        "serial": "string",
        "functional_location": "string",
        "installed": "string",
        "legacy_codes": "list"
      }
    },
    "Component": {
      "meaning": "설비 안의 정비 가능 품목이 놓인 자리. 기능 자리 기준 ID(설비코드:품목)이고, 그 자리에 달린 실물은 Unit",
      "required": {
        "id": "string",
        "name": "string",
        "group": "string"
      },
      "optional": {
        "aliases": "list"
      }
    },
    "Sensor": {
      "meaning": "설비별 계측 채널. 실측·계산값·설정값을 kind로 구별",
      "required": {
        "id": "string",
        "tag": "string",
        "unit": "string",
        "kind": [
          "measured",
          "derived",
          "setpoint"
        ],
        "derived": "boolean"
      },
      "optional": {
        "normal": "number",
        "limit": "number",
        "limit_direction": [
          "upper",
          "lower"
        ],
        "instrument_tag": "string",
        "sample_hz": "number",
        "collection": "string",
        "source_unit": "string"
      }
    },
    "Quantity": {
      "meaning": "재는 물리량과 기준 단위. 붙은 자리가 다르면 다른 물리량(쿨러 쪽 유온 · 탱크 유온)",
      "required": {
        "id": "string",
        "name": "string",
        "unit": "string"
      }
    },
    "Part": {
      "meaning": "사내 품번 하나로 관리하는 부품 품목",
      "required": {
        "id": "string",
        "name": "string"
      },
      "optional": {
        "other_codes": "list"
      }
    },
    "Unit": {
      "meaning": "일련번호가 붙은 실물 한 대(그 자리에 지금 달린 것 · 전에 달렸다가 철거된 것)",
      "required": {
        "id": "string",
        "serial": "string"
      }
    },
    "Supplier": {
      "meaning": "견적을 낸 공급사",
      "required": {
        "id": "string",
        "name": "string"
      }
    }
  },
  "relations": {
    "HAS_COMPONENT": {
      "from": "Asset",
      "to": "Component",
      "cardinality": "1:N"
    },
    "MONITORED_BY": {
      "from": [
        "Component",
        "Asset"
      ],
      "to": "Sensor",
      "cardinality": "1:N",
      "note": "설비 전체에 붙은 계산값(SE)은 Asset에서"
    },
    "OBSERVES": {
      "from": "Sensor",
      "to": "Quantity",
      "cardinality": "N:1"
    },
    "USES_PART": {
      "from": "Component",
      "to": "Part",
      "cardinality": "N:1",
      "properties": {
        "source_text": "string"
      }
    },
    "INSTALLED_UNIT": {
      "from": "Component",
      "to": "Unit",
      "cardinality": "1:N",
      "properties": {
        "current": "boolean"
      },
      "note": "current=true가 지금 달린 실물, false가 철거된 실물"
    },
    "SUPPLIES": {
      "from": "Supplier",
      "to": "Part",
      "cardinality": "N:M",
      "note": "공급사·품번마다 기준일에 유효한 견적 하나(여럿이면 견적일이 가장 늦은 줄)",
      "properties": {
        "approved": "boolean",
        "approval_status": "string",
        "condition": "string",
        "price_manwon": "number",
        "defect_rate": "number",
        "defect_rate_original": "string",
        "lead_days": "integer",
        "lead_days_original": "string",
        "min_order_qty": "integer",
        "supplier_part_no": "string",
        "quote_date": "string",
        "valid_until": "string",
        "quote_source": "string",
        "approval_source": "string",
        "as_of": "string",
        "pending_check": "string"
      }
    }
  },
  "identity": "id는 전체 그래프에서 고유.",
  "branch": "ㄷ",
  "constraints": [
    "id는 전체 그래프에서 고유. 구성요소·센서는 설비코드:이름, 부품은 사내 품번, 실물은 unit:일련번호",
    "옛 코드 줄(같은 기능위치 · 일련번호)·점검표 중복 행은 대상을 새로 만들지 않는다. 철거된 실물은 그 자리의 지난 실물(INSTALLED_UNIT current=false)로 남긴다",
    "limit 생략은 0과 다르다. normal 생략은 미확인",
    "단위는 Quantity 기준 단위로 맞추고 바꾼 경우 source_unit을 남긴다",
    "승인 여부는 승인공급사_목록(SCM 등록)과 기준일로 정한다",
    "만료 견적은 SUPPLIES로 쓰지 않는다",
    "공급사 이름은 승인공급사_목록의 이름이다(견적표의 공급사 칸은 그 이름으로 시작한다)",
    "단가는 만원, 불량률은 0~1 비율, 납기는 일로 맞추고, 바꾼 불량률 · 납기는 원래 표기를 defect_rate_original · lead_days_original로 남긴다",
    "값마다 출처를 남긴다: quote_source = 쓴 견적의 공급_조건.csv 줄, approval_source = 승인공급사_목록.csv의 등록 줄, as_of = 기준일",
    "SCM 등록에 조건이 없는데 구매 기준서 PR-07 7.4에 걸리는 승인 공급사 쌍은 pending_check로 확인 필요를 남긴다(approved는 SCM 등록대로)"
  ]
}
