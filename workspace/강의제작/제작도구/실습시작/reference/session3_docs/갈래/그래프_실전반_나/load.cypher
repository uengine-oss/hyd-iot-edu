MATCH (x:Section {id: 'HI-01@1.0#HI-1'}) MERGE (k:Knowledge {id: 'HI-01@1.0:HI-01-M002'}) SET k += {kind: 'precondition', text: '설비 운전·정비·발주는 기존 승인 절차를 따른다.', quote: '설비 운전·정비·발주는 기존 승인 절차를 따른다.', quote_match: 'exact', line_start: 10, line_end: 10, decision: '채택', reason: '보충 문서의 범위 — 승인은 기존 절차(10줄) — 원문 10줄과 절 · 종류가 기대 항목과 같다 · 보충 문서라 기존 문서를 대체하지 않고 더한다(DC-01 DC-3)', review_file: '입력/검토결과/HI-01_1.0_검토.json'} MERGE (k)-[:STATED_IN]->(x);
