MATCH (x:Section {id: 'HI-01@1.0#HI-1.2'}) MERGE (k:Knowledge {id: 'HI-01@1.0:HI-01-M014'}) SET k += {kind: 'step', text: '작업 메모에 정비 완료라고 적혀 있어도 작업지시가 열려 있거나 완료시각이 없으면 불일치 또는 확인 필요로 남긴다.', quote: '3. 작업 메모에 정비 완료라고 적혀 있어도 작업지시가 열려 있거나 완료시각이 없으면 불일치 또는 확인 필요로 남긴다.', quote_match: 'exact', line_start: 23, line_end: 23, decision: '채택', reason: '열린 작업지시 대조 3단계(23줄) — 원문 23줄과 절 · 종류가 기대 항목과 같다 — 인용 앞의 번호 · 글머리 · 언어 표시는 원문 줄 그대로라 빼고 견줌 · 보충 문서라 기존 문서를 대체하지 않고 더한다(DC-01 DC-3)', review_file: '입력/검토결과/HI-01_1.0_검토.json'} MERGE (k)-[:STATED_IN]->(x);
