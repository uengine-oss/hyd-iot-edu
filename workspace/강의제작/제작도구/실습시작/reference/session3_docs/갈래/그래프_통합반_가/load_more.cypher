MATCH (x:Section {id: 'OEM-HPP45A-MM@C#1'}) MERGE (k:Knowledge {id: 'OEM-HPP45A-MM@C:OEM-HPP45A-MM-M001'}) SET k += {kind: 'precondition', text: '유압 배관이나 필터 하우징을 열기 전에 펌프를 정지하고 모터 전원을 잠근 뒤 어큐뮬레이터를 탱크로 방압한다.', quote: 'Before opening any hydraulic line or filter housing, stop the pump, lock out the motor supply, and discharge the accumulator to tank.', quote_match: 'exact', line_start: 11, line_end: 11, lang: 'en', decision: '수정', reason: '배관 · 필터 하우징을 열기 전 정지 · 잠금 · 방압(11줄) — 사내 기준과 같은 항목 — 출처를 하나 더한다 — PM-02 PM-2.6 · SOP-PM-21 1~2단계(정지 · 잠금 · 잔압 배출) · 원문 11줄과 절 · 종류가 기대 항목과 같다 — section를 원문 표기 \'1\'로 고침(\'1 Safety\')', review_file: '입력/검토결과/OEM-HPP45A-MM_C_검토.json'} MERGE (k)-[:STATED_IN]->(x);
