// 생성: make_query.py — 문장은 줄 끝 ; 로 구분
// 작업 확인 카드 조회: SOP-COOL-14
MATCH (p:Procedure {id: "SOP-COOL-14"})-[:DEFINED_IN]->(s:Section)-[:IN_DOCUMENT]->(d:Document) CALL { WITH p MATCH (p)-[:HAS_STEP|HAS_CONDITION]->(k:Knowledge) RETURN k, '절차 안' AS via UNION WITH p MATCH (k:Knowledge)-[:REFERS_TO]->(p) RETURN k, '이 절차를 ID로 가리킴' AS via UNION WITH p, s MATCH (k:Knowledge)-[:STATED_IN]->(s) WHERE NOT (k)<-[:HAS_STEP|HAS_CONDITION]-(:Procedure) AND k.kind <> 'unit_value' RETURN k, '같은 절의 절차 밖 문장' AS via UNION WITH p MATCH (p)-[:HAS_STEP|HAS_CONDITION]->(:Knowledge)-[:REFERS_TO]->(rs:Section)<-[:STATED_IN]-(k:Knowledge) WHERE NOT (k)<-[:HAS_STEP|HAS_CONDITION]-(:Procedure) RETURN k, '단계가 가리킨 절 ' + rs.section AS via UNION WITH p MATCH (p)-[:HAS_STEP]->(:Knowledge)-[:REFERS_TO]->(rp:Procedure)-[:HAS_STEP|HAS_CONDITION]->(k:Knowledge) RETURN k, '단계가 가리킨 절차 ' + rp.id AS via } MATCH (k)-[:STATED_IN]->(ks:Section) OPTIONAL MATCH (k)<-[:HAS_STEP|HAS_CONDITION]-(owner:Procedure) OPTIONAL MATCH (k)-[:ABOUT_QUANTITY]->(q:Quantity) OPTIONAL MATCH (k)-[:MENTIONS_PART]->(part:Part) RETURN p.id, p.name, d.id, d.status, d.sha256, s.section, k.id, k.kind, k.text, k.quote, k.order, k.value, k.value_max, k.unit, k.comparator, ks.section, owner.id, via, collect(DISTINCT q.id), collect(DISTINCT part.id), k.refs, k.unresolved_parts ORDER BY k.id;
// 작업 확인 카드 조회: T-3.1
MATCH (p:Procedure {id: "T-3.1"})-[:DEFINED_IN]->(s:Section)-[:IN_DOCUMENT]->(d:Document) CALL { WITH p MATCH (p)-[:HAS_STEP|HAS_CONDITION]->(k:Knowledge) RETURN k, '절차 안' AS via UNION WITH p MATCH (k:Knowledge)-[:REFERS_TO]->(p) RETURN k, '이 절차를 ID로 가리킴' AS via UNION WITH p, s MATCH (k:Knowledge)-[:STATED_IN]->(s) WHERE NOT (k)<-[:HAS_STEP|HAS_CONDITION]-(:Procedure) AND k.kind <> 'unit_value' RETURN k, '같은 절의 절차 밖 문장' AS via UNION WITH p MATCH (p)-[:HAS_STEP|HAS_CONDITION]->(:Knowledge)-[:REFERS_TO]->(rs:Section)<-[:STATED_IN]-(k:Knowledge) WHERE NOT (k)<-[:HAS_STEP|HAS_CONDITION]-(:Procedure) RETURN k, '단계가 가리킨 절 ' + rs.section AS via UNION WITH p MATCH (p)-[:HAS_STEP]->(:Knowledge)-[:REFERS_TO]->(rp:Procedure)-[:HAS_STEP|HAS_CONDITION]->(k:Knowledge) RETURN k, '단계가 가리킨 절차 ' + rp.id AS via } MATCH (k)-[:STATED_IN]->(ks:Section) OPTIONAL MATCH (k)<-[:HAS_STEP|HAS_CONDITION]-(owner:Procedure) OPTIONAL MATCH (k)-[:ABOUT_QUANTITY]->(q:Quantity) OPTIONAL MATCH (k)-[:MENTIONS_PART]->(part:Part) RETURN p.id, p.name, d.id, d.status, d.sha256, s.section, k.id, k.kind, k.text, k.quote, k.order, k.value, k.value_max, k.unit, k.comparator, ks.section, owner.id, via, collect(DISTINCT q.id), collect(DISTINCT part.id), k.refs, k.unresolved_parts ORDER BY k.id;
// 미제공 작업(원문에 없는 절차): 0행이어야 한다
MATCH (p:Procedure) WHERE p.id IN ['SOP-PM-24', '코어교체'] RETURN p.id;
// 적재하지 않은 후보(제외·보류)가 DB에 없어야 한다: 0
MATCH (k:Knowledge) WHERE k.id IN ["HI-01-010", "HI-01-026", "HM-8-007", "HM-8-022", "HM-8-029", "HM-8-033", "HM-8-038", "HM-8-041", "HM-8-044", "HM-8-047", "OEM-HPP45A-MM-001", "OEM-HPP45A-MM-057", "PM-02-001", "PM-02-002", "PM-02-003", "PM-02-004", "PM-02-011", "PM-02-049", "PM-02-097", "PM-02-100", "PM-02-103"] RETURN count(k) AS loaded_not_approved;
// 폐기 판 문서가 적재되지 않았는지
MATCH (d:Document) RETURN d.id, d.status ORDER BY d.id;
// 작업 → 부품 → 공급 조건(2회차 모델의 기존 ID)
MATCH (p:Procedure)-[:HAS_STEP|HAS_CONDITION]->(:Knowledge)-[:MENTIONS_PART]->(part:Part) OPTIONAL MATCH (s:Supplier)-[r:SUPPLIES]->(part) RETURN DISTINCT p.id, part.id, s.name, r.approved, r.price_manwon, r.lead_days ORDER BY p.id, part.id, s.name;
// 작업 → 적용 설비
MATCH (p:Procedure)-[:APPLIES_TO]->(a:Asset) RETURN p.doc_id, count(DISTINCT p) AS procedures, collect(DISTINCT a.id) AS assets ORDER BY p.doc_id;
