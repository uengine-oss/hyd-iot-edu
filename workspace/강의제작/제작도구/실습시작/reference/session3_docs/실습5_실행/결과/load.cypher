MATCH (s:Section {id: "PM-02:PM-2.4"}) MERGE (k:Knowledge {id: "PM-02-014"}) SET k += {kind: "prohibition", text: "낮에 생산 중인 설비는 세우지 않는 것이 원칙이다.", quote: "낮에 생산 중인 설비는 세우지 않는 것이 원칙이다.", refs: [], decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "PM-02", doc_rev: "2.0", section: "PM-2.4", source_sha256: "2a757bd43772774a3b85c99779b3acef501f8d4dbc2cdbf9f851394ba841ae4a", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:Prohibition MERGE (k)-[:STATED_IN]->(s);
MATCH (s:Section {id: "PM-02:PM-2.5"}) MERGE (k:Knowledge {id: "PM-02-015"}) SET k += {kind: "precondition", text: "정기 정비 도래로 열린 처리 건에서 마지막 정기 정비 뒤 운전시간이 허용 오차 하한 1,800 h 이상이면 아래 시행 방식 네 가지를 비교한다.", quote: "정기 정비 도래로 열린 처리 건에서 마지막 정기 정비 뒤 운전시간이 허용 오차 하한 1,800 h 이상이면 아래 시행 방식 네 가지를 비교한다.", refs: [], decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "PM-02", doc_rev: "2.0", section: "PM-2.5", source_sha256: "2a757bd43772774a3b85c99779b3acef501f8d4dbc2cdbf9f851394ba841ae4a", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:Precondition MERGE (k)-[:STATED_IN]->(s);
