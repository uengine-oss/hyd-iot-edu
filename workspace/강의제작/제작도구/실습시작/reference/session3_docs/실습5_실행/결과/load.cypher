MATCH (s:Section {id: "PM-02:PM-2.3"}) MERGE (k:Knowledge {id: "PM-02-008"}) SET k += {kind: "prohibition", text: "2,200 h를 넘겨 시행하면 보증 기간 중 점검 기록 요건을 어긴 것이 된다.", quote: "2,200 h를 넘겨 시행하면 보증 기간 중 점검 기록 요건을 어긴 것이 된다.", refs: [], decision: "수정", reason: "상한을 넘긴 시행의 결과를 말하는 제한 문장이다. 실행 전 조건이 아니라 금지·제한으로 분류한다.", origin: "extractor", doc_id: "PM-02", doc_rev: "2.0", section: "PM-2.3", source_sha256: "2a757bd43772774a3b85c99779b3acef501f8d4dbc2cdbf9f851394ba841ae4a", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:Prohibition MERGE (k)-[:STATED_IN]->(s);
MATCH (s:Section {id: "PM-02:PM-2.3"}) MERGE (k:Knowledge {id: "PM-02-009"}) SET k += {kind: "unit_value", text: "2,200 h를 넘겨 시행하면 보증 기간 중 점검 기록 요건을 어긴 것이 된다.", quote: "2,200 h를 넘겨 시행하면 보증 기간 중 점검 기록 요건을 어긴 것이 된다.", refs: [], value: 2200, unit: "h", comparator: ">", value_text: "2,200 h를 넘", decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "PM-02", doc_rev: "2.0", section: "PM-2.3", source_sha256: "2a757bd43772774a3b85c99779b3acef501f8d4dbc2cdbf9f851394ba841ae4a", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
MATCH (s:Section {id: "PM-02:PM-2.3"}) MERGE (k:Knowledge {id: "PM-02-010"}) SET k += {kind: "prohibition", text: "허용 오차 상한을 넘기는 일정은 잡지 않는다.", quote: "허용 오차 상한을 넘기는 일정은 잡지 않는다.", refs: [], decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "PM-02", doc_rev: "2.0", section: "PM-2.3", source_sha256: "2a757bd43772774a3b85c99779b3acef501f8d4dbc2cdbf9f851394ba841ae4a", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:Prohibition MERGE (k)-[:STATED_IN]->(s);
MATCH (s:Section {id: "PM-02:PM-2.4"}) MERGE (k:Knowledge {id: "PM-02-012"}) SET k += {kind: "unit_value", text: "CMMS는 마지막 정기 정비 뒤 운전시간이 1,950 h에 닿으면 정기 정비 도래 경보 PM_DUE를 낸다(주기 50 h 전, 회사 설정).", quote: "CMMS는 마지막 정기 정비 뒤 운전시간이 1,950 h에 닿으면 정기 정비 도래 경보 PM_DUE를 낸다(주기 50 h 전, 회사 설정).", refs: [], value: 1950, unit: "h", comparator: ">=", value_text: "1,950 h에 닿으면", decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "PM-02", doc_rev: "2.0", section: "PM-2.4", source_sha256: "2a757bd43772774a3b85c99779b3acef501f8d4dbc2cdbf9f851394ba841ae4a", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
