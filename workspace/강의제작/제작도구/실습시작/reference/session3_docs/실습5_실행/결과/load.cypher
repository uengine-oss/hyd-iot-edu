MATCH (s:Section {id: "HI-01:HI-1.1"}) MERGE (k:Knowledge {id: "HI-01-007"}) SET k += {kind: "step", text: "작업 메모의 이상 해소 주장과 관측값이 일치하는지 비교하고, 근거가 부족하면 다음 근무자가 확인할 항목으로 남긴다.", quote: "작업 메모의 이상 해소 주장과 관측값이 일치하는지 비교하고, 근거가 부족하면 다음 근무자가 확인할 항목으로 남긴다.", refs: [], order: 4, decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "HI-01", doc_rev: "1.0", section: "HI-1.1", source_sha256: "2a0e533c3a9fa7cebc2dfd6fdda140feab92e04002d5d28de2a13eb44e3980dd", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:Step MERGE (k)-[:STATED_IN]->(s) WITH k MATCH (p:Procedure {id: "SOP-HI-01"}) MERGE (p)-[:HAS_STEP {order: 4}]->(k);
