MATCH (s:Section {id: "PM-02:PM-2.3"}) MERGE (k:Knowledge {id: "PM-02-005"}) SET k += {kind: "unit_value", text: "정기 정비는 주기 2,000 h의 ±10 % 안, 곧 마지막 정기 정비 뒤 운전시간 1,800~2,200 h 사이에 시행한다.", quote: "정기 정비는 주기 2,000 h의 ±10 % 안, 곧 마지막 정기 정비 뒤 운전시간 1,800~2,200 h 사이에 시행한다.", refs: [], value: 2000, unit: "h", value_text: "2,000 h", decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "PM-02", doc_rev: "2.0", section: "PM-2.3", source_sha256: "2a757bd43772774a3b85c99779b3acef501f8d4dbc2cdbf9f851394ba841ae4a", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
MATCH (s:Section {id: "PM-02:PM-2.3"}) MERGE (k:Knowledge {id: "PM-02-006"}) SET k += {kind: "unit_value", text: "정기 정비는 주기 2,000 h의 ±10 % 안, 곧 마지막 정기 정비 뒤 운전시간 1,800~2,200 h 사이에 시행한다.", quote: "정기 정비는 주기 2,000 h의 ±10 % 안, 곧 마지막 정기 정비 뒤 운전시간 1,800~2,200 h 사이에 시행한다.", refs: [], value: 10, unit: "%", comparator: "±", value_text: "±10 %", decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "PM-02", doc_rev: "2.0", section: "PM-2.3", source_sha256: "2a757bd43772774a3b85c99779b3acef501f8d4dbc2cdbf9f851394ba841ae4a", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
