MATCH (s:Section {id: "HM-8:HM-8.7"}) MERGE (k:Knowledge {id: "HM-8-R107"}) SET k += {kind: "precondition", text: "원인에 맞는 근본 조치를 CMMS 작업지시로 발행한다.", quote: "원인에 맞는 근본 조치를 CMMS 작업지시로 발행한다.", refs: [], decision: "채택", reason: "검토자 추가: 근본 조치(SOP-COOL-14·15)는 CMMS 작업지시로 발행한다는 실행 전 조건. 조건 표현이 없는 평서문이라 놓쳤다.", origin: "reviewer", doc_id: "HM-8", doc_rev: "1.1", section: "HM-8.7", source_sha256: "6a1a66a6000e9c292f58bd6160ce46ba07e90862f40d4cc0a2e8b1cc2778e256", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:Precondition MERGE (k)-[:STATED_IN]->(s);
