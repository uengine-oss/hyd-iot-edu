MATCH (s:Section {id: "HM-8:HM-8.4"}) MERGE (k:Knowledge {id: "HM-8-045"}) SET k += {kind: "unit_value", text: "경보 패턴 COOLER_DEGRADATION이 떴을 때 냉각 효율이 70 % 미만이면 핀 오염을 1순위 원인으로 둔다.", quote: "경보 패턴 COOLER_DEGRADATION이 떴을 때 냉각 효율이 70 % 미만이면 핀 오염을 1순위 원인으로 둔다.", refs: [], value: 70, unit: "%", comparator: "<", value_text: "70 % 미만", decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "HM-8", doc_rev: "1.1", section: "HM-8.4", source_sha256: "6a1a66a6000e9c292f58bd6160ce46ba07e90862f40d4cc0a2e8b1cc2778e256", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
