MATCH (s:Section {id: "HM-8:HM-8.3"}) MERGE (k:Knowledge {id: "HM-8-030"}) SET k += {kind: "unit_value", text: "유온이 55 ℃를 넘고 냉각 효율이 70 % 아래로 떨어진 채 유온이 계속 오르면 쿨러 냉각 성능 상실로 본다.", quote: "유온이 55 ℃를 넘고 냉각 효율이 70 % 아래로 떨어진 채 유온이 계속 오르면 쿨러 냉각 성능 상실로 본다.", refs: [], value: 55, unit: "℃", comparator: ">", value_text: "55 ℃를 넘", decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "HM-8", doc_rev: "1.1", section: "HM-8.3", source_sha256: "6a1a66a6000e9c292f58bd6160ce46ba07e90862f40d4cc0a2e8b1cc2778e256", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
MATCH (s:Section {id: "HM-8:HM-8.3"}) MERGE (k:Knowledge {id: "HM-8-031"}) SET k += {kind: "unit_value", text: "유온이 55 ℃를 넘고 냉각 효율이 70 % 아래로 떨어진 채 유온이 계속 오르면 쿨러 냉각 성능 상실로 본다.", quote: "유온이 55 ℃를 넘고 냉각 효율이 70 % 아래로 떨어진 채 유온이 계속 오르면 쿨러 냉각 성능 상실로 본다.", refs: [], value: 70, unit: "%", comparator: "<", value_text: "70 % 아래", decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "HM-8", doc_rev: "1.1", section: "HM-8.3", source_sha256: "6a1a66a6000e9c292f58bd6160ce46ba07e90862f40d4cc0a2e8b1cc2778e256", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
MATCH (s:Section {id: "HM-8:HM-8.3"}) MERGE (k:Knowledge {id: "HM-8-032"}) SET k += {kind: "unit_value", text: "이 상태로 두면 인터록 65 ℃에서 설비가 서고, 고온 운전은 씰과 작동유 수명을 줄인다.", quote: "이 상태로 두면 인터록 65 ℃에서 설비가 서고, 고온 운전은 씰과 작동유 수명을 줄인다.", refs: [], value: 65, unit: "℃", comparator: ">=", value_text: "65 ℃", decision: "수정", reason: "같은 절 표의 인터록 칸 「65 ℃ 이상 (설비 정지)」과 같은 기준이다. 「65 ℃에서」는 도달 시점을 말하므로 비교 기호를 >=로 맞춘다.", origin: "extractor", doc_id: "HM-8", doc_rev: "1.1", section: "HM-8.3", source_sha256: "6a1a66a6000e9c292f58bd6160ce46ba07e90862f40d4cc0a2e8b1cc2778e256", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
MATCH (s:Section {id: "HM-8:HM-8.4"}) MERGE (k:Knowledge {id: "HM-8-034"}) SET k += {kind: "unit_value", text: "최근 30초 냉각 효율 평균이 70 % 미만이고, 최근 2분 팬 진동 VS1 평균이 0.9 mm/s 미만(팬은 정상)이면 핀 오염으로 판정한다.", quote: "최근 30초 냉각 효율 평균이 70 % 미만이고, 최근 2분 팬 진동 VS1 평균이 0.9 mm/s 미만(팬은 정상)이면 핀 오염으로 판정한다.", refs: [], value: 30, unit: "초", value_text: "30초", decision: "채택", reason: "원문 문장·절·종류·값을 대조해 일치한다.", origin: "extractor", doc_id: "HM-8", doc_rev: "1.1", section: "HM-8.4", source_sha256: "6a1a66a6000e9c292f58bd6160ce46ba07e90862f40d4cc0a2e8b1cc2778e256", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:UnitValue MERGE (k)-[:STATED_IN]->(s);
