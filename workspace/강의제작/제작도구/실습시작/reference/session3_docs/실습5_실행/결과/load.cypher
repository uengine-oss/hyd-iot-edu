MATCH (s:Section {id: "HM-8:HM-8.8"}) MERGE (k:Knowledge {id: "HM-8-100"}) SET k += {kind: "prohibition", text: "팬 100 % 연속 운전이 24시간을 넘으면 팬 수명이 줄어든다.", quote: "팬 100 % 연속 운전이 24시간을 넘으면 팬 수명이 줄어든다.", refs: [], decision: "수정", reason: "24시간 제한의 이유를 말하는 제한 문장이다. 실행 전 충족할 조건이 아니라 금지·제한으로 분류한다.", origin: "extractor", doc_id: "HM-8", doc_rev: "1.1", section: "HM-8.8", source_sha256: "6a1a66a6000e9c292f58bd6160ce46ba07e90862f40d4cc0a2e8b1cc2778e256", reviewer: "강사 참조 검토(원문 대조, 2026-10-28)", reviewed_at: "2026-10-28T00:00:00+09:00", status: "approved"}, k:Prohibition MERGE (k)-[:STATED_IN]->(s);
