{
  "classes": {
    "Asset": {
      "meaning": "개별 설비(설비코드 기준). 기능위치·실물 일련번호를 속성으로 둔다",
      "required": {
        "id": "string",
        "name": "string",
        "model": "string",
        "status": "string"
      },
      "optional": {
        "maker": "string",
        "serial": "string",
        "functional_location": "string",
        "installed": "string"
      }
    },
    "Component": {
      "meaning": "설비 안의 정비 가능 품목. 기능 자리 기준 ID(설비코드:품목)로, 실물 교체는 serial로 남긴다",
      "required": {
        "id": "string",
        "name": "string",
        "group": "string"
      },
      "optional": {
        "serial": "string",
        "aliases": "list"
      }
    },
    "Sensor": {
      "meaning": "설비별 계측 채널",
      "required": {
        "id": "string",
        "tag": "string",
        "unit": "string"
      },
      "optional": {
        "normal": "number",
        "limit": "number",
        "limit_direction": [
          "upper",
          "lower"
        ],
        "source_unit": "string"
      }
    },
    "Quantity": {
      "meaning": "재는 값의 종류(무엇의 어떤 값)와 기준 단위. 어디에 붙었는지는 센서가 붙은 구성 요소가 말한다",
      "required": {
        "id": "string",
        "name": "string",
        "unit": "string"
      }
    },
    "Part": {
      "meaning": "사내 품번 하나로 관리하는 부품 품목",
      "required": {
        "id": "string",
        "name": "string"
      },
      "optional": {
        "other_codes": "list"
      }
    }
  },
  "relations": {
    "HAS_COMPONENT": {
      "from": "Asset",
      "to": "Component",
      "cardinality": "1:N"
    },
    "MONITORED_BY": {
      "from": "Component",
      "to": "Sensor",
      "cardinality": "1:N"
    },
    "OBSERVES": {
      "from": "Sensor",
      "to": "Quantity",
      "cardinality": "N:1"
    },
    "USES_PART": {
      "from": "Component",
      "to": "Part",
      "cardinality": "N:1",
      "properties": {
        "source_text": "string"
      }
    }
  },
  "identity": "id는 전체 그래프에서 고유.",
  "branch": "A",
  "constraints": [
    "id는 전체 그래프에서 고유. 구성요소·센서는 설비코드:이름, 부품은 사내 품번",
    "철거 실물 행은 대상을 새로 만들지 않는다",
    "limit 생략은 0과 다르다. normal 생략은 미확인",
    "단위는 Quantity 기준 단위로 맞추고 바꾼 경우 source_unit을 남긴다"
  ]
}
