{
  "classes": {
    "Asset": {
      "meaning": "개별 설비(설비코드 기준). 기능위치·실물 일련번호를 속성으로 둔다",
      "required": {
        "id": "string",
        "name": "string",
        "model": "string",
        "status": "string"
      },
      "optional": {
        "maker": "string",
        "serial": "string",
        "functional_location": "string",
        "installed": "string",
        "legacy_codes": "list"
      }
    },
    "Component": {
      "meaning": "설비 안의 정비 가능 품목이 놓인 자리. 기능 자리 기준 ID(설비코드:품목)이고, 그 자리에 달린 실물은 Unit",
      "required": {
        "id": "string",
        "name": "string",
        "group": "string"
      },
      "optional": {
        "aliases": "list"
      }
    },
    "Sensor": {
      "meaning": "설비별 계측 채널. 실측·계산값·설정값을 kind로 구별",
      "required": {
        "id": "string",
        "tag": "string",
        "unit": "string",
        "kind": [
          "measured",
          "derived",
          "setpoint"
        ],
        "derived": "boolean"
      },
      "optional": {
        "normal": "number",
        "limit": "number",
        "limit_direction": [
          "upper",
          "lower"
        ],
        "instrument_tag": "string",
        "sample_hz": "number",
        "collection": "string",
        "source_unit": "string"
      }
    },
    "Quantity": {
      "meaning": "재는 물리량과 기준 단위. 붙은 자리가 다르면 다른 물리량(쿨러 쪽 유온 · 탱크 유온)",
      "required": {
        "id": "string",
        "name": "string",
        "unit": "string"
      }
    },
    "Part": {
      "meaning": "사내 품번 하나로 관리하는 부품 품목",
      "required": {
        "id": "string",
        "name": "string"
      },
      "optional": {
        "other_codes": "list"
      }
    },
    "Unit": {
      "meaning": "일련번호가 붙은 실물 한 대(그 자리에 지금 달린 것 · 전에 달렸다가 철거된 것)",
      "required": {
        "id": "string",
        "serial": "string"
      }
    }
  },
  "relations": {
    "HAS_COMPONENT": {
      "from": "Asset",
      "to": "Component",
      "cardinality": "1:N"
    },
    "MONITORED_BY": {
      "from": [
        "Component",
        "Asset"
      ],
      "to": "Sensor",
      "cardinality": "1:N",
      "note": "설비 전체에 붙은 계산값(SE)은 Asset에서"
    },
    "OBSERVES": {
      "from": "Sensor",
      "to": "Quantity",
      "cardinality": "N:1"
    },
    "USES_PART": {
      "from": "Component",
      "to": "Part",
      "cardinality": "N:1",
      "properties": {
        "source_text": "string"
      }
    },
    "INSTALLED_UNIT": {
      "from": "Component",
      "to": "Unit",
      "cardinality": "1:N",
      "properties": {
        "current": "boolean"
      },
      "note": "current=true가 지금 달린 실물, false가 철거된 실물"
    },
    "CANDIDATE_PART": {
      "from": "Component",
      "to": "Part",
      "cardinality": "N:M",
      "properties": {
        "source_text": "string"
      },
      "note": "원자료가 하나로 정하지 않아 확인이 필요한 교체 부품 후보"
    }
  },
  "identity": "id는 전체 그래프에서 고유.",
  "branch": "D",
  "constraints": [
    "id는 전체 그래프에서 고유. 구성요소·센서는 설비코드:이름, 부품은 사내 품번, 실물은 unit:일련번호",
    "옛 코드 줄(같은 기능위치 · 일련번호)·점검표 중복 행은 대상을 새로 만들지 않는다. 철거된 실물은 그 자리의 지난 실물(INSTALLED_UNIT current=false)로 남긴다",
    "limit 생략은 0과 다르다. normal 생략은 미확인",
    "단위는 Quantity 기준 단위로 맞추고 바꾼 경우 source_unit을 남긴다",
    "교체부품 칸이 비었거나 같은 모델 · 같은 쓰는곳의 예비품이 둘 이상이면 USES_PART로 정하지 않고 후보마다 CANDIDATE_PART로 남긴다"
  ]
}
