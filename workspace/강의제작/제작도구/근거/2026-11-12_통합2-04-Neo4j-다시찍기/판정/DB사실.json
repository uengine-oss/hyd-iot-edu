 "_질의": {
  "전체 수": "MATCH (n) WITH count(n) AS n MATCH ()-[r]->() RETURN n, count(r)",
  "레이블별": "MATCH (n) UNWIND labels(n) AS l RETURN l, count(*) ORDER BY l",
  "노드 속성": "MATCH (n) RETURN labels(n)[0], properties(n) ORDER BY labels(n)[0], n.id",
  "관계": "MATCH (a)-[r]->(b) RETURN a.name, type(r), b.name ORDER BY type(r), a.name",
  "TS1 표": "MATCH p=(a:Asset {code:'HYD-01'})-[:HAS_COMPONENT]->(c:Component)-[:MONITORED_BY]->(s:Sensor)-[:OBSERVES]->(v:StateVariable) WHERE s.tag = 'TS1' RETURN c.name AS component, s.tag AS tag, v.name AS quantity, v.unit AS unit, v.normal AS normal, v.limit AS limit",
  "한계 표": "MATCH p=(a:Asset {code:'HYD-01'})-[:HAS_COMPONENT]->(c:Component)-[:MONITORED_BY]->(s:Sensor)-[:OBSERVES]->(v:StateVariable) WHERE v.limit IS NOT NULL RETURN s.tag AS tag, v.name AS quantity, v.unit AS unit, v.limit AS limit ORDER BY tag",
  "센서 집계": "MATCH (:Asset {code:'HYD-01'})-[:HAS_COMPONENT]->(c:Component)-[:MONITORED_BY]->(s:Sensor) RETURN c.id AS component_id, c.name AS component, collect(DISTINCT s.tag) AS tags, count(DISTINCT s) AS channels ORDER BY channels DESC, component_id",
  "경로 수": "MATCH p=(a:Asset {code:'HYD-01'})-[:HAS_COMPONENT]->(c:Component)-[:MONITORED_BY]->(s:Sensor)-[:OBSERVES]->(v:StateVariable) RETURN count(p)"
 },
 "_DB": "VM 실습 DB(학생 ZIP의 prepare_example.py로 만든 neo4j:5.26-community, 2026-11-12)"
