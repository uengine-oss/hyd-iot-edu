dec:action-candidates rule:hm-8-5-cooler-mitigations SELECT when= pattern == 'COOLER_DEGRADATION' tests= [{'input': 'in:pattern', 'unit': None, 'variable': 'pattern', 'value': 'COOLER_DEGRADATION', 'operator': '=='}] applies= [] pen= None out= ['skill:sop-cool-13', 'skill:sop-cool-11', 'skill:sop-cool-12'] ann= 쿨러 성능 저하 경보의 즉시 완화 절차 후보.
dec:action-candidates rule:hm-8-4-fan-inspection SELECT when= pattern == 'FAN_VIBRATION' tests= [{'input': 'in:pattern', 'unit': None, 'variable': 'pattern', 'value': 'FAN_VIBRATION', 'operator': '=='}] applies= [] pen= None out= ['skill:sop-fan-11'] ann= 팬 진동 상승 조건에서 HM-8.1 팬 점검 절차를 후보로 제안한다.
dec:action-candidates rule:hm-8-7-fin-cleaning SELECT when= cause == 'cause:cooler-fin-fouling' tests= [{'input': 'in:cause', 'unit': None, 'variable': 'cause', 'value': 'cause:cooler-fin-fouling', 'operator': '=='}] applies= [] pen= None out= ['skill:sop-cool-14'] ann= 쿨러 핀 오염 원인에 대한 근본 조치 후보.
dec:action-candidates rule:hm-8-7-cabinet-ventilation SELECT when= cause == 'cause:ambient-temperature-rise' tests= [{'input': 'in:cause', 'unit': None, 'variable': 'cause', 'value': 'cause:ambient-temperature-rise', 'operator': '=='}] applies= [] pen= None out= ['skill:sop-cool-15'] ann= 주변 온도 상승 원인에 대한 환기 보강 근본 조치 후보.
dec:action-candidates rule:hm-8-4-fan-drive-inspection SELECT when= cause == 'cause:fan-drive-fault' tests= [{'input': 'in:cause', 'unit': None, 'variable': 'cause', 'value': 'cause:fan-drive-fault', 'operator': '=='}] applies= [] pen= None out= ['skill:sop-fan-11'] ann= 팬 구동 불량 원인이면 HM-8.1 쿨러 팬 점검 절차를 근본 조치 후보로 낸다.
dec:compliance rule:ts1-hard EXCLUDE when= forecast_ts1 >= 65 tests= [{'input': 'in:forecast-ts1', 'unit': '℃', 'variable': 'forecast_ts1', 'value': 65, 'operator': '>='}] applies= [] pen= None out= [] ann= 예측 유온이 인터록 한계 이상이면 제외 (모든 제어 후보에 예측값으로 적용)
dec:compliance rule:hm-8-8-remote-auto-only EXCLUDE when= plc_mode != 'REMOTE_AUTO' tests= [{'input': 'in:plc-mode', 'unit': None, 'variable': 'plc_mode', 'value': 'REMOTE_AUTO', 'operator': '!='}] applies= ['skill:sop-cool-12', 'skill:sop-cool-13', 'skill:sop-cool-11'] pen= None out= [] ann= PLC 운전 모드가 REMOTE_AUTO가 아니면 원격 조치 SOP-COOL-11~13을 쓰지 않는다.
dec:compliance rule:hm-8-8-fan-life-penalty PENALTY when= fan100_hours > 24 tests= [{'input': 'in:fan100-hours', 'unit': 'h', 'variable': 'fan100_hours', 'value': 24, 'operator': '>'}] applies= ['skill:sop-cool-11', 'skill:sop-cool-12'] pen= 20 out= [] ann= 팬 100 % 연속 운전이 이미 24시간을 넘긴 경우 팬 수명 손실 20만 원 감점. 감점 지표는 원문에 특정되지 않아 msr:maint-cost를 검토용으로 연결함.
dec:compliance rule:cooler-forecast-temperature-warning WARN when= forecast_ts1 >= 55 tests= [{'input': 'in:forecast-ts1', 'unit': '℃', 'variable': 'forecast_ts1', 'value': 55, 'operator': '>='}] applies= ['skill:sop-cool-11', 'skill:sop-cool-12', 'skill:sop-cool-13'] pen= None out= [] ann= 조치 후 예측 유온이 55 ℃ 이상이면 경보 해제에 실패할 수 있으므로 다른 조치와 비교한다.
