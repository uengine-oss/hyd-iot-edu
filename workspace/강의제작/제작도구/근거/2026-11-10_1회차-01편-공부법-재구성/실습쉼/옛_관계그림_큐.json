    ],
    [
     "type",
     "냉각 효율"
    ]
   ]
  },
  {
   "id": "o036",
   "segment": 4,
   "text": "오른쪽 칸에는 30초 평균 70퍼센트 미만이라고 적겠습니다.",
   "ops": [
    [
     "click",
