    [
     "click",
     "labelPlus"
    ],
    [
     "click",
     "labelInput"
    ],
    [
     "type",
     "Cause"
    ],
    [
     "key",
     "Tab"
    ]
   ]
  },
  {
   "id": "o032",
   "segment": 4,
   "text": "원인이 고장을 일으키는 거니까 방향을 뒤집어야겠죠. 화살표를 누르고 Reverse를 누른 뒤, Type에 일으킨다는 뜻의 CAUSES를 적겠습니다.",
   "ops": [
    [
     "edge",
     "쿨러 냉각 성능 상실",
