    ],
    [
     "type",
     "30초 평균 < 70 %"
    ]
   ]
  },
  {
   "id": "o037",
   "segment": 4,
   "text": "Property를 하나 더 추가해서, 팬 진동은 2분 평균 0.9 미만이라고 적을게요.",
   "ops": [
