    [
     "key",
     "Tab"
    ]
   ]
  },
  {
   "id": "o041",
   "segment": 4,
   "text": "화살표를 누르고 Type에 완화된다는 뜻의 MITIGATED_BY를 적겠습니다.",
   "ops": [
    [
     "edge",
     "쿨러 냉각 성능 상실",
