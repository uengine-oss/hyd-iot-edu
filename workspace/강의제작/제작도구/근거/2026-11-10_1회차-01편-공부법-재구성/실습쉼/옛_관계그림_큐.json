    ]
   ]
  },
  {
   "id": "o025",
   "segment": 3,
   "text": "화살표를 누르고 Type에 가리킨다는 뜻의 INDICATES를 적겠습니다.",
   "ops": [
    [
     "edge",
     "유온 상승",
