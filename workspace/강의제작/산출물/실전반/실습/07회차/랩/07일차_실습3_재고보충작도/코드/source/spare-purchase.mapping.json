{
  "name": "예비품 구매",
  "start": {
    "kind": "alert",
    "patterns": [
      "SPARE_BELOW_MIN"
    ]
  },
  "lanes": {},
  "tasks": {
    "T_agent": {
      "part": "task:decide",
      "agent": "agent:spare-buy",
      "instruction": "필요량을 정하고 공급사를 금액 · 납기 · 품질 · 회사 규정으로 비교해 발주 카드를 낸다"
    },
    "T_approve": {
      "part": "task:select-or-reject",
      "role": "구매 담당"
    },
    "T_notice": {
      "part": "svc:report",
      "config": {
        "outcome": "승인 지연",
        "title": "예비품 구매 승인 지연",
        "summary": "승인 대기 중 — 경보 {alert.alertId}. 승인하거나 거절할 때까지 기다립니다"
      }
    },
    "R_rejected": {
      "part": "svc:report",
      "config": {
        "outcome": "반려",
        "title": "예비품 구매 결과",
        "summary": "담당자가 거절했습니다 — 사유: {approval_reason}. 발주하지 않았습니다(재고 보충 필요 표시는 그대로)"
      }
    },
    "T_po": {
      "part": "svc:erp-po",
      "config": {
        "mail": {
          "to": "supplier@hyd.local, receiving@hyd.local",
          "subject": "[발주] {approved_part_no} {approved_qty}개",
          "body": "공급사 {approved_supplier}, 금액 {approved_amount}만원, 발주 번호 {purchase_order.ref}"
        }
      }
    },
    "T_gr": {
      "part": "svc:goods-receipt",
      "config": {
        "immediate": true
      }
    },
    "R_ok": {
      "part": "svc:report",
      "config": {
        "outcome": "입고 완료",
        "title": "{approved_part_no} 재고 보충 결과",
        "summary": "{goods_receipt.detail}"
      }
    }
  },
  "timers": {
    "B_overdue": "PT10M"
  },
  "flows": {
    "F_approved": {
      "var": "approval",
      "op": "==",
      "value": "승인"
    },
    "F_rejected": {
      "default": true
    }
  }
}
