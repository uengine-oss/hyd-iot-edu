  "sops": [
    {
      "id": "SOP-FAN-11",
      "name": "쿨러 팬 점검 절차",
      "kind": null,
      "codes": [],
      "source": "HM-8.1",
      "failure_mode": "fm:cooler-cooling-loss",
      "model_refs": {
        "assets": [
          "HYD-01",
          "HYD-02",
          "HYD-03"
        ],
        "components": [
          "HYD-01:fan",
          "HYD-02:fan",
          "HYD-03:fan"
        ],
        "sensors": [
          "HYD-01:VS1",
          "HYD-02:VS1",
          "HYD-03:VS1"
        ],
        "not_linked": "HYD-04는 뺐음 — HPP-45A 후속형이지만 냉각 장치가 수냉식 열교환기이고 HM-8에 적용 범위 문장이 없음. HYD-05 · HYD-06(DPU-30, 다른 제조사 — 유온 태그 T_OIL · 한계 70 ℃, 냉각 효율 · 설정값 태그 없음)과 HYD-07(쿨러 · 통신 없음)은 모델에 이 조치를 판정 · 확인할 센서가 없어 걸지 않음"
      },
      "apply_conditions": [
        {
          "text": "팬 지시값은 정상인데 냉각 효율이 떨어지고 진동 VS1이 0.9 mm/s를 넘을 때(최근 2분 VS1 평균 0.9 mm/s 이상이면 이 점검으로 넘어간다).",
          "source": "HM-8.1; HM-8.4",
          "rules": []
        }
      ],
      "prohibitions": [],
      "steps": [
        {
          "order": 1,
          "text": "설비를 정지하고 현장 패널에서 LOCAL로 전환한다.",
          "source": "HM-8.1 SOP-FAN-11 단계 1"
        },
        {
          "order": 2,
          "text": "벨트 처짐을 측정한다 (기준 10~15 mm).",
          "source": "HM-8.1 SOP-FAN-11 단계 2"
        },
        {
          "order": 3,
          "text": "베어링 소음과 표면 온도를 확인한다 (60 ℃ 이하).",
          "source": "HM-8.1 SOP-FAN-11 단계 3"
        },
        {
          "order": 4,
          "text": "재가동 후 VS1이 0.9 mm/s 아래로 내려왔는지 확인한다.",
          "source": "HM-8.1 SOP-FAN-11 단계 4"
        }
      ],
      "completion": [
        {
          "text": "재가동 후 VS1이 0.9 mm/s 아래로 내려왔다.",
          "source": "HM-8.1 SOP-FAN-11 단계 4",
          "rules": []
        }
      ],
      "approval": {
        "role": "미확인 — HM-8.1 SOP-FAN-11 절에 승인 줄이 없음(설비보전팀장 승인 문장은 HM-8.7 근본 조치 절의 것)",
        "source": "HM-8.1"
      }
    },
    {
      "id": "SOP-FAN-12",
      "name": "벨트 교체 절차",
      "kind": null,
      "codes": [],
      "source": "HM-8.2",
      "failure_mode": "fm:cooler-cooling-loss",
      "model_refs": {
        "assets": [
          "HYD-01",
          "HYD-02",
          "HYD-03"
        ],
        "components": [
          "HYD-01:fan",
          "HYD-02:fan",
          "HYD-03:fan"
        ],
        "sensors": [
          "HYD-01:CE",
          "HYD-02:CE",
          "HYD-03:CE",
          "HYD-01:VS1",
          "HYD-02:VS1",
          "HYD-03:VS1"
        ],
        "not_linked": "HYD-04는 뺐음 — HPP-45A 후속형이지만 냉각 장치가 수냉식 열교환기이고 HM-8에 적용 범위 문장이 없음. HYD-05 · HYD-06(DPU-30, 다른 제조사 — 유온 태그 T_OIL · 한계 70 ℃, 냉각 효율 · 설정값 태그 없음)과 HYD-07(쿨러 · 통신 없음)은 모델에 이 조치를 판정 · 확인할 센서가 없어 걸지 않음"
      },
      "apply_conditions": [
        {
          "text": "벨트 처짐이 기준을 벗어나거나 균열이 보일 때.",
          "source": "HM-8.2",
          "rules": []
        }
      ],
      "prohibitions": [
        {
          "type": "제한",
          "text": "LOCAL 전환과 잠금(LOTO)을 확인한 뒤 작업한다.",
          "source": "HM-8.2 SOP-FAN-12 단계 1",
          "rules": []
        }
      ],
      "steps": [
        {
          "order": 1,
          "text": "LOCAL 전환과 잠금(LOTO)을 확인한다.",
          "source": "HM-8.2 SOP-FAN-12 단계 1"
        },
        {
          "order": 2,
          "text": "구 벨트를 분리하고 풀리 정렬을 점검한다.",
          "source": "HM-8.2 SOP-FAN-12 단계 2"
        },
        {
          "order": 3,
          "text": "새 벨트를 걸고 처짐을 12 mm로 맞춘다.",
          "source": "HM-8.2 SOP-FAN-12 단계 3"
        },
        {
          "order": 4,
          "text": "30분 시운전 뒤 냉각 효율 CE가 80 % 이상인지 확인한다.",
          "source": "HM-8.2 SOP-FAN-12 단계 4"
        }
      ],
      "completion": [
        {
          "text": "30분 시운전 뒤 냉각 효율 CE가 80 % 이상이다.",
          "source": "HM-8.2 SOP-FAN-12 단계 4",
          "rules": []
        }
      ],
      "approval": {
        "role": "미확인 — HM-8.2 SOP-FAN-12 절에 승인 줄이 없음(설비보전팀장 승인 문장은 HM-8.7 근본 조치 절의 것)",
        "source": "HM-8.2"
      }
