    {
      "id": "SOP-COOL-11",
      "name": "팬 최대 운전",
      "kind": "control",
      "codes": [
        "FAN_SET"
      ],
      "source": "HM-8.5",
      "failure_mode": "fm:cooler-cooling-loss",
      "model_refs": {
        "assets": [
          "HYD-01",
          "HYD-02",
          "HYD-03"
        ],
        "components": [
          "HYD-01:cooler",
          "HYD-02:cooler",
          "HYD-03:cooler",
          "HYD-01:fan",
          "HYD-02:fan",
          "HYD-03:fan"
        ],
        "sensors": [
          "HYD-01:TS1",
          "HYD-02:TS1",
          "HYD-03:TS1",
          "HYD-01:CE",
          "HYD-02:CE",
          "HYD-03:CE",
          "HYD-01:FanSpeedSP",
          "HYD-02:FanSpeedSP",
          "HYD-03:FanSpeedSP"
        ],
        "not_linked": "HYD-04는 뺐음 — HPP-45A 후속형이지만 냉각 장치가 수냉식 열교환기이고 HM-8에 적용 범위 문장이 없음. HYD-05 · HYD-06(DPU-30, 다른 제조사 — 유온 태그 T_OIL · 한계 70 ℃, 냉각 효율 · 설정값 태그 없음)과 HYD-07(쿨러 · 통신 없음)은 모델에 이 조치를 판정 · 확인할 센서가 없어 걸지 않음"
      },
      "apply_conditions": [
        {
          "text": "PLC 운전 모드가 REMOTE_AUTO일 때만 원격 조치를 한다.",
          "source": "HM-8.5; HM-8.5 SOP-COOL-11 단계 1",
          "rules": [
            "R1"
          ]
        }
      ],
      "prohibitions": [
        {
          "type": "금지",
          "text": "원격 조치는 REMOTE_AUTO가 아닐 때 쓰지 않는다. 현장 수동 조작이 들어와 REMOTE_MANUAL이면 원격 조치를 내리지 않는다.",
          "source": "HM-8.5; HM-8.8",
          "rules": [
            "R1"
          ]
        },
        {
          "type": "제한",
          "text": "펌프 부하를 60 % 미만으로 설정하지 않는다(최소 부하 인터록).",
          "source": "HM-8.5; HM-8.8",
          "rules": []
        },
        {
          "type": "제한",
          "text": "팬 100 % 연속 운전은 24시간 이내로 한다.",
          "source": "HM-8.5 SOP-COOL-11 단계 2",
          "rules": []
        },
        {
          "type": "제한",
          "text": "팬 100 % 연속 운전이 이미 24시간을 넘었으면 팬 수명 손실로 20만 원을 감점해 비교한다.",
          "source": "HM-8.8",
          "rules": [
            "R2"
          ]
        },
        {
          "type": "금지",
          "text": "조치 후 예측 유온이 65 ℃ 이상이면 이 후보를 쓰지 않는다.",
          "source": "판단 시스템 결정표 rule:ts1-hard; 출처 ks:sr-04(설비안전규정 SR-04) 원문 미확인",
          "rules": [
            "R4"
          ]
        },
        {
          "type": "금지",
          "text": "PLC가 트립 상태이면 리셋 외 명령을 내리지 않는다.",
          "source": "판단 시스템 결정표 rule:trip-reset-only; 출처 HM-9.4 원문 미확인(1.0판 · 1.1판에 없음)",
          "rules": [
            "R5"
          ]
        }
      ],
      "steps": [
        {
          "order": 1,
          "text": "PLC 운전 모드가 REMOTE_AUTO인지 확인한다.",
          "source": "HM-8.5 SOP-COOL-11 단계 1"
        },
        {
          "order": 2,
          "text": "팬 속도를 100 %로 올린다. 100 % 연속 운전은 24시간 이내로 한다.",
          "source": "HM-8.5 SOP-COOL-11 단계 2"
        },
        {
          "order": 3,
          "text": "15분 재관측으로 HM-8.6 회복 판정을 한다.",
          "source": "HM-8.5 SOP-COOL-11 단계 3"
        }
      ],
      "completion": [
        {
          "text": "조치 뒤 15분 동안 TS1이 55 ℃ 미만이고 경보가 해제된 상태가 유지되면 완화 성공, 회복하지 않으면 결과 보고에 미달로 적는다. 조치 후 예측 유온이 55 ℃ 이상이면 경보 해제에 실패할 수 있으므로 다른 조치와 비교한다.",
          "source": "HM-8.6",
          "rules": [
            "R3"
          ]
        }
      ],
      "approval": {
        "role": "운전원",
        "source": "HM-8.5 SOP-COOL-11 승인"
      }
    },
