{
  "base": {
    "id": "anomaly_response",
    "version": "2.2",
    "name": "설비 이상 조치"
  },
  "parts": [
    {
      "key": "task:diagnose",
      "group": "scenario",
      "name": "원인 진단",
      "kind": "agent",
      "role": "AI 에이전트",
      "agent": "sys:agent",
      "tool": "formHandler:diagnose",
      "form_id": "diagnose",
      "form": {
        "fields_json": [
          {
            "key": "cause",
            "text": "판정한 원인 노드 id (예: cause:cooler-fin-fouling)",
            "type": "text"
          },
          {
            "key": "failure_mode",
            "text": "고장 유형 노드 id (예: fm:cooling-loss)",
            "type": "text"
          },
          {
            "key": "guide_card",
            "text": "hyd-dmn diagnose 도구가 돌려준 가이드 카드 객체 그대로 (alert · causes · recommended · skills · citations · summary)",
            "type": "object"
          }
        ]
      },
      "inputs": [
        "pattern",
        "asset",
        "alert"
      ],
      "outputs": [
        "cause",
        "failure_mode",
        "guide_card"
      ],
      "approval": false,
      "effect": null,
      "server_values": [],
      "default_timer": null,
      "contract": {
        "type": "userTask",
        "role": "AI 에이전트",
        "agent": "sys:agent",
        "agentMode": "COMPLETE",
        "orchestration": "cliagents",
        "decision": "dec:diagnose-cause",
        "tool": "formHandler:diagnose",
        "instruction": "경보 패턴에서 증상 → 고장 유형 → 원인 후보를 온톨로지(Neo4j MCP)로 찾고, 각 원인의 증거 규칙(Evidence.sql)을 시계열 DB 에서 평가해 원인 점수를 매긴다. 가장 유력한 원인과 고장 유형, 인용 노드 id 를 출력한다. 조치를 실행하지 않는다.",
        "inputData": [
          "pattern",
          "asset",
          "alert"
        ],
        "outputData": [
          "cause",
          "failure_mode",
          "guide_card"
        ],
        "checkpoints": [
          "모든 주장에 온톨로지 노드 id 인용",
          "데이터 신선도 60 s 이내가 아니면 보류 카드"
        ],
        "duration": 2,
        "description": "원인 진단"
      }
    },
    {
      "key": "task:candidates",
      "group": "scenario",
      "name": "조치 후보 조회",
      "kind": "agent",
      "role": "AI 에이전트",
      "agent": "sys:agent",
      "tool": "formHandler:candidates",
      "form_id": "candidates",
      "form": {
        "fields_json": [
          {
            "key": "candidates",
            "text": "후보 스킬 id 목록 (dec:action-candidates 결과)",
            "type": "array"
          }
        ]
      },
      "inputs": [
        "failure_mode",
        "cause",
        "asset"
      ],
      "outputs": [
        "candidates"
      ],
      "approval": false,
      "effect": null,
      "server_values": [],
      "default_timer": null,
      "contract": {
        "type": "userTask",
        "role": "AI 에이전트",
        "agent": "sys:agent",
        "agentMode": "COMPLETE",
        "orchestration": "cliagents",
        "decision": "dec:action-candidates",
        "tool": "formHandler:candidates",
        "instruction": "고장 유형 · PLC 상태를 dec:action-candidates 결정표(DMN)에 대어 후보 조치 방법(스킬 = SOP)을 고른다. 원인 한정 스킬(ADDRESSES)은 판정 원인일 때만 남긴다.",
        "inputData": [
          "failure_mode",
          "cause",
          "asset"
        ],
        "outputData": [
          "candidates"
        ],
        "duration": 1,
        "description": "조치 후보 조회"
      }
    },
    {
      "key": "task:compliance",
      "group": "scenario",
      "name": "규정 검토",
      "kind": "agent",
      "role": "AI 에이전트",
      "agent": "sys:agent",
      "tool": "formHandler:compliance",
      "form_id": "compliance",
      "form": {
        "fields_json": [
          {
            "key": "compliance",
            "text": "스킬 id → {feasible, excluded[], penalties[], warnings[]} (dec:compliance 결과)",
            "type": "object"
          }
        ]
      },
      "inputs": [
        "candidates",
        "asset"
      ],
      "outputs": [
        "compliance"
      ],
      "approval": false,
      "effect": null,
      "server_values": [],
      "default_timer": null,
      "contract": {
        "type": "userTask",
        "role": "AI 에이전트",
        "agent": "sys:agent",
        "agentMode": "COMPLETE",
        "orchestration": "cliagents",
        "decision": "dec:compliance",
        "tool": "formHandler:compliance",
        "instruction": "후보마다 예측 유온 · 압력, 스킬 종류, 명령 코드, 공급사 승인, PLC 모드를 dec:compliance 규칙에 대어 제외(EXCLUDE) · 감점(PENALTY) · 경고(WARN)를 정한다. 규칙 출처(KnowledgeSource · 매뉴얼 절)를 인용한다.",
        "inputData": [
          "candidates",
          "asset"
        ],
        "outputData": [
          "compliance"
        ],
        "duration": 1,
        "description": "규정 검토"
      }
    },
    {
      "key": "task:rank",
      "group": "scenario",
      "name": "우선순위 · 카드 작성",
      "kind": "agent",
      "role": "AI 에이전트",
      "agent": "sys:agent",
      "tool": "formHandler:rank",
      "form_id": "rank",
      "form": {
        "fields_json": [
          {
            "key": "decision",
            "text": "순위 결과 요약 {recommended, explanation, order[]} — hyd-dmn evaluate_cards · submit_decision 결과",
            "type": "object"
          },
          {
            "key": "decision_id",
            "text": "submit_decision 이 돌려준 조치 카드 묶음 id",
            "type": "text"
          }
        ]
      },
      "inputs": [
        "candidates",
        "compliance",
        "asset",
        "incident"
      ],
      "outputs": [
        "decision",
        "decision_id"
      ],
      "approval": false,
      "effect": null,
      "server_values": [],
      "default_timer": null,
      "contract": {
        "type": "userTask",
        "role": "AI 에이전트",
        "agent": "sys:agent",
        "agentMode": "COMPLETE",
        "orchestration": "cliagents",
        "decision": "dec:rank-actions",
        "tool": "formHandler:rank",
        "instruction": "BSC 득실(AFFECTS → INFLUENCES 경로) · 예측 · 경고 · 감점 · 선례로 후보 순위를 매기고, 업무 DB(Supabase MCP)에서 납기 · 계약 · 재고를 읽어 영향을 설명에 넣는다. 사람이 고를 카드 2~3장과 권고 1장을 process /api/decisions 에 제출한다. 승인 역할은 온톨로지 Skill -APPROVED_BY-> Role 을 따른다.",
        "inputData": [
          "candidates",
          "compliance",
          "asset",
          "incident"
        ],
        "outputData": [
          "decision",
          "decision_id"
        ],
        "duration": 2,
        "description": "우선순위 · 카드 작성"
      }
    },
    {
      "key": "task:select",
      "group": "scenario",
      "name": "조치 카드 선택 (HITL)",
      "kind": "human",
      "role": "운전원",
      "agent": null,
      "tool": "formHandler:select_card",
      "form_id": "select_card",
      "form": {
        "fields_json": [
          {
            "key": "chosen_skill",
            "text": "고른 스킬(SOP) id",
            "type": "text"
          },
          {
            "key": "chosen_skill_kind",
            "text": "스킬 종류",
            "type": "select",
            "items": [
              {
                "control": "즉시 제어"
              },
              {
                "work_order": "작업지시만"
              }
            ]
          }
        ]
      },
      "inputs": [
        "decision"
      ],
      "outputs": [
        "chosen_skill",
        "chosen_skill_kind"
      ],
      "approval": true,
      "effect": null,
      "server_values": [
        "approved_amount",
        "approved_by",
        "approved_by_name",
        "approved_part_no",
        "approved_qty",
        "approved_role",
        "approved_supplier",
        "approved_unit_price",
        "chosen_option",
        "commands"
      ],
      "default_timer": "PT10M",
      "contract": {
        "type": "userTask",
        "role": "운전원",
        "tool": "formHandler:select_card",
        "agent": null,
        "instruction": "에이전트가 올린 카드 중 하나를 고르거나 거부한다. 고른 카드의 승인 역할보다 낮은 역할이면 process 가 거절한다(403).",
        "inputData": [
          "decision"
        ],
        "outputData": [
          "chosen_skill",
          "chosen_skill_kind"
        ],
        "checkpoints": [
          "규정상 제외된 카드는 고를 수 없음",
          "승인 역할 ≥ 카드의 APPROVED_BY"
        ],
        "duration": 1,
        "description": "조치 카드 선택 (HITL)"
      }
    },
    {
      "key": "task:escalate",
      "group": "scenario",
      "name": "상급자 호출",
      "kind": "human",
      "role": "생산관리자",
      "agent": null,
      "tool": "formHandler:escalate",
      "form_id": "escalate",
      "form": {
        "fields_json": [
          {
            "key": "note",
            "text": "생산관리자 확인 메모",
            "type": "textarea"
          }
        ]
      },
      "inputs": [
        "decision",
        "incident",
        "recovered"
      ],
      "outputs": [
        "note"
      ],
      "approval": false,
      "effect": null,
      "server_values": [],
      "default_timer": null,
      "contract": {
        "type": "userTask",
        "role": "생산관리자",
        "tool": "formHandler:escalate",
        "agent": null,
        "instruction": "선택 시간 초과 또는 미회복. 생산관리자가 상황을 확인하고 후속 조치를 결정한다.",
        "inputData": [
          "decision",
          "incident",
          "recovered"
        ],
        "outputData": [
          "note"
        ],
        "duration": 1,
        "description": "상급자 호출"
      }
    },
    {
      "key": "task:command",
      "group": "scenario",
      "name": "PLC 명령 발행",
      "kind": "service",
      "role": "SCADA",
      "agent": null,
      "tool": "incident:command",
      "form_id": null,
      "form": null,
      "inputs": [
        "chosen_skill",
        "incident"
      ],
      "outputs": [],
      "approval": false,
      "effect": "설비 명령",
      "server_values": [],
      "default_timer": null,
      "contract": {
        "type": "serviceTask",
        "role": "SCADA",
        "agent": null,
        "orchestration": "hyd-process",
        "tool": "incident:command",
        "instruction": "고른 스킬의 원자 조치(Action.code · value)를 action.cmd 로 발행한다 (만료 +120 s). cmd-gateway 검증 5종 → PLC → ACK 30 s. 이 작업은 process 서비스의 Incident 상태기계가 수행한다.",
        "inputData": [
          "chosen_skill",
          "incident"
        ],
        "outputData": [],
        "duration": 1,
        "description": "PLC 명령 발행"
      }
    },
    {
      "key": "task:reobserve",
      "group": "scenario",
      "name": "재관측 (15분)",
      "kind": "service",
      "role": "프로세스",
      "agent": null,
      "tool": "incident:reobserve",
      "form_id": null,
      "form": null,
      "inputs": [
        "incident"
      ],
      "outputs": [
        "recovered"
      ],
      "approval": false,
      "effect": null,
      "server_values": [],
      "default_timer": null,
      "contract": {
        "type": "serviceTask",
        "role": "프로세스",
        "agent": null,
        "orchestration": "hyd-process",
        "tool": "incident:reobserve",
        "instruction": "ACK 뒤 15분(시간 배율 적용) 재관측한다. 경보 CLEAR와 사건에 고정된 정의의 패턴별 회복 기준을 함께 확인한다. 기준이 없으면 회복으로 판정하지 않는다.",
        "inputData": [
          "incident"
        ],
        "outputData": [
          "recovered"
        ],
        "duration": 1,
        "description": "재관측 (15분)"
      }
    },
    {
      "key": "task:work-order",
      "group": "scenario",
      "name": "정비 작업지시",
      "kind": "service",
      "role": "CMMS",
      "agent": null,
      "tool": "enterprise:WO_CREATE",
      "form_id": null,
      "form": null,
      "inputs": [
        "chosen_skill",
        "asset"
      ],
      "outputs": [
        "work_order"
      ],
      "approval": false,
      "effect": "작업지시",
      "server_values": [],
      "default_timer": null,
      "contract": {
        "type": "serviceTask",
        "role": "CMMS",
        "agent": null,
        "orchestration": "hyd-process",
        "tool": "enterprise:WO_CREATE",
        "instruction": "고른 스킬의 WO_CREATE 트랜잭션을 CMMS 에 발행한다 (업무 DB work_orders 행). 발행은 정비 완료가 아니다.",
        "inputData": [
          "chosen_skill",
          "asset"
        ],
        "outputData": [
          "work_order"
        ],
        "duration": 1,
        "description": "정비 작업지시"
      },
      "config": {
        "window_var": "정비 예정 시간이 담긴 값",
        "mail": "정비 요청 뒤 공지 메일"
      }
    },
    {
      "key": "task:select-or-reject",
      "group": "general",
      "name": "조치 카드 승인 · 거절",
      "kind": "human",
      "role": "운전원",
      "agent": null,
      "tool": "formHandler:select_card",
      "form_id": "select_card",
      "form": {
        "fields_json": [
          {
            "key": "chosen_skill",
            "text": "고른 스킬(SOP) id",
            "type": "text",
            "required": false
          },
          {
            "key": "chosen_skill_kind",
            "text": "스킬 종류",
            "type": "select",
            "items": [
              {
                "control": "즉시 제어"
              },
              {
                "work_order": "작업지시만"
              }
            ],
            "required": false
          },
          {
            "key": "approval",
            "text": "승인 / 반려",
            "type": "select",
            "items": [
              "승인",
              "반려"
            ]
          },
          {
            "key": "approval_reason",
            "text": "사유",
            "type": "textarea",
            "required": false
          }
        ]
      },
      "inputs": [
        "decision"
      ],
      "outputs": [
        "chosen_skill",
        "chosen_skill_kind",
        "approval",
        "approval_reason"
      ],
      "approval": true,
      "effect": null,
      "server_values": [
        "approved_amount",
        "approved_by",
        "approved_by_name",
        "approved_part_no",
        "approved_qty",
        "approved_role",
        "approved_supplier",
        "approved_unit_price",
        "chosen_option",
        "commands"
      ],
      "default_timer": "PT10M",
      "contract": {
        "type": "userTask",
        "role": "운전원",
        "tool": "formHandler:select_card",
        "agent": null,
        "instruction": "에이전트가 올린 카드 중 하나를 고르거나 거부한다. 고른 카드의 승인 역할보다 낮은 역할이면 process 가 거절한다(403).",
        "inputData": [
          "decision"
        ],
        "outputData": [
          "chosen_skill",
          "chosen_skill_kind",
          "approval",
          "approval_reason"
        ],
        "checkpoints": [
          "규정상 제외된 카드는 고를 수 없음",
          "승인 역할 ≥ 카드의 APPROVED_BY"
        ],
        "duration": 1,
        "description": "조치 카드 승인 · 거절",
        "name": "조치 카드 승인 · 거절"
      },
      "help": "담당자가 조치 카드 하나를 승인하거나 거절합니다. 승인하면 approval 값이 '승인', 거절하면 '반려'(사유는 approval_reason)가 되고 거절에는 고른 조치가 없습니다. 효과 부품(설비 명령 · 작업지시 · 발주 …)으로 가는 분기 선에 approval == '승인' 조건을 두고, 그 밖의 선은 결과 보고(결과: 반려)로 보내세요."
    },
    {
      "key": "task:decide",
      "group": "general",
      "name": "판단 · 제안 (에이전트 한 번)",
      "kind": "agent",
      "role": "AI 에이전트",
      "agent": "sys:agent",
      "tool": "formHandler:decide",
      "form_id": "decide",
      "form": {
        "fields_json": [
          {
            "key": "cause",
            "text": "판정한 원인 노드 id (예: cause:cooler-fin-fouling)",
            "type": "text",
            "required": false
          },
          {
            "key": "failure_mode",
            "text": "고장 유형 노드 id (예: fm:cooling-loss)",
            "type": "text",
            "required": false
          },
          {
            "key": "guide_card",
            "text": "hyd-dmn diagnose 도구가 돌려준 가이드 카드 객체 그대로 (alert · causes · recommended · skills · citations · summary)",
            "type": "object",
            "required": false
          },
          {
            "key": "decision",
            "text": "순위 결과 요약 {recommended, explanation, order[]} — hyd-dmn evaluate_cards · submit_decision 결과",
            "type": "object"
          },
          {
            "key": "decision_id",
            "text": "submit_decision 이 돌려준 조치 카드 묶음 id",
            "type": "text"
          }
        ]
      },
      "inputs": [
        "asset",
        "alert",
        "pattern",
        "alert_id",
        "incident"
      ],
      "outputs": [
        "cause",
        "failure_mode",
        "guide_card",
        "decision",
        "decision_id"
      ],
      "approval": false,
      "effect": null,
      "server_values": [],
      "default_timer": null,
      "contract": {
        "type": "userTask",
        "role": "AI 에이전트",
        "agent": "sys:agent",
        "agentMode": "COMPLETE",
        "orchestration": "cliagents",
        "decision": "dec:rank-actions",
        "tool": "formHandler:decide",
        "instruction": "이 처리 건의 근거를 모두 조회해 원인 · 상황을 진단하고(diagnose), 후보 조치를 규정 · 회사 목표(BSC) · 성과 지표로 비교해 순위를 매긴 뒤(evaluate_cards) 추천 1장과 지는 대안을 카드로 제출한다(submit_decision). 승인 전에는 조회 · 계산만 한다.",
        "inputData": [
          "asset",
          "alert",
          "pattern",
          "alert_id",
          "incident"
        ],
        "outputData": [
          "cause",
          "failure_mode",
          "guide_card",
          "decision",
          "decision_id"
        ],
        "duration": 2,
        "description": "판단 · 제안",
        "name": "판단 · 제안"
      },
      "help": "경보 하나에 에이전트 task 하나: 진단 · 후보 · 규정 · 순위를 한 번에 하고 카드(추천 1장 + 지는 대안)를 냅니다. 결과는 담당자 승인 task 가 받습니다. 지시문을 시나리오에 맞게 바꿀 수 있습니다."
