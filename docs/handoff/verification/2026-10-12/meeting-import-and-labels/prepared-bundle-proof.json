                "text": "접근 확인한 실제 Google 문서 [{title,file_url}]",
                "required": true
              }
            ]
          },
          "lanes": {
            "Lane_organizer": "회의 주관자"
          },
          "tasks": {
            "Activity_propose": {
              "part": "agent",
              "agent": "agent:u-24c67f1e",
              "inputs": [
                "request_id",
                "meeting_calendar_id",
                "meeting_title",
                "meeting_duration_min",
                "meeting_time_zone",
                "meeting_attendees",
                "meeting_required_emails",
                "meeting_room_resources",
                "meeting_attachments"
              ],
              "instruction": "회의 요청 request_id 한 건에 대해 qbr-prep 요령대로 자료를 찾아 요약하고, 운영 규칙(D1)을 지키는 시간 후보를 순위와 함께 proposal 로 낸다. 뺀 안은 losers 에 규칙 번호와 수치로 이유를 쓴다. 승인 전에는 조회 · 계산 · 요약만 한다. 실제 읽기 도구는 google-meeting-drive.search_files/read_file와 google-meeting-calendar.free_busy/get_event이다. 등록 agent에 해당 읽기 도구가 필요하다. 추가 시작값은 같은 request_id의 검증된 업무 원천이다. 실제 room_id는 meeting_room_resources에 등록된 주소만 쓰고 후보에 room/room_email을 함께 보존한다. 각 후보의 slot은 오프셋 있는 RFC3339이며 end는 실제 meeting_duration_min 뒤 시각이다. slot/reason/score와 기존 승인 카드 필드를 보존한다. proposal.docs는 실제 meeting_attachments의 title/file_url을 title/link로 표시하며 첨부와 다른 문서를 승인 카드에 표시하지 않는다. 읽지 못한 자료·빈 시간은 추정하지 말고 보류한다. 참석자와 문서 접근은 실제 조회로 확인한다. 일정 생성은 하지 않는다.",
              "outputs": [
                {
                  "key": "proposal",
                  "text": "제안(추천 1 + 지는 안 · 자료 · 안건)",
                  "type": "object"
                }
              ]
            },
            "Activity_approve": {
              "part": "human:approve",
              "inputs": [
                "proposal",
                "meeting_calendar_id",
                "meeting_title",
                "meeting_duration_min",
                "meeting_time_zone",
                "meeting_attendees",
                "meeting_required_emails",
                "meeting_room_resources",
                "meeting_attachments"
              ],
              "config": {
                "options": "proposal.options",
                "recommended": "proposal.recommended",
                "losers": "proposal.losers",
                "docs": "proposal.docs"
              }
            },
            "Activity_invite": {
              "part": "svc:mcp-call",
              "inputs": [
                "approved_option",
                "proposal",
                "meeting_calendar_id",
                "meeting_title",
                "meeting_duration_min",
                "meeting_time_zone",
                "meeting_attendees",
                "meeting_required_emails",
                "meeting_room_resources",
                "meeting_attachments"
              ],
              "config": {
                "server": "google-meeting-calendar",
                "tool": "create_event",
                "arguments": {
                  "calendar_id": "{meeting_calendar_id}",
                  "summary": "{meeting_title}",
                  "start": "{approved_option.slot}",
                  "end": "{approved_option.end}",
                  "time_zone": "{meeting_time_zone}",
                  "room_email": "{approved_option.room_email}",
                  "attendees": "{meeting_attendees}",
                  "attachments": "{meeting_attachments}"
                },
                "output": "calendar_event",
                "extract": {
                  "event_id": {
                    "path": "document.event_id",
                    "type": "Text"
                  }
                }
              }
            },
            "Activity_wait": {
              "part": "svc:wait",
              "config": {
                "duration": "P1D",
                "label": "응답 마감까지 대기"
              }
            },
            "Activity_check": {
              "part": "svc:mcp-call",
              "inputs": [
                "event_id",
                "meeting_calendar_id",
                "meeting_title",
                "meeting_duration_min",
                "meeting_time_zone",
                "meeting_attendees",
                "meeting_required_emails",
                "meeting_room_resources",
                "meeting_attachments"
              ],
              "config": {
                "server": "google-meeting-calendar",
                "tool": "get_event",
                "arguments": {
                  "calendar_id": "{meeting_calendar_id}",
                  "event_id": "{event_id}",
                  "required_emails": "{meeting_required_emails}"
                },
                "output": "attendance",
                "extract": {
                  "all_required_accepted": {
                    "path": "document.all_required_accepted",
                    "type": "Boolean"
                  }
                },
                "effect": false
              }
            },
            "Activity_report_ok": {
              "part": "svc:report",
              "inputs": [
                "request_id"
              ],
              "config": {
                "outcome": "정상",
                "title": "{request_id} 회의 확정",
                "summary": "필수 참석자 전원 수락 — 일정 {event_id}"
              }
            },
            "Activity_report_ng": {
              "part": "svc:report",
              "inputs": [
                "request_id"
              ],
              "config": {
                "outcome": "미달",
                "title": "{request_id} 회의 미확정",
                "summary": "필수 참석자 거절 또는 무응답 — 다시 조율 필요"
              }
            },
            "Activity_report_reject": {
              "part": "svc:report",
              "inputs": [
                "request_id"
              ],
              "config": {
                "outcome": "반려",
                "title": "{request_id} 회의 반려",
                "summary": "주관자가 제안을 반려했습니다 — 사유: {approval_reason}. 일정은 만들지 않았습니다"
              }
            },
            "Activity_report_delay": {
              "part": "svc:report",
              "inputs": [
                "request_id"
              ],
              "config": {
                "outcome": "승인 지연",
                "title": "{request_id} 승인 지연",
                "summary": "주관자 승인이 4시간 넘게 없습니다 — 일정은 아직 만들지 않았습니다"
              }
            }
          },
          "timers": {
            "Event_approve_delay": "PT4H"
          },
          "flows": {
            "Flow_approve_yes": {
              "var": "approval",
              "op": "==",
              "value": "승인"
            },
            "Flow_approve_no": {
              "default": true
            },
            "Flow_yes": {
              "var": "all_required_accepted",
              "op": "==",
              "value": true
            },
            "Flow_no": {
              "default": true
            }
          }
        }
      }
    }
  },
