{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "action.cmd (Kafka, process -> cmd-gateway) — v3 7.3",
  "type": "object",
  "required": ["cmdId", "asset", "incident", "source", "actions", "approvedBy", "expiresAt"],
  "properties": {
    "cmdId": {"type": "string", "examples": ["CMD-0923-0042"]},
    "asset": {"type": "string", "examples": ["HYD-01"]},
    "incident": {"type": "string", "examples": ["INC-0923-01"]},
    "source": {"const": "HITL"},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code"],
      "properties": {"code": {"enum": ["FAN_BOOST", "REDUCE_LOAD", "RESET"]}, "fan_pct": {"type": "number", "minimum": 0, "maximum": 100},
                     "load_pct": {"type": "number", "minimum": 60, "maximum": 100}}}},
    "approvedBy": {"type": "string"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time", "description": "approval time + 120 s"}
  }
}
