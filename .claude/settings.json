{
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv314/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guide_gate.py\" compact",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv314/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guide_gate.py\" read",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv314/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guide_gate.py\" gate",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
