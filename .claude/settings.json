{
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud-bootstrap.sh\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/.venv314/Scripts/python.exe\"; [ -x \"$PY\" ] || PY=python3; \"$PY\" \"$CLAUDE_PROJECT_DIR/workspace/동기화.py\" 세션",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/.venv314/Scripts/python.exe\"; [ -x \"$PY\" ] || PY=python3; \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guide_gate.py\" compact",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/.venv314/Scripts/python.exe\"; [ -x \"$PY\" ] || PY=python3; \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guide_gate.py\" read",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/.venv314/Scripts/python.exe\"; [ -x \"$PY\" ] || PY=python3; \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guide_gate.py\" gate",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
